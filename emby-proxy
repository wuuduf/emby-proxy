controller_cert_menu() {
  local state domain answer provider record_type
  state="$(controller_require_state)" || return 1
  provider="$(jq -r '.dns.provider // empty' "$state")"
  record_type="$(jq -r 'if (.address_family // "ipv4") == "ipv6" then "AAAA" else "A" end' "$state")"
  domain="$(jq -r '.certificates.control_domain // .control_domain // ("control." + .domain)' "$state")"
  ui_read_field domain "独立主控域名（${record_type} 记录需提前指向主控 VPS）" "$domain" ui_valid_domain || return 0
  if [[ "$provider" == cloudflare ]]; then
    ui_section "自动证书 · Cloudflare DNS-01"
    warn "将安装 Certbot/Cloudflare 插件、申请证书，并让主控直接监听 HTTPS 19090。"
    info "不改业务 ${record_type} 记录、不接管已有 80/443 服务。请放行 TCP 19090；已有 HTTP 节点需重新接入 HTTPS。"
    info "证书私钥在同一入口节点间共享。续期每 12 小时检查，边缘每小时同步。"
  else
    ui_section "自动 HTTPS · Caddy HTTP-01"
    warn "Caddy 将在 443 终止 HTTPS，并反代到本机 127.0.0.1:19090；不会把主控端口暴露公网。"
    info "适用于 DNSPod 或其他 DNS：只需让主控域名 ${record_type} 记录指向本机，并放行 TCP 80/443。Caddy 自动申请和续期证书。"
  fi
  info "不会覆盖非脚本托管的 Caddy 站点；修改前会自动备份配置，校验失败会恢复。"
  ui_read_field answer "确认配置并启动主控？y/n" n ui_valid_yes_no || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || return 0
  if [[ "$provider" == cloudflare ]]; then
    controller_cli cert-setup --state "$state" --control-domain "$domain" --install-deps || return 1
    ok "主控 HTTPS 已启动：https://${domain}:19090；选 3 为边缘生成新安装命令。"
  else
    controller_cli https-proxy-setup --state "$state" --control-domain "$domain" || return 1
    ok "主控 HTTPS 已启动：https://${domain}；选 3 为边缘生成新安装命令。"
  fi
}

