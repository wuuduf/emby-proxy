@contextmanager
def telegram_poll_lock(path):
    """Serialize polling processes and always release the fd on failure."""
    if fcntl is None:
        yield
        return
    lock_path=Path(str(path)+'.telegram.poll.lock'); lock_path.parent.mkdir(parents=True,exist_ok=True)
    fd=open_private_lock(lock_path)
    try:
        try: fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except OSError: raise RuntimeError('Telegram 轮询服务已在运行，拒绝启动第二个实例。')
        yield
    finally:
        try: fcntl.flock(fd,fcntl.LOCK_UN)
        finally: os.close(fd)

def telegram_serve(a):
    path=Path(a.state)
    with telegram_poll_lock(path):
        return telegram_serve_loop(a,path)

def telegram_serve_loop(a,path):
    def runtime():
        config=(telegram_read_state(path).get('telegram') or {})
        if config.get('enabled') is not True: return None
        token=telegram_token(config); allowed={str(item) for item in config.get('chat_ids') or []}
        if not allowed: raise RuntimeError('Telegram 未配置允许的 Chat ID。')
        return token,allowed,Path(config.get('offset_file') or path.with_name('telegram.offset'))
    def activate(current):
        """Bind a poll cycle to one token and refresh Bot identity/webhook."""
        token,allowed,offset_file=current
        offset_file.parent.mkdir(parents=True,exist_ok=True)
        # Long polling and a webhook are mutually exclusive. Do not silently
        # delete a webhook that another operator or deployment may own.
        me=telegram_api(token,'getMe',{},timeout=15) or {}
        bot_username=str(me.get('username') or '').lower() if isinstance(me,dict) else ''
        webhook=telegram_api(token,'getWebhookInfo',{},timeout=15) or {}
        if isinstance(webhook,dict) and str(webhook.get('url') or ''):
            raise RuntimeError('Telegram Bot 已配置 webhook；请先在 Telegram 侧删除 webhook，再启动轮询。')
        return token,allowed,offset_file,bot_username

    current=runtime()
    if not current: raise RuntimeError('Telegram Bot 尚未启用。')
    token,allowed,offset_file,bot_username=activate(current)
    offset=telegram_read_offset(offset_file,token)

    def authorized(send_token, chat_id):
        # Check both identity and ACL from disk immediately before each API
        # call. The callback is intentionally fail-closed on malformed state.
        try: fresh=runtime()
        except Exception: return False
        return bool(fresh and fresh[0] == send_token and str(chat_id) in fresh[1])

    print('[telegram] bot polling started',flush=True)
    while True:
        current=runtime()
        if not current:
            print('[telegram] disabled; stopping',flush=True); return
        # A token rotation must start a new Bot session, including getMe and
        # webhook checks. Never send a request from an old session with the
        # new token or carry the old cursor to the new Bot.
        if current[0] != token or current[2] != offset_file:
            token,allowed,offset_file,bot_username=activate(current)
            offset=telegram_read_offset(offset_file,token)
        else:
            allowed=current[1]
            offset=telegram_read_offset(offset_file,token)
        try:
            updates=telegram_api(token,'getUpdates',{'offset':offset,'timeout':20,'allowed_updates':['message']},timeout=30) or []
        except TelegramAPIError as error:
            print('[telegram] polling failed: '+str(error),file=sys.stderr,flush=True)
            updates=[]; time.sleep(max(1,min(error.retry_after or 10,3600)))
        except RuntimeError as error:
            print('[telegram] polling failed: '+str(error),file=sys.stderr,flush=True)
            updates=[]; time.sleep(10)
        # Telegram normally returns a list.  A malformed API mock/proxy must
        # not make the daemon iterate a string/dict or acknowledge data.
        if not isinstance(updates,list):
            time.sleep(1)
            continue
        # If config changed while getUpdates was blocked, discard the entire
        # old-Bot batch. Processing it with the replacement token could leak
        # replies and would write the old cursor into the new offset file.
        after_poll=runtime()
        if not after_poll:
            print('[telegram] disabled; stopping',flush=True); return
        if after_poll[0] != token or after_poll[2] != offset_file:
            continue
        allowed=after_poll[1]
        for update in updates:
            if not isinstance(update,dict): continue
            value=update.get('update_id')
            if isinstance(value,bool) or not isinstance(value,int) or not 0 <= value <= TELEGRAM_CURSOR_MAX:
                continue
            update_id=value
            # Authorization is reloaded for every update. A disable or Chat
            # ID rotation during a long poll must take effect before any
            # reply, rather than waiting for the next 20-second poll.
            fresh=runtime()
            if not fresh:
                print('[telegram] disabled; stopping',flush=True); return
            fresh_token,fresh_allowed,fresh_offset_file=fresh
            if fresh_token != token or fresh_offset_file != offset_file:
                # Do not process a batch after rotation. The next iteration
                # activates the replacement Bot and fetches its own queue.
                continue
            allowed=fresh_allowed
            message=update.get('message') if isinstance(update,dict) else None
            if not isinstance(message,dict):
                offset=max(offset,update_id+1); telegram_write_offset(offset_file,token,offset); continue
            chat=message.get('chat') if isinstance(message.get('chat'),dict) else {}; chat_id=str(chat.get('id',''))
            if chat_id in allowed:
                text=str(message.get('text') or '').strip()
                # Ignore ordinary chat text; the bot is a read-only command
                # endpoint, not a chat echo service.
                if text.startswith('/'):
                    command=text.split()[0]
                    command_match=re.fullmatch(r'(/[A-Za-z0-9_]+)(?:@([^\s]+))?',command)
                    if command_match and (not command_match.group(2) or command_match.group(2).lower() == bot_username):
                        try:
                            current_state=Controller(str(path)).private_status()
                            telegram_send(token,chat_id,telegram_render(current_state,command,str(path)),authorize=authorized)
                        except Exception as error:
                            try: telegram_send(token,chat_id,'查询失败，请稍后重试。',authorize=authorized)
                            except Exception as send_error: print('[telegram] reply failed: '+str(send_error),file=sys.stderr,flush=True)
            # A malformed/unauthorized update is acknowledged as well, so it
            # cannot block the queue forever. A failed reply is best-effort.
            offset=max(offset,update_id+1)
            telegram_write_offset(offset_file,token,offset)
        try:
            telegram_alerts(path); telegram_deliver_alerts(path,token,allowed)
        except Exception as error:
            print('[telegram] alert processing failed: '+str(error),file=sys.stderr,flush=True)

class Handler(BaseHTTPRequestHandler):
    def handle(self):
        try: super().handle()
        except (ssl.SSLError,TimeoutError,ConnectionError): self.close_connection=True
    def log_message(self, fmt, *args): print('[controller] '+(fmt % args), flush=True)
    def reply(self, code, body):
        raw=json.dumps(body,separators=(',',':')).encode(); self.send_response(code); self.send_header('Cache-Control','no-store'); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(raw))); self.end_headers(); self.wfile.write(raw)
    def body(self):
        length=int(self.headers.get('Content-Length','0'))
        if not 0 <= length <= 65536: raise ValueError('request_too_large')
        self.connection.settimeout(15)
        result=json.loads(self.rfile.read(length) or b'{}')
        if not isinstance(result,dict): raise ValueError('expected_object')
        return result
    def do_GET(self):
        if urlparse(self.path).path == '/status': self.reply(200, self.server.controller.public_status())
        else: self.reply(404, {'error':'not_found'})
    def do_POST(self):
        try:
            path=urlparse(self.path).path; b=self.body()
            secure=isinstance(getattr(self,'connection',None),ssl.SSLSocket)
            # In Caddy/Nginx HTTPS-proxy mode the controller receives plain
            # HTTP from the local reverse proxy. Trust its X-Forwarded-Proto
            # only when the peer is loopback; a public client cannot forge it.
            if not secure and str(self.headers.get('X-Forwarded-Proto','')).lower() == 'https':
                try: secure=ipaddress.ip_address(self.client_address[0]).is_loopback
                except (ValueError,TypeError): secure=False
            if path == '/certificate':
                code,result=self.server.controller.certificate(b,self.headers.get('Authorization','').removeprefix('Bearer ').strip(),secure=secure)
            elif path == '/enroll':
                if self.server.controller.state.get('certificates') and not secure:
                    code,result=403,{'error':'managed_certificates_require_https_registration'}
                else: code,result=self.server.controller.enroll(b,secure=secure)
            elif path == '/heartbeat': code,result=self.server.controller.heartbeat(b,self.headers.get('Authorization','').removeprefix('Bearer ').strip())
            elif path == '/revoke': code,result=self.server.controller.revoke(b,self.headers.get('Authorization','').removeprefix('Bearer ').strip())
            else: code,result=404,{'error':'not_found'}
        except (ValueError, KeyError, json.JSONDecodeError) as e: code,result=400,{'error':'bad_request:'+str(e)}
        self.reply(code,result)

class Server(ThreadingHTTPServer):
    def __init__(self, address, controller): super().__init__(address, Handler); self.controller=controller
    def get_request(self):
        sock,address=super().get_request(); sock.settimeout(15)
        context=getattr(self,'tls_context',None)
        if context: sock=context.wrap_socket(sock,server_side=True,do_handshake_on_connect=False)
        return sock,address

class IPv6Server(Server):
    address_family=socket.AF_INET6

def init_state(a):
    domain=a.domain.strip().lower().rstrip('.')
    entry_id=(a.entry_id.strip() if a.entry_id else '') or ('domain-'+domain)
    source=validate_endpoint(a.source, allow_http=True, label='源站 URL')
    if a.engine not in ('caddy','nginx'): raise RuntimeError('引擎只能是 caddy 或 nginx。')
    control_domain=str(getattr(a,'control_domain','') or '').strip().lower().rstrip('.')
    if control_domain:
        if not re.fullmatch(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]*',control_domain):
            raise RuntimeError('主控域名格式无效；请填写不带协议、端口或路径的完整域名。')
        if control_domain == domain:
            raise RuntimeError('主控域名不能与业务入口域名相同。')
    address_family=normalize_address_family(getattr(a,'address_family','ipv4'))
    path=Path(a.state)
    if path.exists():
        if not getattr(a, 'force', False):
            raise RuntimeError('主控状态已存在；为避免清空节点和注册码，请使用 --force 并先确认备份。')
        backup=path.with_name(path.name + '.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        suffix=1
        while backup.exists():
            backup=path.with_name(path.name + '.bak-' + time.strftime('%Y%m%d-%H%M%S') + '-%s' % suffix)
            suffix += 1
        backup.write_bytes(path.read_bytes())
        os.chmod(backup, 0o600)
    state={'schema_version':1,'entry_id':entry_id,'domain':domain,'source':source,'engine':a.engine,'address_family':address_family,'active_node':None,'active_nodes':[],'enroll_tokens':{},'nodes':{}}
    if control_domain: state['control_domain']=control_domain
    record_ids=[]
    raw_record_ids=str(getattr(a,'record_ids','') or '').strip()
    if raw_record_ids:
        record_ids=[item for item in raw_record_ids.split(',') if item]
    elif a.record_id:
        record_ids=[str(a.record_id)]
    if len(set(record_ids)) != len(record_ids) or any(not re.fullmatch(r'[0-9a-fA-F-]{4,128}', item) for item in record_ids):
        raise RuntimeError('Cloudflare record_ids 必须是去重后的记录 ID。')
    if a.zone_id and record_ids and a.token_file:
        state['dns']={'provider':'cloudflare','zone_id':a.zone_id,'record_id':record_ids[0],
                      'record_ids':record_ids,'record_type':address_record_type(address_family),
                      'token_file':a.token_file,'ttl':60}
    with state_lock(a.state): atomic_write(a.state,state)
    print('已创建多线路入口：'+a.state)
def set_dns_routes(a):
    path=Path(a.state)
    with state_lock(path):
        state=json.loads(path.read_text()); dns=state.get('dns') or {}
        if dns.get('provider') != 'dnspod': raise RuntimeError('当前入口未配置 DNSPod。')
        routes={}
        for raw in a.route or []:
            if '=' not in raw: raise RuntimeError('线路格式必须是 线路=节点 ID。')
            line,node=(part.strip() for part in raw.split('=',1))
            if line not in DNSPOD_LINES: raise RuntimeError('仅支持：%s。' % '、'.join(DNSPOD_LINES))
            if node and node not in state.get('nodes',{}): raise RuntimeError('节点不存在：%s' % node)
            if node: routes[line]=node
        if routes != (dns.get('routes') or {}):
            # Explicit operator policy changes may override preemption cooldown.
            for previous in (state.get('line_states') or {}).values(): previous['last_switch_at']=0
        dns['routes']=routes; state['dns']=dns; backup_file(path); atomic_write(path,state)
    print('DNSPod 线路路由已保存：'+json.dumps(routes,ensure_ascii=False,sort_keys=True))

def set_dnspod_line_pool(a):
    path=Path(a.state); weights={}
    if a.line not in DNSPOD_LINES: raise RuntimeError('仅支持：%s。' % '、'.join(DNSPOD_LINES))
    for raw in a.weight or []:
        if '=' not in raw: raise RuntimeError('权重格式必须是节点 ID=数字。')
        node,value=(part.strip() for part in raw.split('=',1))
        if node in weights or not re.fullmatch(r'[1-9][0-9]{0,5}',value): raise RuntimeError('权重必须是正整数且节点不能重复。')
        weights[node]=int(value)
    with state_lock(path):
        state=json.loads(path.read_text()); dns=state.get('dns') or {}
        if dns.get('provider') != 'dnspod': raise RuntimeError('当前入口未配置 DNSPod。')
        records=dns.get('line_records',{}).get(a.line)
        records=records if isinstance(records,list) else ([records] if records else [])
        if len(records)<2: raise RuntimeError('该运营商线路至少需要两条 DNSPod %s 记录。' % address_record_type(state.get('address_family','ipv4')))
        unknown=sorted(set(weights)-set(state.get('nodes',{})))
        if unknown: raise RuntimeError('权重包含未注册节点：'+','.join(unknown))
        if not weights: raise RuntimeError('至少配置一个节点权重。')
        backup_file(path); dns.setdefault('line_weights',{})[a.line]=weights; state['dns']=dns
        state['dns_needs_confirmation']=True; atomic_write(path,state)
    print('%s 线路权重已保存：%s' % (a.line,json.dumps(weights,ensure_ascii=False,sort_keys=True)))

def set_cloudflare_records(a):
    path=Path(a.state); raw=str(a.record_ids or '')
    record_ids=[item.strip() for item in raw.split(',') if item.strip()]
