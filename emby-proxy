#!/usr/bin/env bash
# Emby 反向代理管理命令：交互菜单、状态索引和安全配置变更。

set -Eeuo pipefail
IFS=$'\n\t'

readonly VERSION="3.3.0-menu"
readonly STATE_HOME="${EMBY_PROXY_STATE_HOME:-/etc/emby-proxy}"
readonly SITES_DIR="$STATE_HOME/sites.d"
readonly BACKUPS_DIR="$STATE_HOME/backups"
readonly CADDYFILE="${EMBY_PROXY_CADDYFILE:-/etc/caddy/Caddyfile}"
readonly NGINX_CONF_DIR="${EMBY_PROXY_NGINX_CONF_DIR:-/etc/nginx/conf.d}"
readonly NGINX_LEGACY_CONFIG="${EMBY_PROXY_NGINX_LEGACY_CONFIG:-/etc/nginx/conf.d/emby-proxy-managed.conf}"
readonly NGINX_HASH_CONFIG="${EMBY_PROXY_NGINX_HASH_CONFIG:-/etc/nginx/conf.d/00-emby-proxy-hash.conf}"
readonly NGINX_ACME_ROOT="${EMBY_PROXY_NGINX_ACME_ROOT:-/var/www/emby-proxy-acme}"
readonly CADDY_LOG_DIR="${EMBY_PROXY_CADDY_LOG_DIR:-/var/log/caddy}"
readonly NGINX_LOG_DIR="${EMBY_PROXY_NGINX_LOG_DIR:-/var/log/nginx}"
readonly OS_RELEASE_FILE="${EMBY_PROXY_OS_RELEASE_FILE:-/etc/os-release}"
readonly HEALTH_PATH="/_emby_proxy_health"
readonly INSTALLED_BACKEND="${EMBY_PROXY_INSTALLED_BACKEND:-/usr/local/lib/emby-proxy/setup-emby-proxy.sh}"
readonly MANAGER_LIBEXEC="${EMBY_PROXY_LIBEXEC:-/usr/local/lib/emby-proxy}"
readonly MANAGER_BIN="${EMBY_PROXY_MANAGER_BIN:-/usr/local/sbin/emby-proxy}"
readonly SHORT_BIN="${EMBY_PROXY_SHORT_BIN:-/usr/local/bin/ep}"
readonly UPDATE_BASE_URL="${EMBY_PROXY_UPDATE_BASE_URL:-https://raw.githubusercontent.com/wuuduf/emby-proxy/codex/multiline-lab}"
LOCK_FD=""
DOCTOR_OK=0
DOCTOR_WARN=0
DOCTOR_ERROR=0
MENU_ACTION_STATUS=0
UNINSTALL_COMPLETED=0

if [[ -t 1 ]]; then
  RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BLUE=$'\033[34m'; CYAN=$'\033[36m'; MAGENTA=$'\033[35m'
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else
  RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; MAGENTA=""; BOLD=""; DIM=""; RESET=""
fi

info()  { printf '%s[信息]%s %s\n' "$BLUE" "$RESET" "$*"; }
ok()    { printf '%s[正常]%s %s\n' "$GREEN" "$RESET" "$*"; }
warn()  { printf '%s[提醒]%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
error() { printf '%s[错误]%s %s\n' "$RED" "$RESET" "$*" >&2; }
die()   { error "$*"; exit 1; }

ui_clear() {
  [[ "${EMBY_PROXY_NO_CLEAR:-0}" == "1" || ! -t 1 ]] || printf '\033[H\033[2J'
}

ui_rule() {
  printf '%s%s%s\n' "$DIM" '────────────────────────────────────────────────────────────' "$RESET"
}

ui_header() {
  local title="$1" subtitle="${2:-}"
  ui_clear
  printf '%s%s╭──────────────────────────────────────────────────────────%s\n' "$BOLD" "$CYAN" "$RESET"
  printf '%s%s│%s  %s%s%s\n' "$BOLD" "$CYAN" "$RESET" "$BOLD" "$title" "$RESET"
  printf '%s%s│%s  %s%s · v%s%s\n' "$CYAN" "$DIM" "$RESET" "$DIM" "${subtitle:-Emby Reverse Proxy Manager}" "$VERSION" "$RESET"
  printf '%s%s╰──────────────────────────────────────────────────────────%s\n' "$BOLD" "$CYAN" "$RESET"
}

ui_section() { printf '\n%s%s%s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"; }
ui_item() {
  local key="$1" label="$2" hint="${3:-}"
  printf '  %s%2s%s  %-24s %s%s%s\n' "$CYAN" "$key" "$RESET" "$label" "$DIM" "$hint" "$RESET"
}

ui_prompt() {
  local prompt="${1:-请输入你的选择}"
  printf '\n%s%s：%s ' "$BOLD" "$prompt" "$RESET"
}

ui_pause() {
  [[ "${EMBY_PROXY_NO_PAUSE:-0}" == "1" || ! -t 0 ]] && return 0
  printf '\n%s按任意键返回菜单…%s' "$DIM" "$RESET"
  IFS= read -r -n 1 _ || true
  printf '\n'
}

menu_run() {
  MENU_ACTION_STATUS=0
  if ( "$@" ); then
    MENU_ACTION_STATUS=0
  else
    MENU_ACTION_STATUS=$?
    warn "操作未完成，已返回当前菜单。"
  fi
  ui_pause
  return 0
}

usage() {
  cat <<EOF
Emby Reverse Proxy Manager $VERSION

用法：
  ep                                      快速打开交互式管理菜单
  sudo emby-proxy                         打开交互式管理菜单
  sudo emby-proxy status                  查看运行概况
  sudo emby-proxy list                    列出所有托管入口
  sudo emby-proxy show <入口ID>           查看入口详情
  sudo emby-proxy add [安装参数]           新增入口
  sudo emby-proxy route add <入口ID>       新增路径
  sudo emby-proxy route set <入口ID>       修改路径源站
  sudo emby-proxy route delete <入口ID>    删除路径
  sudo emby-proxy delete <入口ID>          删除整个托管入口
  sudo emby-proxy import                  导入旧版脚本配置
  sudo emby-proxy config test             验证完整 Caddy/Nginx 配置
  sudo emby-proxy doctor [入口ID]         运行环境与端到端诊断
  sudo emby-proxy logs <入口ID> [模式]    查看/跟踪/过滤访问日志
  sudo emby-proxy stats <入口ID>          统计请求、流量、错误和慢请求
  sudo emby-proxy backup list             查看管理器备份
  sudo emby-proxy backup restore <备份ID> 安全恢复备份
  sudo emby-proxy service status          查看或管理 Web 服务
  sudo emby-proxy update [--check]        检查或安装管理器更新
  sudo emby-proxy uninstall [--yes]       干净卸载脚本（保留 Caddy/Nginx 和证书）
  sudo emby-proxy controller ...         多线路控制器（实验版）
  emby-proxy version

日志模式：
  --follow                 实时跟踪
  --media                  最近 200 条中的媒体请求
  --errors                 最近 200 条中的 4xx/5xx
  --slow [秒]              最近 200 条中超过阈值的请求（默认 2 秒）

其他常用参数：
  stats <入口ID> --since 24h
  backup show <备份ID>
  backup clean [保留数量] [--yes]
  service reload|restart|logs caddy|nginx
  update --force           强制重新安装当前版本
EOF
}

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] && return 0
  command -v sudo >/dev/null 2>&1 || die "请切换到 root 后运行。"
  exec sudo -- "$0" "$@"
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "缺少 jq。请先运行安装脚本，或执行：apt-get install -y jq"
}

install_managed_dir() {
  local mode="$1"; shift
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    install -d -o root -g root -m "$mode" "$@"
  else
    install -d -m "$mode" "$@"
  fi
}

install_managed_file() {
  local mode="$1" source="$2" target="$3"
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    install -o root -g root -m "$mode" "$source" "$target"
  else
    install -m "$mode" "$source" "$target"
  fi
}

ensure_state_dirs() {
  install_managed_dir 0750 "$SITES_DIR" "$BACKUPS_DIR"
}

normalize_state_registry() {
  local file temp
  while IFS= read -r file; do
    jq -e 'type=="object" and (.routes|type=="array")' "$file" >/dev/null 2>&1 || continue
    temp="$(mktemp /tmp/emby-proxy-state-normalize.XXXXXX)"
    jq '{
      schema_version:2,
      id,engine,domain,listen_port,entry_type,public_url,managed_kind,config_file,
      created_at,updated_at,routes
    }' "$file" >"$temp"
    if cmp -s "$file" "$temp"; then
      rm -f "$temp"
    else
      install_managed_file 0640 "$temp" "$file"
      rm -f "$temp"
    fi
  done < <(find "$SITES_DIR" -maxdepth 1 -type f -name 'domain-*.json' -print 2>/dev/null | sort)
}

acquire_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  mkdir -p /run/lock
  exec {LOCK_FD}>/run/lock/emby-proxy.lock
  flock -n "$LOCK_FD" || die "另一个 emby-proxy 配置任务正在运行，请稍后重试。"
}

release_lock() {
  [[ -n "$LOCK_FD" ]] || return 0
  flock -u "$LOCK_FD" 2>/dev/null || true
  eval "exec ${LOCK_FD}>&-"
  LOCK_FD=""
}

backend_path() {
  local sibling
  [[ -n "${EMBY_PROXY_BACKEND:-}" ]] && { printf '%s' "$EMBY_PROXY_BACKEND"; return; }
  [[ -x "$INSTALLED_BACKEND" ]] && { printf '%s' "$INSTALLED_BACKEND"; return; }
  sibling="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/setup-emby-proxy.sh"
  [[ -x "$sibling" ]] && { printf '%s' "$sibling"; return; }
  die "找不到配置后端 setup-emby-proxy.sh，请重新运行一键安装命令。"
}

state_file() {
  local id="$1"
  [[ "$id" =~ ^domain-[A-Za-z0-9.-]+(-https-[0-9]+)?$ ]] || die "入口 ID 格式无效：$id"
  printf '%s/%s.json' "$SITES_DIR" "$id"
}

require_site() {
  local file
  file="$(state_file "$1")"
  [[ -f "$file" ]] || die "找不到入口：$1。运行 emby-proxy list 查看可用 ID。"
  printf '%s' "$file"
}

site_count() {
  find "$SITES_DIR" -maxdepth 1 -type f -name 'domain-*.json' 2>/dev/null | wc -l | tr -d ' '
}

service_line() {
  local service="$1" binary="$2" version="未安装" state="未安装"
  if command -v "$binary" >/dev/null 2>&1; then
    version="$($binary version 2>/dev/null || $binary -v 2>&1 || printf '版本未知')"
    state="未运行"
    systemctl is-active --quiet "$service" 2>/dev/null && state="运行中"
  fi
  printf '%-8s %-8s %s' "$service" "$state" "$version"
}

print_status() {
  local view="${1:-full}" count caddy_count nginx_count
  ensure_state_dirs
  count="$(site_count)"
  caddy_count="$(find "$SITES_DIR" -type f -name 'domain-*.json' -exec jq -r 'select(.engine=="caddy") | 1' {} \; 2>/dev/null | wc -l | tr -d ' ')"
  nginx_count="$(find "$SITES_DIR" -type f -name 'domain-*.json' -exec jq -r 'select(.engine=="nginx") | 1' {} \; 2>/dev/null | wc -l | tr -d ' ')"
  [[ "$view" == "compact" ]] || printf '%sEmby Reverse Proxy Manager%s  %s\n\n' "$BOLD" "$RESET" "$VERSION"
  printf '  %s\n' "$(service_line caddy caddy)"
  printf '  %s\n' "$(service_line nginx nginx)"
  printf '\n  托管入口：%s（域名 HTTPS）\n' "$count"
  printf '  引擎分布：Caddy %s，Nginx %s\n' "$caddy_count" "$nginx_count"
  if command -v ss >/dev/null 2>&1; then
    printf '  监听端口：\n'
    ss -H -lntp 2>/dev/null | awk '$0 ~ /users:\(\("(caddy|nginx)"/ {printf "    %s %s\n",$4,$NF}' || true
  fi
}

health_url_for_file() {
  local file="$1" url kind prefix
  url="$(jq -r '.public_url' "$file")"
  kind="$(jq -r '.managed_kind' "$file")"
  if [[ "$kind" == "caddy_attached" ]]; then
    prefix="$(jq -r '.routes[0].path // empty' "$file")"
    printf '%s%s%s' "$url" "$prefix" "$HEALTH_PATH"
  else
    printf '%s%s' "$url" "$HEALTH_PATH"
  fi
}

site_listen_port() {
  local file="$1" port
  port="$(jq -r '.listen_port // empty' "$file")"
  if [[ -z "$port" || "$port" == "null" ]]; then
    printf '443'
  else
    printf '%s' "$port"
  fi
}

site_proxy_key() {
  local file="$1" domain port
  domain="$(jq -r '.domain' "$file")"; port="$(site_listen_port "$file")"
  if [[ "$port" == "443" ]]; then printf '%s' "$domain"; else printf '%s-https-%s' "$domain" "$port"; fi
}

local_health_code() {
  local file="$1" health_url domain port request_path public_url
  health_url="$(health_url_for_file "$file")"
  public_url="$(jq -r '.public_url' "$file")"
  request_path="${health_url#"$public_url"}"
  domain="$(jq -r '.domain' "$file")"; port="$(site_listen_port "$file")"
  curl --noproxy '*' -sS -o /dev/null -w '%{http_code}' --resolve "$domain:$port:127.0.0.1" \
    --connect-timeout 3 --max-time 8 "${public_url}${request_path}" 2>/dev/null || true
}

list_sites() {
  local file id url engine routes kind index=0
  ensure_state_dirs
  printf '%-4s %-38s %-7s %-7s %s\n' "序号" "访问地址" "引擎" "路径" "入口ID"
  printf '%-4s %-38s %-7s %-7s %s\n' "----" "--------------------------------------" "-------" "-------" "----------------"
  while IFS= read -r file; do
    ((index+=1))
    id="$(jq -r '.id' "$file")"
    url="$(jq -r '.public_url' "$file")"
    engine="$(jq -r '.engine' "$file")"
    routes="$(jq -r '.routes|length' "$file")"
    kind="$(jq -r '.managed_kind' "$file")"
    [[ "$kind" != "caddy_attached" ]] || url+="$(jq -r '.routes[0].path // ""' "$file")"
    printf '%-4s %-38s %-7s %-7s %s\n' "$index" "$url" "$engine" "$routes" "$id"
  done < <(find "$SITES_DIR" -maxdepth 1 -type f -name 'domain-*.json' -print 2>/dev/null | sort)
  (( index > 0 )) || warn "还没有管理索引。若已有旧配置，请运行：sudo emby-proxy import"
}

show_site() {
  local file id="$1" health_url code path upstream
  file="$(require_site "$id")"
  printf '%s入口详情%s\n\n' "$BOLD" "$RESET"
  jq -r '
    "入口 ID：\(.id)",
    "访问模式：域名 HTTPS",
    "访问地址：\(.public_url)",
    "反代程序：\(.engine)",
    "管理方式：\(.managed_kind)",
    "配置文件：\(.config_file)",
    "更新时间：\(.updated_at)"
  ' "$file"
  printf '\n路径映射：\n'
  while IFS=$'\t' read -r path upstream; do
    printf '  %-16s -> %s\n' "$path" "$upstream"
  done < <(jq -r '.routes[] | [.path,.upstream] | @tsv' "$file")
  health_url="$(health_url_for_file "$file")"
  code="$(local_health_code "$file")"
  printf '\n健康地址：%s\n' "$health_url"
  if [[ "$code" == "200" ]]; then
    ok "入口健康检查 HTTP 200"
  else
    [[ "$code" == "000" ]] && code="无响应"
    warn "入口健康检查 HTTP ${code:-无响应}"
  fi
}

doctor_ok()    { ((DOCTOR_OK+=1)); printf '%s[正常]%s %s\n' "$GREEN" "$RESET" "$*"; }
doctor_warn()  { ((DOCTOR_WARN+=1)); printf '%s[提醒]%s %s\n' "$YELLOW" "$RESET" "$*"; }
doctor_error() { ((DOCTOR_ERROR+=1)); printf '%s[错误]%s %s\n' "$RED" "$RESET" "$*"; }

doctor_config_quiet() {
  local engine="$1"
  if [[ "$engine" == "caddy" ]]; then
    command -v caddy >/dev/null 2>&1 && [[ -f "$CADDYFILE" ]] && \
      caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1
  else
    command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1
  fi
}

doctor_certificate() {
  local domain="$1" port="${2:-443}" pem enddate
  command -v openssl >/dev/null 2>&1 || { doctor_warn "${domain}：缺少 openssl，未检查证书。"; return; }
  pem="$(timeout 8 openssl s_client -connect "127.0.0.1:$port" -servername "$domain" -showcerts </dev/null 2>/dev/null || true)"
  enddate="$(openssl x509 -noout -enddate 2>/dev/null <<<"$pem" | sed 's/^notAfter=//' || true)"
  if [[ -n "$enddate" ]] && openssl x509 -noout -checkend 604800 >/dev/null 2>&1 <<<"$pem"; then
    doctor_ok "${domain}：证书有效且至少还有 7 天（到期 ${enddate}）。"
  elif [[ -n "$enddate" ]]; then
    doctor_warn "${domain}：证书可读取，但将在 7 天内到期（${enddate}）。"
  else
    doctor_error "${domain}：无法从本机 TCP ${port} 获取有效证书。"
  fi
}

doctor_dns() {
  local domain="$1" public_ipv4="$2" records
  if command -v dig >/dev/null 2>&1; then
    records="$(dig +time=3 +tries=1 +short A "$domain" 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | sort -u | paste -sd, - || true)"
  else
    records="$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd, - || true)"
  fi
  if [[ -z "$records" ]]; then
    doctor_error "${domain}：未解析到 IPv4 A 记录。"
  elif [[ -n "$public_ipv4" && ",$records," != *",$public_ipv4,"* ]]; then
    doctor_warn "${domain}：A 记录为 ${records}，与检测到的本机公网 IPv4 $public_ipv4 不同（如使用 CDN 可忽略）。"
  else
    doctor_ok "${domain}：DNS A 记录 ${records}。"
  fi
}

doctor_firewall() {
  local port="$1"
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    if ufw status 2>/dev/null | grep -Eq "(^|[[:space:]])${port}/tcp([[:space:]]|$)|(^|[[:space:]])${port}([[:space:]]|$)"; then
      doctor_ok "UFW 已显示放行 TCP ${port}。"
    else
      doctor_warn "UFW 已启用，但未明确看到 TCP $port 放行规则。"
    fi
  elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    firewall-cmd --query-port="${port}/tcp" >/dev/null 2>&1 && \
      doctor_ok "firewalld 已放行 TCP ${port}。" || doctor_warn "firewalld 未显示 TCP $port 放行规则。"
  else
    doctor_warn "未检测到启用中的 UFW/firewalld；云安全组仍需在厂商控制台确认 TCP ${port}。"
  fi
}

doctor_site() {
  local file="$1" id engine config port code path upstream upstream_code domain public_ipv4="$2"
  id="$(jq -r '.id' "$file")"; engine="$(jq -r '.engine' "$file")"
  config="$(jq -r '.config_file' "$file")"
  printf '\n%s入口：%s%s\n' "$BOLD" "$id" "$RESET"
  jq -e '.schema_version==2 and (.routes|type=="array") and (.routes|length>0)' "$file" >/dev/null 2>&1 && \
    doctor_ok "管理索引结构有效。" || doctor_error "管理索引损坏或没有路径：$file"
  [[ -f "$config" ]] && doctor_ok "配置文件存在：$config" || doctor_error "配置文件不存在：$config"
  if systemctl is-active --quiet "$engine" 2>/dev/null; then doctor_ok "$engine 服务运行中。"; else doctor_error "$engine 服务未运行。"; fi
  doctor_config_quiet "$engine" && doctor_ok "$engine 完整配置验证通过。" || doctor_error "$engine 完整配置验证失败。"
  domain="$(jq -r '.domain' "$file")"; port="$(site_listen_port "$file")"
  doctor_dns "$domain" "$public_ipv4"
  doctor_certificate "$domain" "$port"
  if ss -H -lnt 2>/dev/null | awk -v port=":$port" '$4 ~ (port "$") {found=1} END{exit !found}'; then
    doctor_ok "TCP $port 正在监听。"
  else
    doctor_error "TCP $port 没有监听。"
  fi
  doctor_firewall "$port"
  if [[ "$port" != "80" ]]; then
    doctor_firewall 80
    doctor_warn "域名证书申请/续期依赖 TCP 80；云安全组也必须放行 TCP 80。"
  fi
  code="$(local_health_code "$file")"
  [[ "$code" == "200" ]] && doctor_ok "本机入口健康检查 HTTP 200。" || doctor_error "本机入口健康检查 HTTP ${code:-无响应}。"
  while IFS=$'\t' read -r path upstream; do
    upstream_code="$(curl --noproxy '*' -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 "${upstream%/}/" 2>/dev/null || true)"
    if [[ "$upstream_code" =~ ^[1-5][0-9][0-9]$ && "$upstream_code" != "000" ]]; then
      doctor_ok "路径 $path 源站可访问：${upstream}（HTTP ${upstream_code}）。"
    else
      doctor_error "路径 $path 无法连接源站：$upstream"
    fi
  done < <(jq -r '.routes[] | [.path,.upstream] | @tsv' "$file")
}

run_doctor() {
  local id="${1:-}" file public_ipv4="" os_name
  DOCTOR_OK=0; DOCTOR_WARN=0; DOCTOR_ERROR=0
  printf '%sEmby Proxy 运行诊断%s\n' "$BOLD" "$RESET"
  if [[ -r "$OS_RELEASE_FILE" ]]; then
    os_name="$(sed -n 's/^PRETTY_NAME=//p' "$OS_RELEASE_FILE" | head -n1)"
    os_name="${os_name#\"}"; os_name="${os_name%\"}"
    [[ -n "$os_name" ]] || os_name="unknown"
    doctor_ok "系统：$os_name / $(uname -m)"
  else
    doctor_error "缺少 $OS_RELEASE_FILE。"
  fi
  public_ipv4="$(curl -4 --noproxy '*' -fsS --connect-timeout 3 --max-time 6 https://api.ipify.org 2>/dev/null || true)"
  [[ -n "$public_ipv4" ]] && doctor_ok "本机公网 IPv4：$public_ipv4" || doctor_warn "无法自动检测本机公网 IPv4。"
  if [[ -n "$id" ]]; then
    file="$(require_site "$id")"; doctor_site "$file" "$public_ipv4"
  else
    while IFS= read -r file; do doctor_site "$file" "$public_ipv4"; done < <(find "$SITES_DIR" -type f -name 'domain-*.json' -print | sort)
    (( $(site_count) > 0 )) || doctor_warn "没有管理索引；可运行 emby-proxy import。"
  fi
  printf '\n诊断汇总：正常 %s，提醒 %s，错误 %s\n' "$DOCTOR_OK" "$DOCTOR_WARN" "$DOCTOR_ERROR"
  (( DOCTOR_ERROR == 0 ))
}

access_log_for_file() {
  local file="$1" engine key kind
  engine="$(jq -r '.engine' "$file")"; kind="$(jq -r '.managed_kind' "$file")"
  [[ "$kind" != "caddy_attached" ]] || return 1
  key="$(site_proxy_key "$file")"
  if [[ "$engine" == "caddy" ]]; then
    printf '%s/emby-proxy-%s-access.log' "$CADDY_LOG_DIR" "$key"
  else
    printf '%s/emby-proxy-%s-access.log' "$NGINX_LOG_DIR" "$key"
  fi
}

normalized_log_jq() {
  cat <<'JQ'
def norm:
  {
    time:(.time // (if .ts? != null then (.ts|floor|todateiso8601) else "-" end)),
    client:(.client // .request.remote_ip // .request.client_ip // "-"),
    method:(.method // .request.method // "-"),
    path:(.path // .request.uri // "-"),
    status:((.status // 0)|tonumber),
    bytes:((.bytes_sent // .size // 0)|tonumber),
    duration:((.request_time // .duration // 0)|tonumber),
    upstream:(.upstream // "-")
  };
norm
JQ
}

view_logs() {
  local id="$1" mode="${2:---recent}" file log engine threshold="${3:-2}" jq_filter base_filter
  file="$(require_site "$id")"; engine="$(jq -r '.engine' "$file")"
  if ! log="$(access_log_for_file "$file")"; then
    warn "该入口附加在手工 Caddy 站点中，日志位置由原站点决定；改为显示 Caddy 服务日志。"
    journalctl -u caddy -n 100 --no-pager
    return
  fi
  [[ -r "$log" ]] || die "访问日志不存在或不可读：$log"
  base_filter="$(normalized_log_jq)"
  case "$mode" in
    --follow|-f) jq_filter="$base_filter | [.time,.client,.method,.path,(.status|tostring),(.bytes|tostring),(.duration|tostring)]|@tsv" ;;
    --media) jq_filter="$base_filter | select(.path|test(\"/Videos/|/Audio/|/stream|\\\\.m3u8\";\"i\")) | [.time,.client,.path,(.status|tostring),(.bytes|tostring),(.duration|tostring)]|@tsv" ;;
    --errors) jq_filter="$base_filter | select(.status>=400) | [.time,.client,.method,.path,(.status|tostring),(.upstream)]|@tsv" ;;
    --slow) [[ "$threshold" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "慢请求阈值必须是秒数。"
      jq_filter="$base_filter | select(.duration>=$threshold) | [.time,.client,.path,(.status|tostring),(.duration|tostring)]|@tsv" ;;
    --recent|"") jq_filter="$base_filter | [.time,.client,.method,.path,(.status|tostring),(.bytes|tostring),(.duration|tostring)]|@tsv" ;;
    *) die "日志模式支持：--follow、--media、--errors、--slow [秒]。" ;;
  esac
  info "日志文件：$log"
  if [[ "$mode" == "--follow" || "$mode" == "-f" ]]; then
    tail -n 20 -F "$log" | jq --unbuffered -Rr "fromjson? | $jq_filter"
  else
    tail -n 1000 "$log" | jq -Rr "fromjson? | $jq_filter" | tail -n 100
  fi
}

duration_to_seconds() {
  local value="$1" number unit
  [[ "$value" =~ ^([0-9]+)([smhd])$ ]] || die "时间范围格式无效：${value}（示例：30m、24h、7d）"
  number="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
  case "$unit" in s) printf '%s' "$number";; m) printf '%s' "$((number*60))";; h) printf '%s' "$((number*3600))";; d) printf '%s' "$((number*86400))";; esac
}

human_bytes() {
  local bytes="$1"
  if command -v numfmt >/dev/null 2>&1; then numfmt --to=iec-i --suffix=B "$bytes"; else printf '%s B' "$bytes"; fi
}

show_stats() {
  local id="$1" since="${2:-24h}" file log seconds cutoff result requests bytes errors slow avg top
  file="$(require_site "$id")"
  log="$(access_log_for_file "$file")" || die "附加在手工 Caddy 站点中的入口没有独立日志，无法自动统计。"
  [[ -r "$log" ]] || die "访问日志不存在或不可读：$log"
  seconds="$(duration_to_seconds "$since")"; cutoff="$(($(date +%s)-seconds))"
  result="$(jq -Rn --argjson cutoff "$cutoff" '
    def epoch:
      if .ts? != null then (.ts|tonumber)
      elif .time? != null then try (
        (.time|capture("^(?<base>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<sign>[+-])(?<hh>[0-9]{2}):(?<mm>[0-9]{2})$")) as $t |
        (($t.base+"Z"|fromdateiso8601) - (((($t.hh|tonumber)*3600)+(($t.mm|tonumber)*60)) * (if $t.sign=="+" then 1 else -1 end)))) catch 0
      else 0 end;
    def norm:
      {client:(.client // .request.remote_ip // .request.client_ip // "unknown"),
       path:(.path // .request.uri // "unknown"),status:((.status // 0)|tonumber),
       bytes:((.bytes_sent // .size // 0)|tonumber),duration:((.request_time // .duration // 0)|tonumber)};
    reduce (inputs|fromjson?) as $r
      ({requests:0,bytes:0,errors:0,slow:0,duration:0,clients:{},paths:{}};
       ($r|epoch) as $epoch | if $epoch >= $cutoff then ($r|norm) as $n |
         .requests += 1 | .bytes += $n.bytes | .duration += $n.duration |
         .errors += (if $n.status>=400 then 1 else 0 end) |
         .slow += (if $n.duration>=2 then 1 else 0 end) |
         .clients[$n.client] = ((.clients[$n.client] // 0)+$n.bytes) |
         .paths[$n.path] = ((.paths[$n.path] // 0)+1)
       else . end) |
    . + {top_clients:(.clients|to_entries|sort_by(-.value)|.[0:5]),top_paths:(.paths|to_entries|sort_by(-.value)|.[0:5])}
  ' "$log")"
  requests="$(jq -r '.requests' <<<"$result")"; bytes="$(jq -r '.bytes' <<<"$result")"
  errors="$(jq -r '.errors' <<<"$result")"; slow="$(jq -r '.slow' <<<"$result")"
  avg="$(jq -r 'if .requests>0 then (.duration/.requests) else 0 end' <<<"$result")"
  printf '%s最近 %s 流量统计%s\n\n' "$BOLD" "$since" "$RESET"
  printf '  请求数：%s\n  输出流量：%s\n  4xx/5xx：%s\n  慢请求（>=2s）：%s\n  平均耗时：%.3f 秒\n' \
    "$requests" "$(human_bytes "$bytes")" "$errors" "$slow" "$avg"
  printf '\n  流量最高客户端：\n'
  while IFS=$'\t' read -r top bytes; do [[ -n "$top" ]] && printf '    %-30s %s\n' "$top" "$(human_bytes "$bytes")"; done \
    < <(jq -r '.top_clients[]|[.key,(.value|tostring)]|@tsv' <<<"$result")
  printf '\n  请求最多路径：\n'
  while IFS=$'\t' read -r top requests; do [[ -n "$top" ]] && printf '    %-50s %s\n' "$top" "$requests"; done \
    < <(jq -r '.top_paths[]|[.key,(.value|tostring)]|@tsv' <<<"$result")
}

write_state_json() {
  local id="$1" engine="$2" domain="$3" port="$4" url="$5" kind="$6" config="$7" routes="$8"
  local file temp now entry_type="port"
  file="$(state_file "$id")"
  [[ ! -e "$file" ]] || return 0
  temp="$(mktemp /tmp/emby-proxy-import.XXXXXX)"
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ -n "$port" && "$port" != "443" ]]; then entry_type="port"
  elif [[ "$(jq 'length' <<<"$routes")" -gt 1 || "$kind" == "caddy_attached" ]]; then entry_type="path"
  else entry_type="subdomain"; fi
  jq -n --argjson schema_version 2 --arg id "$id" --arg engine "$engine" \
    --arg domain "$domain" --arg port "$port" --arg public_url "$url" \
    --arg kind "$kind" --arg entry_type "$entry_type" --arg config "$config" --arg now "$now" --argjson routes "$routes" \
    '{schema_version:$schema_version,id:$id,engine:$engine,domain:$domain,
      listen_port:($port|if .=="" then null else tonumber end),entry_type:$entry_type,public_url:$public_url,
      managed_kind:$kind,config_file:$config,created_at:$now,updated_at:$now,routes:$routes}' >"$temp"
  install_managed_file 0640 "$temp" "$file"
  rm -f "$temp"
}

parse_caddy_routes() {
  awk '
    /^[[:space:]]*handle_path[[:space:]]+\/[^[:space:]]+\/\*[[:space:]]*\{/ {
      path=$2; sub(/\/\*$/, "", path); next
    }
    /^[[:space:]]*handle[[:space:]]*\{[[:space:]]*$/ { path="/"; next }
    /^[[:space:]]*reverse_proxy[[:space:]]+/ && path != "" {
      upstream=$2; print path "\t" upstream; path=""
    }
  ' "$1"
}

routes_tsv_to_json() {
  jq -Rn '[inputs | split("\t") | select(length==2) | {path:.[0],upstream:(.[1]|sub("/$";""))}] | unique_by(.path)'
}

import_caddy_standalone() {
  local source="$CADDYFILE" key block address domain port url id routes imported=0
  [[ -f "$source" ]] || return 0
  while IFS= read -r key; do
    domain="$key"; port="443"; id="domain-$domain"; url="https://$domain"
    if [[ "$key" =~ ^(.+)-https-([0-9]+)$ ]]; then
      domain="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"
      id="domain-${domain}-https-${port}"; url="https://${domain}:${port}"
    fi
    block="$(mktemp /tmp/emby-caddy-import.XXXXXX)"
    awk -v begin="# BEGIN MANAGED EMBY REVERSE PROXY: $key" -v end="# END MANAGED EMBY REVERSE PROXY: $key" '
      $0==begin {inside=1; next} $0==end {exit} inside {print}
    ' "$source" >"$block"
    address="$(awk '/^[^#[:space:]].*\{[[:space:]]*$/ {line=$0; sub(/[[:space:]]*\{[[:space:]]*$/, "", line); print line; exit}' "$block")"
    [[ -n "$address" && "$address" != http://* ]] || { rm -f "$block"; continue; }
    [[ "$domain" =~ ^[A-Za-z0-9.-]+$ && "$domain" == *.* && "$domain" =~ [A-Za-z] ]] || { rm -f "$block"; continue; }
    [[ ! -f "$(state_file "$id")" ]] || { rm -f "$block"; continue; }
    routes="$(parse_caddy_routes "$block" | routes_tsv_to_json)"
    [[ "$(jq 'length' <<<"$routes")" -gt 0 ]] || { rm -f "$block"; continue; }
    write_state_json "$id" caddy "$domain" "$port" "$url" standalone "$source" "$routes"
    rm -f "$block"
    ((imported+=1))
  done < <(sed -n 's/^# BEGIN MANAGED EMBY REVERSE PROXY: //p' "$source")
  printf '%s' "$imported"
}

import_caddy_attached() {
  local file marker domain path id state routes upstream imported=0 now temp
  [[ -d "$(dirname "$CADDYFILE")" ]] || { printf '0'; return; }
  while IFS=$'\t' read -r file marker; do
    domain="${marker#\# BEGIN MANAGED EMBY EXISTING ROUTE: }"
    path="${domain#* }"; domain="${domain%% *}"
    id="domain-$domain"
    upstream="$(awk -v begin="$marker" -v end="# END MANAGED EMBY EXISTING ROUTE: $domain $path" '
      $0==begin {inside=1; next} $0==end {exit} inside && $1=="reverse_proxy" {print $2; exit}
    ' "$file")"
    [[ -n "$upstream" ]] || continue
    state="$(state_file "$id")"
    if [[ -f "$state" ]]; then
      [[ "$(jq -r '.managed_kind' "$state")" == "caddy_attached" ]] || continue
      temp="$(mktemp /tmp/emby-attached-import.XXXXXX)"
      now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      jq --arg path "$path" --arg upstream "${upstream%/}" --arg now "$now" '
        .routes=((.routes | map(select(.path!=$path)))+[{path:$path,upstream:$upstream}]|sort_by(.path)) | .updated_at=$now
      ' "$state" >"$temp"
      install_managed_file 0640 "$temp" "$state"; rm -f "$temp"
    else
      routes="$(jq -n --arg path "$path" --arg upstream "${upstream%/}" '[{path:$path,upstream:$upstream}]')"
      write_state_json "$id" caddy "$domain" "443" "https://$domain" caddy_attached "$file" "$routes"
    fi
    ((imported+=1))
  done < <(grep -RHn '^# BEGIN MANAGED EMBY EXISTING ROUTE: ' "$(dirname "$CADDYFILE")" \
    --include='Caddyfile' --include='*.caddy' --include='*.conf' 2>/dev/null |
    sed -E 's/^([^:]+):[0-9]+:(.*)$/\1\t\2/')
  printf '%s' "$imported"
}

parse_nginx_routes() {
  awk '
    $1=="location" && $2=="=" {path=$3; next}
    $1=="location" && $2=="^~" {path=$3; sub(/\/$/,"",path); next}
    $1=="location" && $2=="/" {path="/"; next}
    $1=="proxy_pass" && path!="" {up=$2; sub(/;$/,"",up); sub(/\/$/,"",up); print path "\t" up; path=""}
  ' "$1"
}

import_nginx() {
  local file id domain port url routes imported=0
  [[ -d "$NGINX_CONF_DIR" ]] || { printf '0'; return; }
  for file in "$NGINX_CONF_DIR"/emby-proxy-*.conf; do
    [[ -f "$file" ]] || continue
    grep -qE '^[[:space:]]*proxy_pass[[:space:]]+' "$file" || continue
    domain="$(awk '$1=="server_name" {gsub(/;/,"",$2); print $2; exit}' "$file")"
    [[ "$domain" =~ ^[A-Za-z0-9.-]+$ && "$domain" == *.* && "$domain" =~ [A-Za-z] ]] || continue
    port="$(awk '$1=="listen" && $0~/ssl/ {value=$2; sub(/^.*:/,"",value); gsub(/[^0-9]/,"",value); print value; exit}' "$file")"
    [[ -n "$port" ]] || continue
    if [[ "$port" == "443" ]]; then id="domain-$domain"; url="https://$domain"
    else id="domain-${domain}-https-${port}"; url="https://${domain}:${port}"; fi
    [[ ! -f "$(state_file "$id")" ]] || continue
    routes="$(parse_nginx_routes "$file" | routes_tsv_to_json)"
    [[ "$(jq 'length' <<<"$routes")" -gt 0 ]] || continue
    write_state_json "$id" nginx "$domain" "$port" "$url" standalone "$file" "$routes"
    ((imported+=1))
  done
  printf '%s' "$imported"
}

import_existing() {
  local a b c
  require_jq; ensure_state_dirs; acquire_lock
  a="$(import_caddy_standalone)"; b="$(import_caddy_attached)"; c="$(import_nginx)"
  release_lock
  ok "导入完成：独立 Caddy ${a:-0}，附加路径 Caddy ${b:-0}，Nginx ${c:-0}。"
}

run_backend_for_state() {
  local file="$1" backend engine domain port kind path upstream i
  local -a args=()
  backend="$(backend_path)"
  engine="$(jq -r '.engine' "$file")"
  kind="$(jq -r '.managed_kind' "$file")"
  args+=(--engine "$engine")
  domain="$(jq -r '.domain' "$file")"; port="$(site_listen_port "$file")"
  args+=(--domain "$domain")
  if [[ "$port" != "443" ]]; then
    args+=(--domain-mode port --https-port "$port")
  elif [[ "$(jq -r '.entry_type // empty' "$file")" == "path" || "$(jq '.routes|length' "$file")" -gt 1 || "$kind" == "caddy_attached" ]]; then
    args+=(--domain-mode path)
  else
    args+=(--domain-mode subdomain)
  fi
  path="$(jq -r '.routes[0].path' "$file")"; upstream="$(jq -r '.routes[0].upstream' "$file")"
  [[ "$kind" != "caddy_attached" ]] || args+=(--path "$path")
  args+=(--upstream "$upstream")
  for ((i=1; i<$(jq '.routes|length' "$file"); i++)); do
    path="$(jq -r ".routes[$i].path" "$file")"; upstream="$(jq -r ".routes[$i].upstream" "$file")"
    args+=(--route "$path=$upstream")
  done
  "$backend" "${args[@]}"
}

run_add_wizard() {
  local backend
  backend="$(backend_path)"
  "$backend" --entry-wizard "$@"
}

validate_route_path() {
  local path="$1"
  [[ "$path" == /* ]] || path="/$path"
  while [[ "$path" != "/" && "$path" == */ ]]; do path="${path%/}"; done
  [[ "$path" == "/" || "$path" =~ ^/([A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$ ]] || die "路径格式无效：$path"
  printf '%s' "$path"
}

check_route_overlap() {
  local file="$1" wanted="$2" ignore="${3:-}" existing
  while IFS= read -r existing; do
    [[ "$existing" == "$ignore" || "$existing" == "/" ]] && continue
    if [[ "$wanted" == "$existing" || "$wanted" == "$existing"/* || "$existing" == "$wanted"/* ]]; then
      die "路径 $wanted 与现有路径 $existing 重叠。"
    fi
  done < <(jq -r '.routes[].path' "$file")
}

route_upsert() {
  local action="$1" id="$2" file path upstream temp exists
  file="$(require_site "$id")"
  if [[ "$action" == "add" && "$(site_listen_port "$file")" != "443" ]]; then
    die "独立 HTTPS 端口模式不再新增子路径；请为新的 Emby 新建另一个 HTTPS 端口入口。"
  fi
  printf '请输入访问路径（例如 /a）：'; read -r path; path="$(validate_route_path "$path")"
  exists="$(jq --arg path "$path" '[.routes[]|select(.path==$path)]|length' "$file")"
  if [[ "$action" == "add" && "$exists" -gt 0 ]]; then die "路径 $path 已存在，请使用 route set。"; fi
  if [[ "$action" == "set" && "$exists" -eq 0 ]]; then die "路径 $path 不存在，请使用 route add。"; fi
  [[ "$(jq -r '.managed_kind' "$file")" != "caddy_attached" || "$path" != "/" ]] || die "附加到手工 Caddy 站点时不能接管根路径。"
  check_route_overlap "$file" "$path" "$path"
  printf '请输入 Emby 源站域名或 URL：'; read -r upstream
  [[ -n "$upstream" ]] || die "源站不能为空。"
  temp="$(mktemp /tmp/emby-proxy-route.XXXXXX.json)"
  jq --arg path "$path" --arg upstream "$upstream" '
    .routes=((.routes | map(select(.path!=$path)))+[{path:$path,upstream:$upstream}] |
      sort_by([if .path=="/" then 0 else 1 end,.path]))
  ' "$file" >"$temp"
  run_backend_for_state "$temp"
  rm -f "$temp"
}

backup_target() {
  local id="$1" target="$2" reason="${3:-config-change}" timestamp dir suffix=0 state engine="unknown" filename hash now
  timestamp="$(date +%Y%m%d-%H%M%S)"; dir="$BACKUPS_DIR/${timestamp}-${id}"
  while [[ -e "$dir" ]]; do ((suffix+=1)); dir="$BACKUPS_DIR/${timestamp}-${id}-${suffix}"; done
  install_managed_dir 0750 "$dir"
  filename="$(basename "$target")"; cp -a "$target" "$dir/$filename"
  state="$(state_file "$id")"
  if [[ -f "$state" ]]; then
    engine="$(jq -r '.engine // "unknown"' "$state")"
    cp -a "$state" "$dir/site-state.json"
  fi
  if command -v sha256sum >/dev/null 2>&1; then hash="$(sha256sum "$dir/$filename" | awk '{print $1}')";
  else hash="$(shasum -a 256 "$dir/$filename" | awk '{print $1}')"; fi
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  jq -n --arg backup_id "$(basename "$dir")" --arg site_id "$id" --arg engine "$engine" \
    --arg target "$target" --arg filename "$filename" --arg sha256 "$hash" --arg reason "$reason" --arg created_at "$now" \
    '{schema_version:1,backup_id:$backup_id,site_id:$site_id,engine:$engine,target:$target,
      filename:$filename,sha256:$sha256,reason:$reason,created_at:$created_at}' >"$dir/metadata.json"
  chmod 0640 "$dir/metadata.json"
  printf '%s' "$dir"
}

backup_dir() {
  local backup_id="$1"
  [[ "$backup_id" =~ ^[0-9]{8}-[0-9]{6}-domain-[A-Za-z0-9.-]+(-https-[0-9]+)?(-[0-9]+)?$ ]] || die "备份 ID 格式无效：$backup_id"
  [[ -d "$BACKUPS_DIR/$backup_id" ]] || die "找不到备份：$backup_id"
  printf '%s/%s' "$BACKUPS_DIR" "$backup_id"
}

backup_list() {
  local dir meta id site reason created size count=0
  printf '%-48s %-28s %-14s %s\n' "备份ID" "入口" "原因" "大小"
  while IFS= read -r dir; do
    meta="$dir/metadata.json"; id="$(basename "$dir")"
    if [[ -f "$meta" ]]; then
      site="$(jq -r '.site_id // "unknown"' "$meta")"; reason="$(jq -r '.reason // "unknown"' "$meta")"
    else site="旧版备份"; reason="unknown"; fi
    size="$(du -sh "$dir" 2>/dev/null | awk '{print $1}')"
    printf '%-48s %-28s %-14s %s\n' "$id" "$site" "$reason" "${size:-0}"
    ((count+=1))
  done < <(find "$BACKUPS_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort -r)
  (( count > 0 )) || warn "还没有管理器备份。"
}

backup_show() {
  local dir meta target filename
  dir="$(backup_dir "$1")"; meta="$dir/metadata.json"
  [[ -f "$meta" ]] || die "这是没有 metadata.json 的旧版备份，只能人工检查：$dir"
  jq . "$meta"
  target="$(jq -r '.target' "$meta")"; filename="$(jq -r '.filename' "$meta")"
  if [[ -f "$target" && -f "$dir/$filename" ]]; then
    printf '\n%s与当前配置的差异：%s\n' "$BOLD" "$RESET"
    diff -u "$target" "$dir/$filename" || true
  fi
}

verify_backup_hash() {
  local file="$1" expected="$2" actual
  if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$file" | awk '{print $1}')";
  else actual="$(shasum -a 256 "$file" | awk '{print $1}')"; fi
  [[ "$actual" == "$expected" ]] || die "备份 SHA256 校验失败，文件可能已损坏：$file"
}

target_is_managed_config() {
  local target="$1" caddy_root nginx_root target_real
  target_real="$(readlink -f "$target" 2>/dev/null || printf '%s' "$target")"
  caddy_root="$(readlink -f "$(dirname "$CADDYFILE")")"; nginx_root="$(readlink -f "$NGINX_CONF_DIR")"
  [[ "$target_real" == "$caddy_root"/* || "$target_real" == "$nginx_root"/* ]]
}

restore_backup() {
  local backup_id="$1" dir meta target filename expected engine site answer current_backup="" staged backup_file target_existed=0
  dir="$(backup_dir "$backup_id")"; meta="$dir/metadata.json"
  [[ -f "$meta" ]] || die "旧版备份缺少 metadata.json，不能自动恢复。"
  target="$(jq -r '.target' "$meta")"; filename="$(jq -r '.filename' "$meta")"
  expected="$(jq -r '.sha256' "$meta")"; engine="$(jq -r '.engine' "$meta")"; site="$(jq -r '.site_id' "$meta")"
  backup_file="$dir/$filename"; [[ -f "$backup_file" ]] || die "备份文件不存在：$backup_file"
  verify_backup_hash "$backup_file" "$expected"
  target_is_managed_config "$target" || die "备份目标不在 Caddy/Nginx 配置目录内，拒绝恢复：$target"
  [[ -f "$target" ]] && target_existed=1
  (( target_existed )) || [[ "$engine" == "nginx" ]] || die "当前 Caddy 目标文件不存在，拒绝创建未知文件：$target"
  printf '将用备份 %s 覆盖 %s，确认？[y/N]：' "$backup_id" "$target"; read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || die "已取消。"
  acquire_lock
  (( target_existed == 0 )) || current_backup="$(backup_target "$site" "$target" pre-restore)"
  staged="$(mktemp "${target}.restore.XXXXXX")"; cat "$backup_file" >"$staged"
  if (( target_existed )); then chown --reference="$target" "$staged"; chmod --reference="$target" "$staged"; else chmod 0644 "$staged"; fi
  mv "$staged" "$target"
  if [[ "$engine" == "caddy" ]]; then
    if ! caddy validate --config "$CADDYFILE" --adapter caddyfile || ! systemctl reload caddy; then
      if (( target_existed )); then cp -a "$current_backup/$(basename "$target")" "$target"; else rm -f "$target"; fi
      systemctl reload caddy >/dev/null 2>&1 || true
      die "恢复后 Caddy 验证/reload 失败，已回到恢复前配置：$current_backup"
    fi
  elif [[ "$engine" == "nginx" ]]; then
    if ! nginx -t || ! systemctl reload nginx; then
      if (( target_existed )); then cp -a "$current_backup/$(basename "$target")" "$target"; else rm -f "$target"; fi
      systemctl reload nginx >/dev/null 2>&1 || true
      die "恢复后 Nginx 验证/reload 失败，已回到恢复前配置：$current_backup"
    fi
  else
    if (( target_existed )); then cp -a "$current_backup/$(basename "$target")" "$target"; else rm -f "$target"; fi
    die "备份未记录有效引擎，已取消恢复。"
  fi
  release_lock
  if [[ -f "$dir/site-state.json" ]]; then
    install_managed_file 0640 "$dir/site-state.json" "$(state_file "$site")"
  fi
  if [[ -n "$current_backup" ]]; then ok "备份已恢复；恢复前状态另存于：$current_backup"; else ok "备份已恢复到原 Nginx 配置路径。"; fi
}

backup_clean() {
  local keep="${1:-20}" yes="${2:-}" answer dir index=0 removed=0
  [[ "$keep" =~ ^[0-9]+$ ]] && ((keep>=1)) || die "保留数量必须是正整数。"
  [[ "$yes" == "--yes" ]] || { printf '将只保留最新 %s 个管理器备份，确认？[y/N]：' "$keep"; read -r answer; [[ "$answer" =~ ^[Yy]$ ]] || die "已取消。"; }
  acquire_lock
  while IFS= read -r dir; do
    ((index+=1)); (( index <= keep )) && continue
    [[ "$(dirname "$dir")" == "$BACKUPS_DIR" ]] || die "备份路径越界：$dir"
    rm -rf -- "$dir"; ((removed+=1))
  done < <(find "$BACKUPS_DIR" -mindepth 1 -maxdepth 1 -type d -print | sort -r)
  release_lock; ok "已清理 $removed 个旧备份。"
}

apply_caddy_removal() {
  local id="$1" target="$2" candidate="$3" backup staged
  [[ -f "$target" ]] || die "Caddy 配置文件不存在：$target"
  target="$(readlink -f "$target")"
  backup="$(backup_target "$id" "$target")"
  staged="$(mktemp "${target}.emby-candidate.XXXXXX")"
  cat "$candidate" >"$staged"
  chown --reference="$target" "$staged"
  chmod --reference="$target" "$staged"
  mv "$staged" "$target"
  if ! caddy validate --config "$CADDYFILE" --adapter caddyfile || ! systemctl reload caddy; then
    cp -a "$backup/$(basename "$target")" "$target"
    caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 && systemctl reload caddy >/dev/null 2>&1 || true
    die "Caddy 删除操作失败，已恢复：$backup"
  fi
  ok "Caddy 配置已更新，备份：$backup"
}

remove_attached_route() {
  local id="$1" file="$2" path="$3" target domain begin end candidate temp remaining begins ends
  target="$(jq -r '.config_file' "$file")"; domain="$(jq -r '.domain' "$file")"
  begin="# BEGIN MANAGED EMBY EXISTING ROUTE: $domain $path"; end="# END MANAGED EMBY EXISTING ROUTE: $domain $path"
  begins="$(grep -cFx "$begin" "$target" 2>/dev/null || true)"; ends="$(grep -cFx "$end" "$target" 2>/dev/null || true)"
  [[ "$begins" == 1 && "$ends" == 1 ]] || die "路径 $path 的托管标记缺失、重复或不完整，脚本不会自动删除。"
  candidate="$(mktemp /tmp/emby-caddy-delete.XXXXXX)"
  awk -v begin="$begin" -v end="$end" '$0==begin {skip=1;next} skip&&$0==end {skip=0;next} !skip{print}' "$target" >"$candidate"
  apply_caddy_removal "$id" "$target" "$candidate"; rm -f "$candidate"
  temp="$(mktemp /tmp/emby-state-delete.XXXXXX)"
  jq --arg path "$path" '.routes=(.routes | map(select(.path!=$path)))' "$file" >"$temp"
  remaining="$(jq '.routes|length' "$temp")"
  if (( remaining == 0 )); then rm -f "$file"; else install_managed_file 0640 "$temp" "$file"; fi
  rm -f "$temp"
}

route_delete() {
  local id="$1" file path kind temp count answer
  file="$(require_site "$id")"
  printf '请输入要删除的路径：'; read -r path; path="$(validate_route_path "$path")"
  count="$(jq --arg path "$path" '[.routes[]|select(.path==$path)]|length' "$file")"
  (( count == 1 )) || die "路径不存在：$path"
  kind="$(jq -r '.managed_kind' "$file")"
  if [[ "$kind" == "standalone" && "$path" == "/" ]]; then
    die "独立入口的根路径不能单独删除；请删除整个入口。"
  fi
  printf '确认删除路径 %s？[y/N]：' "$path"; read -r answer; [[ "$answer" =~ ^[Yy]$ ]] || die "已取消。"
  if [[ "$kind" == "caddy_attached" ]]; then
    acquire_lock; remove_attached_route "$id" "$file" "$path"; release_lock
  else
    temp="$(mktemp /tmp/emby-route-delete.XXXXXX.json)"
    jq --arg path "$path" '.routes=(.routes | map(select(.path!=$path)))' "$file" >"$temp"
    run_backend_for_state "$temp"; rm -f "$temp"
  fi
}

delete_site() {
  local id="$1" file engine kind target answer candidate key begin end backup path temp begins ends domain acme other_same=0 state
  file="$(require_site "$id")"; engine="$(jq -r '.engine' "$file")"; kind="$(jq -r '.managed_kind' "$file")"
  printf '确认删除入口 %s 的全部脚本托管配置？[y/N]：' "$id"; read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || die "已取消。"
  acquire_lock
  target="$(jq -r '.config_file' "$file")"
  if [[ "$engine" == "caddy" ]]; then
    candidate="$(mktemp /tmp/emby-site-delete.XXXXXX)"; cp -a "$target" "$candidate"
    if [[ "$kind" == "caddy_attached" ]]; then
      while IFS= read -r path; do
        begin="# BEGIN MANAGED EMBY EXISTING ROUTE: $(jq -r '.domain' "$file") $path"
        end="# END MANAGED EMBY EXISTING ROUTE: $(jq -r '.domain' "$file") $path"
        begins="$(grep -cFx "$begin" "$candidate" 2>/dev/null || true)"; ends="$(grep -cFx "$end" "$candidate" 2>/dev/null || true)"
        [[ "$begins" == 1 && "$ends" == 1 ]] || die "路径 $path 的托管标记不完整，删除已停止。"
        temp="$(mktemp /tmp/emby-strip.XXXXXX)"
        awk -v begin="$begin" -v end="$end" '$0==begin{skip=1;next} skip&&$0==end{skip=0;next} !skip{print}' "$candidate" >"$temp"
        mv "$temp" "$candidate"
      done < <(jq -r '.routes[].path' "$file")
    else
      key="$(site_proxy_key "$file")"
      begin="# BEGIN MANAGED EMBY REVERSE PROXY: $key"; end="# END MANAGED EMBY REVERSE PROXY: $key"
      begins="$(grep -cFx "$begin" "$candidate" 2>/dev/null || true)"; ends="$(grep -cFx "$end" "$candidate" 2>/dev/null || true)"
      [[ "$begins" == 1 && "$ends" == 1 ]] || die "入口 $id 的托管标记不完整，删除已停止。"
      temp="$(mktemp /tmp/emby-strip.XXXXXX)"
      awk -v begin="$begin" -v end="$end" '$0==begin{skip=1;next} skip&&$0==end{skip=0;next} !skip{print}' "$candidate" >"$temp"
      mv "$temp" "$candidate"
    fi
    apply_caddy_removal "$id" "$target" "$candidate"; rm -f "$candidate"
  else
    [[ -f "$target" ]] || die "Nginx 配置文件不存在：$target"
    backup="$(backup_target "$id" "$target")"; rm -f "$target"
    domain="$(jq -r '.domain' "$file")"
    while IFS= read -r state; do
      [[ "$state" == "$file" ]] && continue
      [[ "$(jq -r '.domain // empty' "$state" 2>/dev/null)" == "$domain" ]] && other_same=1
    done < <(find "$SITES_DIR" -maxdepth 1 -type f -name 'domain-*.json' -print 2>/dev/null)
    acme="$NGINX_CONF_DIR/emby-proxy-acme-${domain}.conf"
    if (( other_same == 0 )) && [[ -f "$acme" ]] && grep -Fx "# MANAGED EMBY ACME: $domain" "$acme" >/dev/null 2>&1; then
      cp -a "$acme" "$backup/$(basename "$acme")"
      rm -f "$acme"
    else
      acme=""
    fi
    if ! nginx -t || ! systemctl reload nginx; then
      cp -a "$backup/$(basename "$target")" "$target"
      [[ -z "${acme:-}" ]] || cp -a "$backup/$(basename "$acme")" "$acme"
      nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
      die "Nginx 删除操作失败，已恢复：$backup"
    fi
    ok "Nginx 配置已删除，备份：$backup"
  fi
  rm -f "$file"
  release_lock
  ok "入口 $id 已从管理索引删除。"
}

config_test() {
  local failed=0
  if command -v caddy >/dev/null 2>&1 && [[ -f "$CADDYFILE" ]]; then
    caddy validate --config "$CADDYFILE" --adapter caddyfile && ok "Caddy 配置验证通过" || failed=1
  fi
  if command -v nginx >/dev/null 2>&1; then
    nginx -t && ok "Nginx 配置验证通过" || failed=1
  fi
  (( failed == 0 )) || return 1
}

service_control() {
  local action="${1:-status}" engine="${2:-}"
  case "$action" in
    status)
      printf '%s\n%s\n' "$(service_line caddy caddy)" "$(service_line nginx nginx)" ;;
    reload|restart)
      [[ "$engine" == "caddy" || "$engine" == "nginx" ]] || die "用法：emby-proxy service $action caddy|nginx"
      doctor_config_quiet "$engine" || die "$engine 配置验证失败，拒绝 ${action}。"
      systemctl "$action" "$engine"
      systemctl is-active --quiet "$engine" || die "$engine 在 $action 后未处于运行状态。"
      ok "$engine 已安全执行 ${action}。" ;;
    logs)
      [[ "$engine" == "caddy" || "$engine" == "nginx" ]] || die "用法：emby-proxy service logs caddy|nginx"
      journalctl -u "$engine" -n 100 --no-pager ;;
    *) die "服务操作支持：status、reload、restart、logs。" ;;
  esac
}

verify_update_checksums() {
  local dir="$1" expected file actual manager_seen=0 backend_seen=0
  [[ -f "$dir/checksums.txt" ]] || die "更新源缺少 checksums.txt。"
  while IFS=' ' read -r expected file; do
    [[ "$file" == "emby-proxy" || "$file" == "setup-emby-proxy.sh" ]] || continue
    [[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || die "更新文件 $file 的 SHA256 格式无效。"
    expected="$(printf '%s' "$expected" | tr 'A-F' 'a-f')"
    [[ -f "$dir/$file" ]] || die "更新包缺少：$file"
    if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$dir/$file" | awk '{print $1}')";
    else actual="$(shasum -a 256 "$dir/$file" | awk '{print $1}')"; fi
    [[ "$actual" == "$expected" ]] || die "更新文件 $file 的 SHA256 不匹配。"
    [[ "$file" == "emby-proxy" ]] && manager_seen=1 || backend_seen=1
  done <"$dir/checksums.txt"
  (( manager_seen == 1 && backend_seen == 1 )) || die "checksums.txt 必须同时包含 emby-proxy 和 setup-emby-proxy.sh。"
}

atomic_install_executable() {
  local source="$1" target="$2" staged
  install_managed_dir 0755 "$(dirname "$target")"
  staged="$(mktemp "$(dirname "$target")/.emby-update.XXXXXX")"
  cat "$source" >"$staged"; chmod 0755 "$staged"
  [[ ${EUID:-$(id -u)} -ne 0 ]] || chown root:root "$staged"
  mv "$staged" "$target"
}

ensure_short_command() {
  local link_target=""
  [[ "$SHORT_BIN" != "$MANAGER_BIN" ]] || return 0
  if [[ -L "$SHORT_BIN" ]]; then
    link_target="$(readlink "$SHORT_BIN" 2>/dev/null || true)"
  fi
  if [[ -e "$SHORT_BIN" || -L "$SHORT_BIN" ]]; then
    if [[ "$link_target" == "$MANAGER_BIN" ]]; then
      return 0
    fi
    warn "快捷命令 $SHORT_BIN 已被其他程序占用，未覆盖；仍可使用 sudo emby-proxy。"
    return 1
  fi
  install_managed_dir 0755 "$(dirname "$SHORT_BIN")"
  ln -s "$MANAGER_BIN" "$SHORT_BIN"
  [[ ${EUID:-$(id -u)} -ne 0 ]] || chown -h root:root "$SHORT_BIN"
  return 0
}

uninstall_archive() {
  local backup_root="$1" timestamp="$2" archive="$backup_root/emby-proxy-uninstall-$timestamp.tar.gz" sha items=() file
  install_managed_dir 0750 "$backup_root"
  # 只打包脚本明确管理的路径；不会把整台机器或 Caddy/Nginx 证书带走。
  for file in "$STATE_HOME" "$CADDYFILE" "$NGINX_LEGACY_CONFIG" "$NGINX_HASH_CONFIG" \
    "$NGINX_ACME_ROOT" "$MANAGER_BIN" "$SHORT_BIN" "$INSTALLED_BACKEND" "$MANAGER_LIBEXEC" \
    /etc/systemd/system/emby-proxy-master.service /etc/systemd/system/emby-proxy-node.service \
    /etc/systemd/system/emby-proxy-node.timer; do
    [[ -e "$file" || -L "$file" ]] && items+=("$file")
  done
  while IFS= read -r file; do items+=("$file"); done < <(find "$CADDY_LOG_DIR" "$NGINX_LOG_DIR" -maxdepth 1 -type f -name 'emby-proxy-*-access.log' -print 2>/dev/null || true)
  if ((${#items[@]} == 0)); then
    tar -czf "$archive" --files-from /dev/null
  else
    tar -czf "$archive" "${items[@]}"
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sha="$(sha256sum "$archive" | awk '{print $1}')"
  else
    sha="$(shasum -a 256 "$archive" | awk '{print $1}')"
  fi
  printf '%s  %s\n' "$sha" "$(basename "$archive")" >"$archive.sha256"
  printf '%s' "$archive"
}

uninstall_remove_caddy_markers() {
  local target="${1:-$CADDYFILE}" begin end begins ends temp saved
  [[ -f "$target" ]] || return 0
  begin="$(grep -Ec '^# BEGIN MANAGED EMBY (REVERSE PROXY|EXISTING ROUTE):' "$target" 2>/dev/null || true)"
  end="$(grep -Ec '^# END MANAGED EMBY (REVERSE PROXY|EXISTING ROUTE):' "$target" 2>/dev/null || true)"
  (( begin == 0 && end == 0 )) && return 0
  if (( begin != end )); then
    warn "Caddyfile 中脚本标记不完整，保留原文件：$target"
    return 0
  fi
  temp="$(mktemp /tmp/emby-proxy-uninstall-caddy.XXXXXX)"
  awk '/^# BEGIN MANAGED EMBY (REVERSE PROXY|EXISTING ROUTE):/{skip=1;next} /^# END MANAGED EMBY (REVERSE PROXY|EXISTING ROUTE):/{if(skip){skip=0;next}} !skip{print}' "$target" >"$temp"
  saved="$(mktemp /tmp/emby-proxy-uninstall-caddy-old.XXXXXX)"; cp -a "$target" "$saved"
  cat "$temp" >"$target"; rm -f "$temp"
  if command -v caddy >/dev/null 2>&1 && ! caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
    cp -a "$saved" "$target"; rm -f "$saved"
    warn "Caddy 清理后配置验证失败，已恢复：$target"
    return 0
  fi
  rm -f "$saved"
  systemctl reload caddy >/dev/null 2>&1 || warn "Caddy 已清理，但 reload 失败，请手动检查服务。"
}

uninstall_remove_nginx_owned_file() {
  local target="$1" marker="$2" saved
  [[ -f "$target" ]] || return 0
  grep -F "$marker" "$target" >/dev/null 2>&1 || return 0
  saved="$(mktemp /tmp/emby-proxy-uninstall-nginx.XXXXXX)"; cp -a "$target" "$saved"; rm -f "$target"
  if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
    cp -a "$saved" "$target"; rm -f "$saved"
    warn "Nginx 清理后配置验证失败，已恢复：$target"
    return 0
  fi
  rm -f "$saved"
  systemctl reload nginx >/dev/null 2>&1 || warn "Nginx 已清理，但 reload 失败，请手动检查服务。"
}

uninstall_manager() {
  local option="${1:-}" answer backup_root timestamp archive file id
  local -a ids=()
  UNINSTALL_COMPLETED=0
  [[ -z "$option" || "$option" == "--yes" ]] || die "用法：emby-proxy uninstall [--yes]"
  if [[ "$option" != "--yes" ]]; then
    printf '\n这会删除 emby-proxy 管理器、脚本托管入口、主控/边缘服务和管理索引。\n'
    printf 'Caddy/Nginx 程序、其他站点配置和证书不会删除。\n'
    printf '删除前会生成可校验备份；输入 REMOVE EMBY-PROXY 确认：'; read -r answer
    [[ "$answer" == "REMOVE EMBY-PROXY" ]] || { warn "已取消卸载。"; return 0; }
  fi
  backup_root="${EMBY_PROXY_UNINSTALL_BACKUP_DIR:-/var/backups}"
  timestamp="$(date -u +%Y%m%d-%H%M%S)"
  archive="$(uninstall_archive "$backup_root" "$timestamp")"
  ok "卸载前备份已创建：$archive"
  ok "SHA256：$archive.sha256"

  # 先导入旧版索引，再逐个调用已有的严格删除逻辑；缺失标记时会停止而不碰未知配置。
  if command -v jq >/dev/null 2>&1; then
    ensure_state_dirs
    import_existing >/dev/null 2>&1 || true
    while IFS= read -r file; do
      id="$(jq -r '.id // empty' "$file" 2>/dev/null || true)"
      [[ -n "$id" ]] && ids+=("$id")
    done < <(find "$SITES_DIR" -maxdepth 1 -type f -name 'domain-*.json' -print 2>/dev/null | sort)
    if ((${#ids[@]} > 0)); then
      for id in "${ids[@]}"; do
        [[ -f "$(state_file "$id")" ]] || continue
        delete_site "$id" <<<"y"
      done
    fi
  else
    warn "未找到 jq，跳过入口索引清理；配置备份仍已生成。"
  fi

  uninstall_remove_caddy_markers
  if [[ -d "$(dirname "$CADDYFILE")" ]]; then
    while IFS= read -r file; do
      [[ "$file" == "$CADDYFILE" ]] || uninstall_remove_caddy_markers "$file"
    done < <(find "$(dirname "$CADDYFILE")" -maxdepth 1 -type f \( -name '*.caddy' -o -name '*.conf' \) -print 2>/dev/null | sort)
  fi
  uninstall_remove_nginx_owned_file "$NGINX_LEGACY_CONFIG" "MANAGED EMBY"
  uninstall_remove_nginx_owned_file "$NGINX_HASH_CONFIG" "MANAGED EMBY NGINX HASH CAPACITY"
  if [[ -d "$NGINX_CONF_DIR" ]]; then
    while IFS= read -r file; do
      uninstall_remove_nginx_owned_file "$file" "MANAGED EMBY SITE"
    done < <(find "$NGINX_CONF_DIR" -maxdepth 1 -type f -name 'emby-proxy-*.conf' -print 2>/dev/null | sort)
    while IFS= read -r file; do
      uninstall_remove_nginx_owned_file "$file" "MANAGED EMBY ACME"
    done < <(find "$NGINX_CONF_DIR" -maxdepth 1 -type f -name 'emby-proxy-acme-*.conf' -print 2>/dev/null | sort)
  fi
  if [[ "$NGINX_ACME_ROOT" == */emby-proxy-acme && -d "$NGINX_ACME_ROOT" ]] && ! find "$NGINX_ACME_ROOT" -type f -print -quit 2>/dev/null | grep -q .; then
    rm -rf -- "$NGINX_ACME_ROOT"
  fi
  for file in /etc/systemd/system/emby-proxy-master.service /etc/systemd/system/emby-proxy-node.service /etc/systemd/system/emby-proxy-node.timer; do
    systemctl disable --now "$(basename "$file")" >/dev/null 2>&1 || true
    rm -f -- "$file"
  done
  systemctl daemon-reload >/dev/null 2>&1 || true
  find "$CADDY_LOG_DIR" "$NGINX_LOG_DIR" -maxdepth 1 -type f -name 'emby-proxy-*-access.log' -delete 2>/dev/null || true
  if [[ -d "$STATE_HOME" && "$STATE_HOME" != "/" && "$STATE_HOME" != "/etc" && "$STATE_HOME" != "/var" && \
    ( "$STATE_HOME" == */emby-proxy* || ( -d "$STATE_HOME/sites.d" && -d "$STATE_HOME/backups" ) ) ]]; then
    rm -rf -- "$STATE_HOME"
  elif [[ -d "$STATE_HOME" ]]; then
    warn "自定义管理目录未满足安全路径检查，已保留：$STATE_HOME"
  fi
  rm -f -- "$INSTALLED_BACKEND" "$MANAGER_BIN"
  if [[ -L "$SHORT_BIN" ]] && [[ "$(readlink "$SHORT_BIN" 2>/dev/null || true)" == "$MANAGER_BIN" ]]; then rm -f -- "$SHORT_BIN"; fi
  if [[ -d "$MANAGER_LIBEXEC" && "$MANAGER_LIBEXEC" == */emby-proxy ]]; then rm -rf -- "$MANAGER_LIBEXEC"; fi
  UNINSTALL_COMPLETED=1
  ok "emby-proxy 已完全卸载。Caddy/Nginx 及其证书保持不变。"
  info "如需恢复，请保留备份并使用 tar -xzf 查看：$archive"
}

installed_manager_version() {
  [[ -x "$MANAGER_BIN" ]] || { printf '%s' "$VERSION"; return; }
  "$MANAGER_BIN" version 2>/dev/null | awk 'NR==1 {print $2}'
}

restart_updated_manager() {
  local previous_version="$1" installed_version
  installed_version="$(installed_manager_version)"
  [[ -n "$installed_version" && "$installed_version" != "$previous_version" ]] || return 0
  if [[ -t 0 && -t 1 ]]; then
    info "更新完成，正在自动重新启动管理面板……"
    exec "$MANAGER_BIN"
  fi
  info "更新完成；下次直接输入 ep 即可打开新版本。"
}

self_update() {
  local option="${1:-}" temp latest_version answer backup_dir timestamp manager_backup="" backend_backup="" nonce manager_url backend_url checksums_url
  [[ -z "$option" || "$option" == "--check" || "$option" == "--force" ]] || die "用法：emby-proxy update [--check|--force]"
  temp="$(mktemp -d /tmp/emby-proxy-update.XXXXXX)"
  nonce="$(date +%s%N)"
  manager_url="$UPDATE_BASE_URL/emby-proxy"
  backend_url="$UPDATE_BASE_URL/setup-emby-proxy.sh"
  checksums_url="$UPDATE_BASE_URL/checksums.txt"
  if [[ "$UPDATE_BASE_URL" == http://* || "$UPDATE_BASE_URL" == https://* ]]; then
    manager_url+="?cachebust=$nonce"
    backend_url+="?cachebust=$nonce"
    checksums_url+="?cachebust=$nonce"
  fi
  info "正在从更新源获取管理器和安装后端……"
  curl -fsSL -H 'Cache-Control: no-cache' --connect-timeout 8 --max-time 30 "$manager_url" -o "$temp/emby-proxy" || die "下载 emby-proxy 失败。"
  curl -fsSL -H 'Cache-Control: no-cache' --connect-timeout 8 --max-time 30 "$backend_url" -o "$temp/setup-emby-proxy.sh" || die "下载安装后端失败。"
  curl -fsSL -H 'Cache-Control: no-cache' --connect-timeout 8 --max-time 30 "$checksums_url" -o "$temp/checksums.txt" || die "下载校验文件失败。"
  verify_update_checksums "$temp"
  bash -n "$temp/emby-proxy" "$temp/setup-emby-proxy.sh" || die "更新文件语法验证失败。"
  latest_version="$(sed -n 's/^readonly VERSION="\([^"]*\)"/\1/p' "$temp/emby-proxy" | head -n1)"
  [[ -n "$latest_version" ]] || die "无法识别更新版本。"
  printf '当前版本：%s\n远端版本：%s\n' "$VERSION" "$latest_version"
  if [[ "$option" == "--check" ]]; then
    [[ "$latest_version" == "$VERSION" ]] && ok "当前已是最新版本。" || info "发现可更新版本：$latest_version"
    rm -rf "$temp"
    return
  fi
  if [[ "$latest_version" == "$VERSION" && "$option" != "--force" ]]; then ok "当前已是最新版本。"; rm -rf "$temp"; return; fi
  if [[ "$option" != "--force" ]]; then
    printf '确认更新管理命令和安装后端？[y/N]：'; read -r answer; [[ "$answer" =~ ^[Yy]$ ]] || die "已取消。"
  fi
  acquire_lock
  timestamp="$(date +%Y%m%d-%H%M%S)"; backup_dir="$BACKUPS_DIR/update-$timestamp"
  install_managed_dir 0750 "$backup_dir"
  if [[ -f "$MANAGER_BIN" ]]; then cp -a "$MANAGER_BIN" "$backup_dir/emby-proxy"; manager_backup=1; fi
  if [[ -f "$INSTALLED_BACKEND" ]]; then cp -a "$INSTALLED_BACKEND" "$backup_dir/setup-emby-proxy.sh"; backend_backup=1; fi
  if ! atomic_install_executable "$temp/emby-proxy" "$MANAGER_BIN" || \
     ! atomic_install_executable "$temp/setup-emby-proxy.sh" "$INSTALLED_BACKEND"; then
    [[ -z "$manager_backup" ]] || cp -a "$backup_dir/emby-proxy" "$MANAGER_BIN"
    [[ -z "$backend_backup" ]] || cp -a "$backup_dir/setup-emby-proxy.sh" "$INSTALLED_BACKEND"
    release_lock; die "更新安装失败，已恢复旧文件：$backup_dir"
  fi
  ensure_short_command || true
  release_lock
  rm -rf "$temp"
  ok "已更新到 ${latest_version}；旧版本备份：$backup_dir"
}

