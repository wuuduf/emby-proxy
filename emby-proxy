controller_telegram_install() {
  local state unit unit_name backup state_backup unit_exists=0 was_active=0 was_enabled=0 state_arg state_dir_arg
  state="$(controller_require_state)" || return 1
  [[ "$(jq -r '.telegram.enabled // false' "$state")" == true ]] || { warn "请先配置 Telegram Bot。"; return 1; }
  unit="$TELEGRAM_UNIT"
  # 只接管带有本项目标记的 unit，避免覆盖管理员或第三方同名服务。
  if [[ -f "$unit" ]]; then
    grep -Fx '# MANAGED EMBY TELEGRAM BOT' "$unit" >/dev/null 2>&1 || {
      warn "已有 $unit 不是 emby-proxy 托管文件，拒绝覆盖。请先人工处理或改用其他服务名。"
      return 1
    }
    unit_exists=1
    backup="${unit}.bak-$(date -u +%Y%m%d-%H%M%S)"
    local backup_suffix=1
    while [[ -e "$backup" ]]; do
      backup="${unit}.bak-$(date -u +%Y%m%d-%H%M%S)-${backup_suffix}"
      ((backup_suffix+=1))
    done
    install -m 0644 "$unit" "$backup"
    info "旧 Telegram 服务单元已备份：$backup"
  fi
  unit_name="$(basename -- "$unit")"
  state_backup="$(mktemp /tmp/emby-proxy-telegram-state.XXXXXX)" || return 1
  install -m 0600 "$state" "$state_backup"
  systemctl is-active --quiet "$unit_name" 2>/dev/null && was_active=1
  systemctl is-enabled --quiet "$unit_name" 2>/dev/null && was_enabled=1
  # systemd 的 ExecStart/ReadWritePaths 使用双引号语法；显式转义路径，
  # 这样自定义状态目录包含空格或引号时也不会拆成多个参数。
  state_arg="${state//\\/\\\\}"
  state_arg="${state_arg//\"/\\\"}"
  # '%' starts a systemd specifier even inside quoted arguments; preserve a
  # literal percent in custom state paths by doubling it.
  state_arg="${state_arg//%/%%}"
  state_arg="${state_arg//$'\n'/\\n}"
  state_dir_arg="$(dirname "$state")"
  state_dir_arg="${state_dir_arg//\\/\\\\}"
  state_dir_arg="${state_dir_arg//\"/\\\"}"
  state_dir_arg="${state_dir_arg//%/%%}"
  state_dir_arg="${state_dir_arg//$'\n'/\\n}"
  cat >"$unit" <<EOF
# MANAGED EMBY TELEGRAM BOT
[Unit]
Description=emby-proxy Telegram notification bot
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/sbin/emby-proxy controller telegram-serve --state="$state_arg"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths="$state_dir_arg"
[Install]
WantedBy=multi-user.target
EOF
  if ! systemctl daemon-reload || ! systemctl enable "$unit_name" ||
     ! systemctl restart "$unit_name" ||
     ! systemctl is-active --quiet "$unit_name"; then
    warn "Telegram 服务启动/重启失败，正在恢复旧 unit 和配置。"
    systemctl stop "$unit_name" >/dev/null 2>&1 || true
    if (( unit_exists )); then
      install -m 0644 "$backup" "$unit"
    else
      rm -f "$unit"
    fi
    install -m 0600 "$state_backup" "$state"
    systemctl daemon-reload >/dev/null 2>&1 || true
    (( was_enabled )) || systemctl disable "$unit_name" >/dev/null 2>&1 || true
    if (( was_active )); then
      systemctl start "$unit_name" >/dev/null 2>&1 || warn "旧 Telegram 服务恢复失败，请手动检查 systemctl。"
    fi
    rm -f "$state_backup"
    return 1
  fi
  rm -f "$state_backup"
  ok "Telegram Bot 服务已启动：emby-proxy-telegram.service"
}

