controller_state_path() {
  printf '%s' "${EMBY_PROXY_CONTROLLER_STATE:-$STATE_HOME/controller.json}"
}

controller_require_state() {
  local state
  state="$(controller_state_path)"
  [[ -f "$state" ]] || { warn "还没有主控状态，请先选择 1 初始化主控入口。"; return 1; }
  printf '%s' "$state"
}

controller_cf_curl() {
  local token_file="$1" token
  shift
  token="$(cat "$token_file")"
  curl -fsS --connect-timeout 8 --max-time 20 \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' "$@"
}

controller_cf_discover_ids() {
  local token_file="$1" domain="$2" record_type="${3:-A}" zones zone_id record_id records
  zones="$(controller_cf_curl "$token_file" -G 'https://api.cloudflare.com/client/v4/zones' --data-urlencode 'per_page=1000')" || {
    warn "Cloudflare Zone 查询失败，请检查 Token 权限和网络。"; return 1;
  }
  zone_id="$(jq -r --arg domain "$domain" '[((.result // [])[] as $z | select($domain == $z.name or ($domain|endswith("." + $z.name))) | $z)] | sort_by(.name|length) | last | .id // empty' <<<"$zones")"
  [[ -n "$zone_id" ]] || { warn "没有找到 $domain 对应的 Cloudflare Zone。"; return 1; }
  records="$(controller_cf_curl "$token_file" -G "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records" --data-urlencode "name=$domain" --data-urlencode 'per_page=100')" || {
    warn "Cloudflare DNS 记录查询失败，请检查 Token 是否有 Zone DNS Read/Edit 权限。"; return 1;
  }
  if jq -e --arg domain "$domain" --arg type "$record_type" '.result // [] | any(.[]; .name==$domain and ((.type=="A" or .type=="AAAA" or .type=="CNAME") and .type!=$type))' <<<"$records" >/dev/null 2>&1; then
    warn "$domain 存在冲突的 A/AAAA/CNAME 记录；当前地址类型为 $record_type，为避免双栈绕过切换请先人工处理。"; return 1
  fi
  record_id="$(jq -r --arg domain "$domain" --arg type "$record_type" '[((.result // [])[]) | select(.type==$type and .name==$domain)] | first.id // empty' <<<"$records")"
  [[ -n "$record_id" ]] || {
    warn "没有找到 $domain 的 $record_type 记录，请先在 Cloudflare DNS 中创建一条记录（建议灰云），再重试。"
    return 1
  }
  local record_ids
  record_ids="$(jq -r --arg domain "$domain" --arg type "$record_type" '[((.result // [])[]) | select(.type==$type and .name==$domain) | .id] | join(",")' <<<"$records")"
  printf '%s\t%s\t%s' "$zone_id" "$record_id" "$record_ids"
}

# 字段级重试：q/EOF 取消当前向导；默认值和自动生成值不额外提问。
ui_read_field() {
  local target="$1" prompt="$2" default="${3:-}" validator="${4:-}" value
  while true; do
    printf '%s' "$prompt"
    [[ -z "$default" ]] || printf ' [默认 %s]' "$default"
    printf '：'
    IFS= read -r value || { warn "输入结束，已取消当前向导。"; return 1; }
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ ! "$value" =~ ^[qQ]$ ]] || { info "已取消，返回上一级。"; return 1; }
    value="${value:-$default}"
    if [[ -n "$validator" ]] && ! "$validator" "$value"; then continue; fi
    printf -v "$target" '%s' "$value"
    return 0
  done
}

ui_valid_domain() {
  local label
  [[ ${#1} -le 253 && "$1" == *.* ]] || { warn "请填写域名，不带协议、端口或路径。"; return 1; }
  local -a labels
  IFS=. read -r -a labels <<<"$1"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || {
      warn "域名格式无效，请重新输入，例如 emby.example.com。"; return 1;
    }
  done
  [[ "$1" =~ \.[A-Za-z]{2,}$ ]] || { warn "请填写完整域名，例如 emby.example.com。"; return 1; }
}

ui_valid_optional_domain() { [[ -z "$1" ]] || ui_valid_domain "$1"; }

ui_valid_url() {
  python3 - "$1" <<'PY'
import sys
from urllib.parse import urlsplit
try:
    u = urlsplit(sys.argv[1])
    valid = (u.scheme in ('http', 'https') and bool(u.hostname) and
             not u.username and not u.password and not u.fragment and
             not u.query and u.path in ('', '/') and
             not any(c.isspace() or ord(c) < 32 for c in sys.argv[1]) and
             (u.port is None or 1 <= u.port <= 65535))
except ValueError:
    valid = False
if not valid:
    print('请输入有效的 http:// 或 https:// 地址（只含主机和端口，不带路径、查询或账号密码）。', file=sys.stderr)
    sys.exit(1)
PY
}

ui_valid_source() {
  local source="$1"
  [[ "$source" == *://* ]] || source="https://$source"
  ui_valid_url "$source"
}

ui_valid_yes_no() { [[ "$1" =~ ^[YyNn]$ ]] || { warn "请输入 y 或 n。"; return 1; }; }
ui_valid_priority() { [[ "$1" =~ ^[0-9]{1,9}$ ]] || { warn "请填写 0–999999999 的整数，数字越大越优先。"; return 1; }; }
ui_valid_ipv4() {
  local octet
  local -a octets
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { warn "IPv4 格式无效，请重新输入。"; return 1; }
  IFS=. read -r -a octets <<<"$1"
  for octet in "${octets[@]}"; do
    [[ "$octet" == 0 || "$octet" != 0* ]] && (( 10#$octet <= 255 )) || {
      warn "IPv4 每段须为 0–255，且不能有多余前导零。"; return 1;
    }
  done
}

controller_default_engine() {
  # 复用正在运行的引擎；都未安装时才回到 Caddy。技术选择不再打断普通向导，
  # 高级用户仍可通过 controller init --engine 显式指定。
  if command -v caddy >/dev/null 2>&1 && systemctl is-active --quiet caddy 2>/dev/null; then
    printf 'caddy'; return
  fi
  if command -v nginx >/dev/null 2>&1 && systemctl is-active --quiet nginx 2>/dev/null; then
    printf 'nginx'; return
  fi
  command -v caddy >/dev/null 2>&1 && { printf 'caddy'; return; }
  command -v nginx >/dev/null 2>&1 && { printf 'nginx'; return; }
  printf 'caddy'
}

controller_init_menu() {
  local state entry_id domain control_domain source engine address_family record_type zone_id record_id record_ids token_file answer cf_token discovered token_candidate force=0
  state="$(controller_state_path)"
  ui_section "1 / 3  配置主控入口"
  printf '只配置一次域名和源站；入口 ID 自动生成。任一问题输入 q 取消。\n'
  if [[ -f "$state" ]]; then
    warn "入口已存在。重新初始化会清空节点和注册码；新增节点请选择 3。"
    ui_read_field answer "仍要清空并重新配置？y/n" n ui_valid_yes_no || return 0
    [[ "$answer" =~ ^[Yy]$ ]] || return 0
    force=1
  fi
  ui_read_field domain "对外域名（例如 emby.example.com）" "" ui_valid_domain || return 0
  domain="$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')"
  entry_id="domain-$domain"
  ui_read_field source "Emby 源站（域名或 URL，可带端口）" "" ui_valid_source || return 0
  [[ "$source" == *://* ]] || source="https://$source"
  while true; do
    ui_read_field control_domain "独立主控域名（可选，留空稍后配置）" "" ui_valid_optional_domain || return 0
    control_domain="$(printf '%s' "$control_domain" | tr '[:upper:]' '[:lower:]')"
    [[ -z "$control_domain" || "$control_domain" != "$domain" ]] && break
    warn "主控域名不能与业务入口域名相同，请重新输入或留空。"
  done
  engine="$(jq -r '.engine // empty' "$state" 2>/dev/null || true)"
  [[ "$engine" == caddy || "$engine" == nginx ]] || engine="$(controller_default_engine)"
  info "边缘统一使用 ${engine}；如需指定其他引擎，请使用 CLI 的 --engine 参数。"
  address_family="$(jq -r '.address_family // "ipv4"' "$state" 2>/dev/null || printf ipv4)"
  ui_read_field address_family "边缘地址类型（ipv4/ipv6）" "$address_family" ui_valid_address_family || return 0
  [[ "$address_family" == ipv6 ]] && record_type=AAAA || record_type=A
  printf '\nCloudflare 主备切换在此配置（当前地址类型：%s）；使用 DNSPod 请选 n，建好入口后进入菜单 10 配置运营商线路。\n' "$record_type"
  token_file="$STATE_HOME/cf.token"
  local cf_default=n
  [[ -s "$token_file" ]] && cf_default=y
  ui_read_field answer "启用 Cloudflare ${record_type} 记录切换？y/n" "$cf_default" ui_valid_yes_no || return 0
  local -a args=(init --state "$state" --entry-id "$entry_id" --domain "$domain" --source "$source" --engine "$engine" --address-family "$address_family")
  [[ -z "$control_domain" ]] || args+=(--control-domain "$control_domain")
  (( force == 1 )) && args+=(--force)
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    if [[ -s "$token_file" ]]; then
      info "检测到已有 Cloudflare Token，自动沿用本地 600 权限文件。"
      chmod 600 "$token_file" || return 1
      discovered="$(controller_cf_discover_ids "$token_file" "$domain" "$record_type")" || {
        warn "已有 Token 无法查询 Cloudflare。删除 ${token_file} 后重试即可重新录入。"
        return 1
      }
    else
      printf 'Cloudflare API Token（输入隐藏，q 取消）：'
      IFS= read -r -s cf_token || return 0; printf '\n'
      [[ ! "$cf_token" =~ ^[qQ]$ ]] || return 0
      [[ -n "$cf_token" ]] || { warn "API Token 不能为空。"; return 1; }
      install_managed_dir 0750 "$(dirname "$token_file")" || return 1
      token_candidate="$(mktemp "$STATE_HOME/.cf-token.XXXXXX")" || return 1
      chmod 600 "$token_candidate"
      printf '%s\n' "$cf_token" >"$token_candidate"; unset cf_token
      if ! discovered="$(controller_cf_discover_ids "$token_candidate" "$domain" "$record_type")"; then
        rm -f "$token_candidate"
        return 1
      fi
      mv -f "$token_candidate" "$token_file" || { rm -f "$token_candidate"; return 1; }
    fi
    IFS=$'\t' read -r zone_id record_id record_ids <<<"$discovered"
    info "已自动获取 zone_id=${zone_id}，记录数=$(awk -F, '{print NF}' <<<"$record_ids")"
    args+=(--zone-id "$zone_id" --record-id "$record_id" --record-ids "$record_ids" --token-file "$token_file")
  fi
  controller_cli "${args[@]}" || return 1
  printf '\n入口：%s\n访问域名：https://%s\n主控域名：%s\n下一步：先让主控域名 %s 记录指向主控 VPS，再选 8 配置 HTTPS；DNSPod 先选 10 接入 DNS。\n' "$entry_id" "$domain" "${control_domain:-稍后配置}" "$record_type"
}

controller_generate_node_id() {
  local state="$1" public_ip="$2" base candidate suffix=2
  base="edge-$(printf '%s' "$public_ip" | tr '.' '-')"
  candidate="$base"
  while jq -e --arg id "$candidate" '(.nodes[$id] != null) or (.enroll_tokens[$id] != null)' "$state" >/dev/null 2>&1; do
    candidate="${base}-${suffix}"
    ((suffix++))
  done
  printf '%s' "$candidate"
}

controller_parse_quota() {
  python3 - "$1" "${2:-}" <<'PY'
import re
import sys
from decimal import Decimal, InvalidOperation
value, unit = sys.argv[1].strip(), sys.argv[2].upper()
units = {'B': 1, 'KB': 1024, 'MB': 1024**2, 'GB': 1024**3, 'TB': 1024**4}
if not unit:
    match = re.fullmatch(r'(\d+(?:\.\d+)?)\s*(B|KB|MB|GB|TB)?', value, re.I)
    if not match:
        raise SystemExit('请填写 500GB、1.5TB 或 0；纯数字按 GB 计算')
    value, unit = match.group(1), (match.group(2) or 'GB').upper()
if unit not in units:
    raise SystemExit('单位必须是 B、KB、MB、GB 或 TB')
try:
    number = Decimal(value)
except InvalidOperation:
    raise SystemExit('配额数值必须是非负数字')
if not number.is_finite() or number < 0 or number > Decimal(2**63-1) / units[unit]:
    raise SystemExit('配额必须是非负数字，且不超过 2^63-1 字节')
result = int(number * units[unit])
if number > 0 and result == 0:
    raise SystemExit('非零配额不能小于 1 字节')
print(result)
PY
}

ui_valid_listen() {
  local port="${1##*:}"
  [[ "$1" =~ ^[A-Za-z0-9.-]+:[0-9]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) || {
    warn "请填写 IPv4/主机名:端口，端口范围 1–65535。"; return 1;
  }
}
ui_valid_interval() {
  [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 86400 )) || {
    warn "检查间隔须为 1–86400 秒的整数。"; return 1;
  }
}

ui_valid_quota() { controller_parse_quota "$1" >/dev/null; }
ui_valid_quota_unit() {
  [[ "$1" =~ ^[0-5]$ ]] || { warn "请输入 0–5 选择单位，或输入 q 取消。"; return 1; }
}

controller_read_quota() {
  local quota_target="$1" unit_choice quota_unit quantity quota_bytes
  ui_section "配额单位"
  printf '  1) B\n  2) KB\n  3) MB\n  4) GB\n  5) TB\n  0) 不限额\n'
  printf '沿用二进制换算：1 GB = 1024³ 字节；输入 q 取消。\n'
  ui_read_field unit_choice "请选择单位" 0 ui_valid_quota_unit || return 1
  case "$unit_choice" in
    0) printf -v "$quota_target" '%s' 0; info "最终配额：不限额"; return 0 ;;
    1) quota_unit=B ;; 2) quota_unit=KB ;; 3) quota_unit=MB ;;
    4) quota_unit=GB ;; 5) quota_unit=TB ;;
  esac
  while true; do
    ui_read_field quantity "请输入配额数量（${quota_unit}，支持小数，0 不限额）" "" || return 1
    if [[ ! "$quantity" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      warn "请填写非负数字（例如 500 或 1.5），无需再次输入单位。"
      continue
    fi
    quota_bytes="$(controller_parse_quota "$quantity" "$quota_unit")" || continue
    if [[ "$quota_bytes" == 0 ]]; then
      printf -v "$quota_target" '%s' 0
      info "最终配额：不限额"
    else
      printf -v "$quota_target" '%s' "${quantity}${quota_unit}"
      info "最终配额：${quantity} ${quota_unit}（${quota_bytes} 字节）"
    fi
    return 0
  done
}

ui_valid_optional_ipv4() { [[ -z "$1" ]] || ui_valid_ipv4 "$1"; }
ui_valid_ipv6() {
  python3 - "$1" <<'PY'
import ipaddress, sys
try:
    value = ipaddress.IPv6Address(sys.argv[1])
    if not value.is_global or value.is_multicast: raise ValueError
except ValueError:
    raise SystemExit(1)
PY
}
ui_valid_optional_ipv6() { [[ -z "$1" ]] || { ui_valid_ipv6 "$1" || { warn "IPv6 格式无效，且必须是公网 IPv6。"; return 1; }; }; }
ui_valid_address_family() {
  [[ "$1" == ipv4 || "$1" == ipv6 ]] || { warn "地址类型只能填写 ipv4 或 ipv6。"; return 1; }
}

controller_issue_menu() {
  local state name priority quota quota_input public_ip controller_url saved_url control_domain status expected advanced address_family
  state="$(controller_require_state)" || return 1
  ui_section "3 / 3  添加边缘节点"
  printf '填写节点信息，生成命令后复制到对应 VPS 执行。输入 q 取消。\n'
  printf '主控 URL 示例：https://control.example.com；必须先配置好 HTTPS 入口。\n'
  saved_url="$(jq -r '.controller_url // empty' "$state")"
  control_domain="$(jq -r '.control_domain // empty' "$state")"
  if [[ -z "$saved_url" && -n "$control_domain" ]]; then
    if jq -e '.certificates != null' "$state" >/dev/null 2>&1; then
      saved_url="https://${control_domain}:19090"
    else
      saved_url="http://${control_domain}:19090"
    fi
    info "已沿用初始化时设置的主控域名：${saved_url}"
  fi
  if [[ -n "$saved_url" ]]; then
    controller_url="$saved_url"
    info "沿用上次验证通过的主控 URL：${controller_url}（如失效会要求重新填写）"
  else
    ui_read_field controller_url "边缘能访问的主控 URL（不是播放域名）" "" ui_valid_url || return 0
  fi
  controller_url="${controller_url%/}"
  info "正在检查主控连通性与入口身份……"
  status="$(curl -fsS --connect-timeout 5 --max-time 10 "$controller_url/status" 2>/dev/null)" || {
    if [[ -n "$saved_url" ]]; then
      warn "已记忆的主控 URL 无法访问，请填写新的可达 URL。"
      ui_read_field controller_url "边缘能访问的主控 URL（不是播放域名）" "" ui_valid_url || return 0
      controller_url="${controller_url%/}"
      status="$(curl -fsS --connect-timeout 5 --max-time 10 "$controller_url/status" 2>/dev/null)" || {
        warn "无法访问主控。请先选择 2 启动服务；确认 HTTPS 入口及防火墙已配置。127.0.0.1 不能供其他 VPS 访问。"
        return 1
      }
    else
      warn "无法访问主控。请先选择 2 启动服务；确认 HTTPS 入口及防火墙已配置。127.0.0.1 不能供其他 VPS 访问。"
      return 1
    fi
  }
  expected="$(jq -r '.entry_id' "$state")"
  jq -e --arg entry "$expected" '.entry_id == $entry' <<<"$status" >/dev/null 2>&1 || {
    warn "主控响应无效或入口不匹配。请检查 URL 是否指向当前入口的控制器，而非播放网站。"; return 1;
  }
  public_ip=""
  name=""
  priority=100
  quota_input=0
  address_family="$(jq -r '.address_family // "ipv4"' "$state")"
  info "入口地址类型固定为 ${address_family}；同一入口的所有边缘节点必须使用相同地址类型。"
  ui_read_field address_family "边缘地址类型（ipv4/ipv6）" "$address_family" ui_valid_address_family || return 0
  [[ "$address_family" == "$(jq -r '.address_family // "ipv4"' "$state")" ]] || { warn "该入口已固定地址类型，不能为单个节点混用。"; return 1; }
  info "默认：名称和 ID 自动生成 · 优先级 100 · 配额不限额；公网地址在边缘 VPS 执行时检测。"
  ui_read_field advanced "是否设置线路名称、优先级、配额或指定 IP？y/n" n ui_valid_yes_no || return 0
  if [[ "$advanced" =~ ^[Yy]$ ]]; then
    ui_read_field name "线路名称（留空自动生成）" "" || return 0
    ui_read_field priority "优先级（数字越大越优先）" 100 ui_valid_priority || return 0
    controller_read_quota quota_input || return 0
    if [[ "$address_family" == ipv6 ]]; then
      ui_read_field public_ip "指定边缘公网 IPv6（留空在边缘自动检测）" "" ui_valid_optional_ipv6 || return 0
    else
      ui_read_field public_ip "指定边缘公网 IPv4（留空在边缘自动检测）" "" ui_valid_optional_ipv4 || return 0
    fi
  fi
  quota="$(controller_parse_quota "$quota_input")" || return 1
  local quota_display="$quota_input"
  [[ "$quota" != 0 ]] || quota_display="不限额"
  printf '\n线路：%s · 地址类型：%s · 优先级：%s · 配额：%s（%s bytes）\n公网地址：%s\n\n' "${name:-自动生成}" "$address_family" "$priority" "$quota_display" "$quota" "${public_ip:-在边缘 VPS 自动检测}"
  local -a args=(issue --state "$state" --controller-url "$controller_url" --name "$name" --priority "$priority" --quota-bytes "$quota" --address-family "$address_family")
  [[ -z "$public_ip" ]] || args+=(--public-ip "$public_ip")
  controller_cli "${args[@]}" || return 1
  printf '\n复制上面整条命令到边缘 VPS 执行（含一次性注册码，请勿公开）。\n完成后选 4 查看节点是否收到心跳；选 6 排查主控日志。\n'
}

