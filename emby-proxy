def install_certificate_timer(name, arguments, interval):
    # State paths become systemd arguments, not shell fragments or specifiers.
    if any(not re.fullmatch(r'[A-Za-z0-9_./:-]+',str(v)) for v in arguments):
        raise RuntimeError('定时任务参数包含不支持的字符。')
    command='/usr/local/sbin/emby-proxy controller '+' '.join(arguments)
    units=[(Path('/etc/systemd/system/'+name+'.service'),
        '# MANAGED EMBY CERTIFICATE\n[Unit]\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nUMask=0077\nTimeoutStartSec=1200\nExecStart='+command+'\n'),
        (Path('/etc/systemd/system/'+name+'.timer'),
        '# MANAGED EMBY CERTIFICATE\n[Unit]\n[Timer]\nOnBootSec=2min\nOnUnitInactiveSec='+interval+'\nRandomizedDelaySec=60\n[Install]\nWantedBy=timers.target\n')]
    backups=[]; created=[]
    try:
        for path,content in units:
            if path.exists() and '# MANAGED EMBY CERTIFICATE' not in path.read_text():
                raise RuntimeError('同名证书单元不是脚本托管文件，拒绝覆盖。')
            if not path.exists(): created.append(path.name)
        for path,content in units: backups.append((path,write_unit(path,content)))
        subprocess.run(['systemctl','daemon-reload'],check=True)
        subprocess.run(['systemctl','enable','--now',name+'.timer'],check=True)
    except Exception:
        for path,backup in reversed(backups): restore_file(path,backup)
        subprocess.run(['systemctl','daemon-reload'],check=False)
        for unit_name in created: _restore_systemd_state(unit_name,False,False)
        raise

def issue_certificates(state, config):
    root=Path(config['directory']); root.mkdir(parents=True,exist_ok=True); os.chmod(root,0o700)
    dns=state.get('dns') or {}
    if dns.get('provider') != 'cloudflare': raise RuntimeError('请先配置 Cloudflare Token 和入口。')
    token=Path(dns['token_file']).read_text().strip()
    if not token or re.search(r'\s',token): raise RuntimeError('Cloudflare Token 格式无效。')
    credentials=root/'cloudflare.ini'
    # Never truncate an existing broadly-readable file before tightening permissions.
    flags=os.O_WRONLY|os.O_CREAT
    if hasattr(os,'O_NOFOLLOW'): flags |= os.O_NOFOLLOW
    fd=os.open(credentials,flags,0o600)
    with os.fdopen(fd,'w') as out:
        os.fchmod(out.fileno(),0o600); out.truncate(0); out.write('dns_cloudflare_api_token = '+token+'\n')
    for name,domain in (('entry',state['domain']),('control',config['control_domain'])):
        command=['certbot','certonly','--dns-cloudflare','--dns-cloudflare-credentials',str(credentials),
            '--dns-cloudflare-propagation-seconds','60','--config-dir',str(root/'acme'),
            '--work-dir',str(root/'work'),'--logs-dir',str(root/'logs'),
            '--cert-name',name,'-d',domain,'--non-interactive','--agree-tos',
            '--register-unsafely-without-email','--keep-until-expiring']
        try: subprocess.run(command,check=True,capture_output=True,timeout=540)
        except (OSError,subprocess.SubprocessError):
            raise RuntimeError('DNS-01 签发失败；旧证书保留。检查 Token 权限、CAA/DNS，日志：'+str(root/'logs')) from None
        live=root/'acme'/'live'/name
        install_certificate({'domain':domain,'engine':'nginx','certificate_directory':str(root/name)},
            {'domain':domain,'certificate':(live/'fullchain.pem').read_text(),'private_key':(live/'privkey.pem').read_text()},reload=False)

def controller_caddyfile_path():
    # The environment override keeps this flow testable without touching a host's
    # real Caddyfile.  Production always uses the system Caddyfile.
    return Path(os.environ.get('EMBY_PROXY_CADDYFILE', '/etc/caddy/Caddyfile'))

def controller_caddy_block(domain):
    return ('# BEGIN MANAGED EMBY PROXY CONTROLLER: %s\n'
            '%s {\n'
            '    reverse_proxy 127.0.0.1:19090\n'
            '}\n'
            '# END MANAGED EMBY PROXY CONTROLLER: %s\n' % (domain, domain, domain))

def update_controller_caddyfile(domain, path):
    """Add/update only our controller vhost, refusing unrelated conflicts."""
    path=Path(path); original=path.read_text() if path.exists() else ''
    block=controller_caddy_block(domain)
    marker=re.compile(r'(?ms)^# BEGIN MANAGED EMBY PROXY CONTROLLER: '
                     +re.escape(domain)+r'\s*$.*?^# END MANAGED EMBY PROXY CONTROLLER: '
                     +re.escape(domain)+r'\s*$\n?')
    if marker.search(original):
        updated=marker.sub(block,original,count=1)
    else:
        # An unmarked block may belong to an operator-managed site.  Ownership
        # must be explicit; never silently adopt or rewrite it.
        plain=re.compile(r'(?ms)^'+re.escape(domain)+r'\s*\{\s*reverse_proxy\s+127\.0\.0\.1:19090\s*\}\s*')
        if plain.search(original):
            raise RuntimeError('Caddyfile 已存在未标记的主控站点，拒绝接管：'+domain)
        elif re.search(r'(?m)^\s*'+re.escape(domain)+r'\s*\{', original):
            raise RuntimeError('Caddyfile 已存在非脚本托管的主控域名，拒绝覆盖：'+domain)
        else:
            updated=original.rstrip()+ ('\n\n' if original.strip() else '') + block
    if updated == original:
        return None
    backup=backup_file(path)
    path.parent.mkdir(parents=True,exist_ok=True)
    atomic_text_write(path, updated)
    return backup

def https_proxy_setup(a):
    """Put the controller behind Caddy HTTPS (HTTP-01), without exposing 19090."""
    if os.geteuid() != 0: raise RuntimeError('HTTPS 主控配置需要 root 或 sudo。')
    path=Path(a.state); domain=str(getattr(a,'control_domain','') or '').strip().lower().rstrip('.')
    with state_lock(str(path)+'.https-proxy'):
        state=json.loads(path.read_text())
        domain=domain or str(state.get('control_domain','')).strip().lower().rstrip('.')
        if not domain: raise RuntimeError('请先在主控初始化时填写独立主控域名。')
        if not re.fullmatch(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]*',domain):
            raise RuntimeError('主控必须使用独立的有效域名。')
        if domain == state.get('domain'): raise RuntimeError('主控域名不能与业务入口相同。')
        if not shutil.which('caddy'): raise RuntimeError('未找到 Caddy；请先安装并启动 Caddy。')
        active=subprocess.run(['systemctl','is-active','--quiet','caddy'],check=False,
                              stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode == 0
        if not active: raise RuntimeError('Caddy 未运行；请先启动 Caddy，且不要让脚本接管已有 Web 服务。')
        caddyfile=controller_caddyfile_path(); caddy_backup=None; state_backup=backup_file(path)
        try:
            caddy_backup=update_controller_caddyfile(domain,caddyfile)
            for command in (['caddy','fmt','--overwrite',str(caddyfile)],
                            ['caddy','validate','--config',str(caddyfile),'--adapter','caddyfile'],
                            ['systemctl','reload','caddy']):
                subprocess.run(command,check=True)
            with state_lock(path):
                latest=json.loads(path.read_text())
                latest['control_domain']=domain
                latest['controller_front_proxy']='caddy'
                latest['controller_url']='https://'+domain
                atomic_write(path,latest)
            master_install(argparse.Namespace(state=str(path.resolve()),listen='127.0.0.1:19090',reconcile_interval=30))
            if os.environ.get('EMBY_PROXY_SKIP_HTTPS_VERIFY') != '1':
                if not shutil.which('curl'): raise RuntimeError('缺少 curl，无法验证 HTTPS 主控。')
                verified=False; last=''
                for _ in range(10):
                    try:
                        result=subprocess.run(['curl','--noproxy','*','-fsS','--connect-timeout','5','--max-time','10','https://'+domain+'/status'],check=True,capture_output=True,text=True,timeout=15)
                        payload=json.loads(result.stdout)
                        if payload.get('entry_id') == latest.get('entry_id'):
                            verified=True; break
                        last='入口 ID 不匹配'
                    except Exception as e:
                        last=str(e)
                    time.sleep(6)
                if not verified: raise RuntimeError('HTTPS 主控验证失败（请确认 %s 记录已指向本机、放行 80/443，并等待 DNS/证书传播）：%s' % (address_record_type(latest.get('address_family','ipv4')),last))
        except Exception:
            # Restore both files and reload the previous known-good Caddy config.
            try:
                if caddy_backup: restore_file(caddyfile,caddy_backup)
                subprocess.run(['caddy','validate','--config',str(caddyfile),'--adapter','caddyfile'],check=False)
                subprocess.run(['systemctl','reload','caddy'],check=False)
            except Exception: pass
            try: restore_file(path,state_backup)
            except Exception: pass
            raise
    print('主控 HTTPS 已配置：https://'+domain+'（Caddy 443 → 127.0.0.1:19090）')

def cert_setup(a):
    if os.geteuid() != 0: raise RuntimeError('证书配置需要 root 或 sudo。')
    domain=str(a.control_domain).strip().lower().rstrip('.')
    if not re.fullmatch(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]*',domain):
        raise RuntimeError('主控必须使用独立的有效域名。')
    path=Path(a.state)
    with state_lock(str(path)+'.cert-issue'):
        state=json.loads(path.read_text())
        if domain == state['domain']: raise RuntimeError('主控域名不能与业务入口相同。')
        if state.get('certificates') and state['certificates']['control_domain'] != domain:
            raise RuntimeError('已启用的主控域名不能直接替换，请先规划迁移。')
        if getattr(a,'install_deps',False):
            subprocess.run(['apt-get','update'],check=True)
            subprocess.run(['apt-get','install','-y','certbot','python3-certbot-dns-cloudflare','openssl'],check=True)
        if not shutil.which('certbot'): raise RuntimeError('缺少 Certbot；菜单确认安装，或加 --install-deps。')
        config={'directory':str(path.resolve().parent/'certificates'),'control_domain':domain}
        issue_certificates(state,config)
        # Timer installation can fail; do not change the live controller protocol until it succeeds.
        timer_paths=[Path('/etc/systemd/system/emby-proxy-cert-renew.service'),
                     Path('/etc/systemd/system/emby-proxy-cert-renew.timer')]
        timer_snapshot=[]
        for timer_path in timer_paths:
            if timer_path.exists() and not timer_path.is_symlink():
                timer_snapshot.append((timer_path,True,timer_path.read_text(errors='replace'),timer_path.stat().st_mode & 0o777))
            else:
                timer_snapshot.append((timer_path,False,None,None))
        timer_was_enabled=_systemd_probe('emby-proxy-cert-renew.timer','is-enabled')
        timer_was_active=_systemd_probe('emby-proxy-cert-renew.timer','is-active')
        install_certificate_timer('emby-proxy-cert-renew',['cert-renew','--state',str(path.resolve())],'12h')
        was_active=subprocess.run(['systemctl','is-active','--quiet','emby-proxy-master.service'],capture_output=True).returncode == 0
        with state_lock(path):
            latest=json.loads(path.read_text())
            if any(latest.get(k) != state.get(k) for k in ('domain','entry_id','dns')):
                raise RuntimeError('签发期间入口配置发生变化，请重新执行。')
            backup_file(path); latest['certificates']=config
            latest['controller_url']='https://'+domain+':19090'; atomic_write(path,latest)
        try:
            family=normalize_address_family(latest.get('address_family','ipv4'))
            listen='[::]:19090' if family == 'ipv6' else '0.0.0.0:19090'
            master_install(argparse.Namespace(state=str(path.resolve()),listen=listen,reconcile_interval=30))
        except Exception:
            with state_lock(path):
                latest=json.loads(path.read_text())
                for key in ('certificates','controller_url'):
                    if key in state: latest[key]=state[key]
                    else: latest.pop(key,None)
                atomic_write(path,latest)
            try:
                subprocess.run(['systemctl','restart' if was_active else 'stop','emby-proxy-master.service'],check=True)
            except (OSError,subprocess.SubprocessError): print('提醒：主控配置已恢复，但服务恢复失败，请检查 systemd。',file=sys.stderr)
            # A successful timer install followed by a failed master install is
            # still a failed transaction. Restore both timer files and their
            # enabled/active state so renewal cannot run against a rolled-back
            # controller configuration.
            try:
                for timer_path,existed,content,mode in timer_snapshot:
                    if existed:
                        atomic_text_write(timer_path,content,mode)
                    else:
                        timer_path.unlink(missing_ok=True)
                subprocess.run(['systemctl','daemon-reload'],check=False)
                _restore_systemd_state('emby-proxy-cert-renew.timer',timer_was_enabled,timer_was_active)
            except (OSError,subprocess.SubprocessError):
                print('提醒：主控已回滚，但证书续期 timer 恢复失败，请检查 emby-proxy-cert-renew.timer。',file=sys.stderr)
            raise
    print('入口及主控证书已准备，主控 HTTPS 已启动。主控域名 %s 记录须指向本机，放行 TCP 19090。' % address_record_type(state.get('address_family','ipv4')))

def cert_renew(a):
    if os.geteuid() != 0: raise RuntimeError('证书续期需要 root 或 sudo。')
    with state_lock(str(a.state)+'.cert-issue'):
        state=json.loads(Path(a.state).read_text())
        if not state.get('certificates'): raise RuntimeError('请先配置自动证书。')
        issue_certificates(state,state['certificates'])
    print('证书续期检查完成；边缘将在独立同步任务中领取。')

class Controller:
    def __init__(self, path):
        self.path = Path(path); self.lock = threading.RLock(); self.state = {}
        self.reload()
    def reload(self):
        self.state = json.loads(self.path.read_text())
        self.state.setdefault('schema_version', 1); self.state.setdefault('address_family', 'ipv4'); self.state.setdefault('enroll_tokens', {}); self.state.setdefault('nodes', {}); self.state.setdefault('active_node', None); self.state.setdefault('active_nodes', [])
    def save(self): atomic_write(self.path, self.state)
    def enroll(self, b, secure=False):
        with self.lock, state_lock(self.path):
            self.reload()
            if self.state.get('certificates') and not secure:
                return 403, {'error':'managed_certificates_require_https_registration'}
            if b.get('entry_id') != self.state['entry_id']: return 404, {'error':'unknown_entry'}
            node, reg = str(b.get('node_id','')), str(b.get('enroll_token',''))
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}', node): return 400, {'error':'invalid_node_id'}
            pending=self.state['enroll_tokens'].get(node)
            expected=pending.get('token') if isinstance(pending,dict) else pending
            issued=pending.get('issued_at') if isinstance(pending,dict) else None
            if issued is not None and now() - int(issued) > ENROLL_TTL:
                self.state['enroll_tokens'].pop(node,None); self.save()
                return 403, {'error':'invalid_or_expired_enroll_token'}
            if not node or expected != reg: return 403, {'error':'invalid_or_expired_enroll_token'}
            detected = b.get('detected_engine', '')
            if detected and detected != self.state.get('engine','caddy'):
                return 409, {'error':'engine_conflict: 边缘已有 %s，主控要求 %s；请使用引擎一致的节点，注册码未消耗。' % (detected, self.state.get('engine','caddy'))}
            try:
                expected_family = normalize_address_family(self.state.get('address_family', 'ipv4'))
                requested_family = normalize_address_family(b.get('address_family', expected_family))
            except RuntimeError:
                return 400, {'error':'invalid_address_family'}
            if requested_family != expected_family:
                return 409, {'error':'address_family_conflict: 主控要求 %s，边缘提交的是 %s；注册码未消耗。' % (expected_family, requested_family)}
            pending_family = normalize_address_family(pending.get('address_family', expected_family)) if isinstance(pending, dict) else expected_family
            if requested_family != pending_family:
                return 409, {'error':'address_family_conflict: 注册码要求 %s，边缘提交的是 %s；注册码未消耗。' % (pending_family, requested_family)}
            try:
                priority, quota_bytes = validate_node_limits(b.get('priority', 0), b.get('quota_bytes', 0))
                public_ip = validate_node_public_ip(b.get('public_ip'), requested_family)
            except ValueError as error:
                return 400, {'error':str(error) or 'invalid_node_configuration'}
            token = secrets.token_urlsafe(32); self.state['enroll_tokens'].pop(node, None)
            name=''.join(char for char in str(b.get('name',node) or node)[:128] if ord(char) >= 32).strip() or node
            version=''.join(char for char in str(b.get('version','unknown') or 'unknown')[:128] if ord(char) >= 32) or 'unknown'
            item = {'name':name, 'priority':priority, 'quota_bytes':quota_bytes, 'used_bytes':0, 'healthy':False, 'status':'enrolled', 'last_seen':now(), 'version':version, 'token_hash':digest(token), 'address_family':requested_family}
            if public_ip: item['public_ip'] = public_ip
            self.state['nodes'][node] = item; self.save()
            return 200, {'node_token':token, 'entry_id':self.state['entry_id'], 'domain':self.state['domain'], 'source':self.state['source'], 'engine':self.state.get('engine','caddy'),'address_family':expected_family,'certificate_managed':bool(self.state.get('certificates')),
                         'telemetry_enabled':(self.state.get('telegram') or {}).get('enabled') is True}
    def heartbeat(self, b, token):
        with self.lock, state_lock(self.path):
            self.reload()
            node = self.state['nodes'].get(str(b.get('node_id','')))
            if not node or node.get('token_hash') != digest(token): return 403, {'error':'invalid_node_token'}
            try:
                node_family = normalize_address_family(node.get('address_family', self.state.get('address_family','ipv4')))
                reported_family = normalize_address_family(b.get('address_family', node_family))
            except RuntimeError:
                return 400, {'error':'invalid_address_family'}
            if reported_family != node_family: return 409, {'error':'address_family_conflict'}
            try:
                validate_node_limits(node.get('priority',0), node.get('quota_bytes',0))
                raw_used=b.get('used_bytes',0)
                if (isinstance(raw_used, bool) or (isinstance(raw_used,float) and not raw_used.is_integer())): raise ValueError
                used_value = int(raw_used)
                if not 0 <= used_value <= 2**63 - 1:
                    raise ValueError
                public_ip = validate_node_public_ip(b.get('public_ip'), node_family)
            except (TypeError, ValueError, OverflowError):
                return 400, {'error':'invalid_node_usage_or_public_ip'}
            version=str(b.get('version',node.get('version','unknown')) or 'unknown')[:128]
            event=str(b.get('event','heartbeat') or 'heartbeat')[:64]
            if any(ord(char) < 32 for char in version+event): return 400, {'error':'invalid_node_metadata'}
            used = max(int(node.get('used_bytes',0)), used_value)
            stamp=now(); reported=b.get('healthy') is True
            # 失联恢复不能继承失联前的成功计数；计数落盘，主控重启不绕过防抖。
            if stamp-int(node.get('last_seen',0)) > HEARTBEAT_TTL:
                node.update(healthy=False, success_streak=0, failure_streak=0)
                node.pop('recovery_since',None)
            if reported:
                node['failure_streak']=0
                node['success_streak']=int(node.get('success_streak',0))+1
                if not node.get('healthy'):
                    node.setdefault('recovery_since',stamp)
                    if node['success_streak'] >= RECOVERY_THRESHOLD and stamp-node['recovery_since'] >= RECOVERY_SECONDS:
                        node['healthy']=True
                node['status']='healthy' if node.get('healthy') else 'recovering'
            else:
                node['success_streak']=0; node.pop('recovery_since',None)
                node['failure_streak']=int(node.get('failure_streak',0))+1
                if node['failure_streak'] >= FAILURE_THRESHOLD: node['healthy']=False
                node['status']='suspect' if node.get('healthy') else 'unhealthy'
            node.update(reported_healthy=reported, used_bytes=used, last_seen=stamp, version=version, last_event=event)
            cert=b.get('certificate_status')
            if isinstance(cert,dict):
                node['certificate_status']={k:cert[k] for k in ('version','expires_at','status','last_sync') if k in cert}
            if public_ip:
                node['public_ip'] = public_ip
            # Consent is an explicit boolean. Legacy/string values such as
            # "false" must not silently enable collection of client data.
            telemetry_enabled=(self.state.get('telegram') or {}).get('enabled') is True
            metrics=sanitize_metrics(b.get('metrics')) if telemetry_enabled else None
            if metrics is not None: node['metrics']=metrics
            else: node.pop('metrics',None)
            selected = self.select(); self.save(); return 200, {'selected_node':selected, 'accepted_used_bytes':used,
                                                                  'telemetry_enabled':telemetry_enabled}
    def revoke(self, b, token):
        with self.lock, state_lock(self.path):
            self.reload()
            node_id = str(b.get('node_id',''))
            node = self.state['nodes'].get(node_id)
            if not node or node.get('token_hash') != digest(token): return 403, {'error':'invalid_node_token'}
            self.state['nodes'].pop(node_id, None)
            self.state['enroll_tokens'].pop(node_id, None)
            if self.state.get('active_node') == node_id: self.state['active_node'] = None
            self.state['active_nodes']=[nid for nid in self.state.get('active_nodes',[]) if nid != node_id]
            self.save()
            return 200, {'revoked_node':node_id}
    def eligible(self, nid, current=None):
        node = self.state.get('nodes', {}).get(nid)
        if not node: return False
        quota = int(node.get('quota_bytes', 0))
        online = now() - int(node.get('last_seen', 0)) <= HEARTBEAT_TTL
        within = quota <= 0 or int(node.get('used_bytes', 0)) < quota
        return bool(node.get('healthy') and online and within and
                    (nid == current or node.get('status') != 'suspect'))
    def select(self):
        out=[]; current=self.state.get('active_node')
        for nid,n in self.state['nodes'].items():
            # 容忍活动节点的短暂失败，但不把正在失败的备用节点提升为活动节点。
            if self.eligible(nid, current):
                out.append((int(n.get('priority',0)), nid))
        best=max(out, default=(0,None))
        active=next((item for item in out if item[1] == current),None)
        if active and (active[0] >= best[0] or now()-int(self.state.get('last_switch_at',0)) < SWITCH_COOLDOWN):
            return current
        return best[1]
    def cloudflare_record_ids(self):
        dns=self.state.get('dns') or {}
        ids=dns.get('record_ids') or ([dns['record_id']] if dns.get('record_id') else [])
        return [str(item) for item in ids if str(item)]
    def weighted_pool_enabled(self):
        return ((self.state.get('routing') or {}).get('mode') == 'weighted' and
                len(self.cloudflare_record_ids()) >= 2)
    def schedule_profile(self, entries, key, minute=None):
        if not entries: return None
        if minute is None:
            local=time.localtime(); minute=local.tm_hour*60+local.tm_min
        chosen=entries[-1]
        for item in entries:
            start=parse_schedule_time(item.get('start',''))
            if start <= minute: chosen=item
            else: break
        return chosen.get(key) or {}
    def effective_cloudflare_weights(self):
        routing=self.state.get('routing') or {}
        return self.schedule_profile(routing.get('schedule') or [], 'weights') or routing.get('weights') or {}
    def weighted_pool_assignments(self):
        """Expand configured weights into a deterministic DNS record pool."""
        ids=self.cloudflare_record_ids(); weights=self.effective_cloudflare_weights()
        candidates=[]
        for nid, value in weights.items():
            try: weight=int(value)
            except (TypeError,ValueError): continue
            if nid in self.state.get('nodes',{}) and weight > 0 and self.eligible(nid, self.state.get('active_node')):
                candidates.append((nid,weight))
        if not candidates: return []
        candidates.sort(key=lambda item: (-item[1], item[0]))
        slots=len(ids); total=sum(value for _,value in candidates)
        counts={nid:(value*slots)//total for nid,value in candidates}
        remainders=sorted([((value*slots)%total,nid) for nid,value in candidates], reverse=True)
        for _,nid in remainders[:slots-sum(counts.values())]: counts[nid]+=1
        expanded=[]
        for nid,_ in candidates:
            expanded.extend([nid]*counts[nid])
        expanded=expanded[:slots]
        return list(zip(ids,expanded))
    def cloudflare_pool_duplicate_error(self, assignments):
        """Return a safe error when a DNS slot would duplicate an A/AAAA value.

        Cloudflare DNS does not allow two identical records with the same
        name/type/content.  Expanding ``edge-a=80,edge-b=20`` across four
        records therefore cannot represent 80/20 by repeating edge-a/edge-b;
        a blind PUT would partially update the pool and leave it ambiguous.
        """
        seen={}
        for record_id,nid in assignments:
            ip=self.state.get('nodes',{}).get(nid,{}).get('public_ip')
            if not ip: continue
            previous=seen.get(str(ip))
            if previous and previous != str(record_id):
                return 'Cloudflare DNS 不允许同名同类型的重复 IP 记录；当前权重需要重复槽位，无法安全表示。请减少记录数量/节点，或改用 Cloudflare Load Balancing。'
            seen[str(ip)]=str(record_id)
        return None
    def reconcile_cloudflare_pool(self):
        assignments=self.weighted_pool_assignments(); previous=list(self.state.get('active_nodes') or [])
        if not assignments:
            self.state['last_reconcile']=now(); self.state['last_reconcile_reason']='no_eligible_nodes'; self.save()
            return {'selected_nodes':[], 'active_nodes':previous, 'previous_nodes':previous,
                    'changed':False, 'reason':'no_eligible_nodes'}
        desired=[nid for _,nid in assignments]
        desired_ips={rid:self.state['nodes'][nid].get('public_ip') for rid,nid in assignments}
        confirmed=self.state.get('confirmed_record_ips') or {}
        needs=desired != previous or any(confirmed.get(rid) != ip for rid,ip in desired_ips.items()) or self.state.get('dns_needs_confirmation')
        result=None; reason='unchanged'
        if needs:
            duplicate_error=self.cloudflare_pool_duplicate_error(assignments)
            result={'ok':False,'verified':False,'error':duplicate_error} if duplicate_error else self.update_dns_pool(assignments)
            if result.get('ok'):
                self.state['active_nodes']=desired; self.state['active_node']=desired[0]
                self.state['confirmed_record_ips']=desired_ips; self.state['confirmed_dns_ip']=desired_ips.get(assignments[0][0])
                self.state['dns_needs_confirmation']=False; self.state['dns_confirmed_at']=now()
                if desired != previous: self.state['last_switch_at']=now()
                reason='dns_confirmed'
            else:
                self.state['dns_needs_confirmation']=True; reason='dns_unconfirmed'
            self.state['last_dns_result']=result
        self.state['last_reconcile']=now(); self.state['last_reconcile_reason']=reason; self.save()
        return {'selected_nodes':desired, 'active_nodes':self.state.get('active_nodes',previous),
                'previous_nodes':previous, 'changed':self.state.get('active_nodes',previous) != previous,
                'reason':reason, 'dns':result}
    def reconcile(self):
        with self.lock, state_lock(self.path):
            self.reload()
            if (self.state.get('dns') or {}).get('provider') == 'dnspod':
                return self.reconcile_dnspod()
            if self.weighted_pool_enabled(): return self.reconcile_cloudflare_pool()
            selected=self.select(); previous=self.state.get('active_node'); changed=selected != previous; dns_result=None
            ip=self.state['nodes'][selected].get('public_ip') if selected else None
            needs_update=bool(selected and (changed or self.state.get('confirmed_dns_ip') != ip or self.state.get('dns_needs_confirmation')))
            reason='no_eligible_nodes' if selected is None else 'unchanged'
            if needs_update:
                dns_result=self.update_dns(selected)
                if dns_result.get('ok') is True:
                    self.state['active_node']=selected; self.state['confirmed_dns_ip']=ip
                    self.state['dns_needs_confirmation']=False
                    self.state['dns_confirmed_at']=now()
                    if changed: self.state['last_switch_at']=now()
                    reason='dns_confirmed'
                else:
                    # PUT 可能已生效，仅 GET 失败。即使下轮选回旧节点，也必须重写确认。
                    self.state['dns_needs_confirmation']=True
                    reason='dns_unconfirmed'
                self.state['last_dns_result']=dns_result
            # active_node 只代表最近一次 API 回读确认的节点，不代表递归 DNS 缓存已刷新。
            self.state['last_reconcile']=now(); self.state['last_reconcile_reason']=reason; self.save()
            return {'selected_node':selected,'active_node':self.state.get('active_node'),'previous_node':previous,'changed':self.state.get('active_node') != previous,'reason':reason,'dns':dns_result}
    def update_dns(self, nid):
        dns=self.state.get('dns') or {}; node=self.state['nodes'][nid]
        if dns.get('provider') == 'dnspod':
            return self.update_dnspod(nid)
        if self.weighted_pool_enabled():
            assignments=[(record_id,nid) for record_id in self.cloudflare_record_ids()]
            return self.update_dns_pool(assignments)
        if dns.get('provider') != 'cloudflare': return {'ok':False,'skipped':'dns provider not configured'}
        if not node.get('public_ip'): return {'ok':False,'error':'selected node has no public_ip'}
        if not all(dns.get(key) for key in ('zone_id','record_id','token_file')):
            return {'ok':False,'error':'incomplete Cloudflare configuration'}
        try: token=Path(dns['token_file']).read_text().strip()
        except (OSError, KeyError) as e: return {'ok':False,'error':str(e)}
        if not token: return {'ok':False,'error':'empty Cloudflare token file'}
        return self.update_cloudflare_record(dns['record_id'], node['public_ip'], token)

    def update_cloudflare_record(self, record_id, ip, token):
        dns=self.state.get('dns') or {}
        record_type=dns.get('record_type') or address_record_type(self.state.get('address_family','ipv4'))
        if record_type not in ('A','AAAA'): return {'ok':False,'error':'invalid DNS record type'}
        try:
            ip=str((ipaddress.IPv6Address if record_type == 'AAAA' else ipaddress.IPv4Address)(str(ip)))
        except ValueError:
            return {'ok':False,'error':'selected node IP does not match DNS record type'}
        payload={'type':record_type,'name':self.state['domain'],'content':ip,'ttl':int(dns.get('ttl',60)),'proxied':False}
        req=urllib.request.Request('https://api.cloudflare.com/client/v4/zones/%s/dns_records/%s' % (dns['zone_id'],record_id), data=json.dumps(payload).encode(), headers={'Authorization':'Bearer '+token,'Content-Type':'application/json'}, method='PUT')
        try:
            with urllib.request.build_opener(NoCredentialRedirect).open(req, timeout=5) as r: result=bounded_json_response(r)
            if not result.get('success'): return {'ok':False,'errors':result.get('errors',[])}
            readback=urllib.request.Request(req.full_url, headers={'Authorization':'Bearer '+token}, method='GET')
            with urllib.request.build_opener(NoCredentialRedirect).open(readback, timeout=5) as r: verified=bounded_json_response(r)
            record=verified.get('result') or {}
            if not (verified.get('success') and isinstance(record,dict) and str(record.get('id')) == str(record_id) and record.get('type') == record_type and
                    record.get('name','').lower().rstrip('.') == self.state['domain'].lower().rstrip('.') and
                    record.get('content') == ip and record.get('proxied') is False):
                return {'ok':False,'error':'DNS read-back mismatch; retry on next reconcile'}
            return {'ok':True,'content':ip,'record_id':record_id,'verified':True}
        except (OSError, urllib.error.URLError, ValueError): return {'ok':False,'error':'Cloudflare DNS API 请求失败或响应格式无效'}
    def update_dns_pool(self, assignments):
        dns=self.state.get('dns') or {}
        if dns.get('provider') != 'cloudflare': return {'ok':False,'error':'weighted pool requires Cloudflare'}
        if not all(dns.get(key) for key in ('zone_id','token_file')): return {'ok':False,'error':'incomplete Cloudflare configuration'}
        try: token=Path(dns['token_file']).read_text().strip()
        except OSError as e: return {'ok':False,'error':str(e)}
        if not token: return {'ok':False,'error':'empty Cloudflare token file'}
        records={}; errors={}
        for record_id,nid in assignments:
            ip=self.state['nodes'].get(nid,{}).get('public_ip')
            if not ip: errors[record_id]='selected node has no public_ip'; continue
            response=self.update_cloudflare_record(record_id,ip,token)
            if response.get('ok'): records[record_id]=dict(response,node_id=nid)
            else: errors[record_id]=response.get('error','unconfirmed')
        return {'ok':bool(records) and not errors,'verified':bool(records) and not errors,
                'records':records,'errors':errors}
    def update_dnspod(self, fallback):
        plans = self.line_plan()
        results = {}; errors = {}
        for line, plan in plans.items():
            target = plan.get('selected_node') or fallback
            if not target: errors[line] = 'no eligible node'; continue
            response = self.update_dnspod_line(line, self.state['nodes'][target].get('public_ip'))
            if response.get('ok'):
                results[line] = dict(response, node_id=target)
            else: errors[line] = response.get('error', 'unconfirmed')
        return {'ok': bool(results) and not errors, 'verified': bool(results) and not errors,
                'records': results, 'errors': errors}
    def line_plan(self):
        dns = self.state.get('dns') or {}
        routes = dns.get('routes') or {}
        scheduled=self.schedule_profile(dns.get('schedule') or [], 'routes')
        if scheduled:
            routes=dict(routes); routes.update(scheduled)
        plans = {}
        for line in DNSPOD_LINES:
            previous = (self.state.get('line_states') or {}).get(line) or {}
            current = previous.get('active_node')
            preferred = routes.get(line) or routes.get('默认')
            eligible = [nid for nid in self.state['nodes'] if self.eligible(nid, current)]
            best = max(eligible, key=lambda nid: (nid == preferred,
                int(self.state['nodes'][nid].get('priority', 0)), nid == current, nid), default=None)
            if current in eligible and now() - int(previous.get('last_switch_at', 0)) < SWITCH_COOLDOWN:
                best = current
            plans[line] = {'selected_node': best, 'preferred_node': preferred,
                           'active_node': current, 'content': self.state['nodes'][best].get('public_ip') if best else None}
        return plans

    def dnspod_line_records(self, line):
        raw=(self.state.get('dns') or {}).get('line_records',{}).get(line) or []
        return raw if isinstance(raw,list) else [raw]

    def line_pool_assignments(self, line, plan=None):
        records=self.dnspod_line_records(line)
        plan=plan or self.line_plan()[line]
        scheduled=self.schedule_profile((self.state.get('dns') or {}).get('schedule') or [], 'routes') or {}
        if line in scheduled:
            target=scheduled[line]
            if self.eligible(target,plan.get('active_node')):
                return [(item.get('record_id'),target) for item in records]
        weights=((self.state.get('dns') or {}).get('line_weights') or {}).get(line) or {}
        if not weights:
            return [(item.get('record_id'),plan.get('selected_node')) for item in records if plan.get('selected_node')]
        candidates=[]
        for nid,value in weights.items():
            try: weight=int(value)
            except (TypeError,ValueError): continue
            if nid in self.state.get('nodes',{}) and weight>0 and self.eligible(nid,plan.get('active_node')):
                candidates.append((nid,weight))
        if not candidates: return []
        candidates.sort(key=lambda item:(-item[1],item[0])); slots=len(records); total=sum(v for _,v in candidates)
        counts={nid:(v*slots)//total for nid,v in candidates}
        remainder=sorted([((v*slots)%total,nid) for nid,v in candidates],reverse=True)
        for _,nid in remainder[:slots-sum(counts.values())]: counts[nid]+=1
        if slots>=len(candidates):
            for nid,_ in candidates:
                if counts[nid]==0:
                    donor=max((item for item in candidates if counts[item[0]]>1),key=lambda item:(counts[item[0]],item[1]),default=None)
                    if donor: counts[donor[0]]-=1; counts[nid]=1
        expanded=[]
        for nid,_ in candidates: expanded.extend([nid]*counts[nid])
        return [(item.get('record_id'),nid) for item,nid in zip(records,expanded[:slots])]

    def dnspod_record(self, line, token):
        dns = self.state['dns']; managed = self.dnspod_line_records(line)[0]
        record_type = dns.get('record_type') or address_record_type(self.state.get('address_family','ipv4'))
        result = dnspod_call('Record.Info', {'domain_id': dns['domain_id'], 'record_id': managed['record_id']}, token)
        r = result.get('record') or {}; domain = result.get('domain') or {}
        if not (str(domain.get('id')) == str(dns['domain_id']) and
                str(r.get('id')) == str(managed['record_id']) and r.get('sub_domain') == dns['sub_domain'] and
                r.get('record_type') == record_type and r.get('record_line') == line and
                str(r.get('record_line_id')) == str(managed['record_line_id']) and str(r.get('enabled')) == '1' and
                not r.get('monitor_status')):
            raise RuntimeError('DNSPod 记录身份/类型/线路/状态已变化；拒绝覆盖，请重新检查接管范围。')
        return r

    def dnspod_records(self, line, token):
        records=[]; dns=self.state['dns']; record_type = dns.get('record_type') or address_record_type(self.state.get('address_family','ipv4'))
        for managed in self.dnspod_line_records(line):
            result=dnspod_call('Record.Info', {'domain_id':dns['domain_id'],'record_id':managed['record_id']}, token)
            r=result.get('record') or {}; domain=result.get('domain') or {}
            if not (str(domain.get('id'))==str(dns['domain_id']) and str(r.get('id'))==str(managed['record_id']) and
                    r.get('sub_domain')==dns['sub_domain'] and r.get('record_type')==record_type and
                    r.get('record_line')==line and str(r.get('record_line_id'))==str(managed['record_line_id']) and
                    str(r.get('enabled'))=='1' and not r.get('monitor_status')):
                raise RuntimeError('DNSPod 记录身份/类型/线路/状态已变化；拒绝覆盖，请重新检查接管范围。')
            records.append(r)
        return records

    def update_dnspod_line(self, line, ip):
        dns = self.state['dns']; managed = dns['line_records'][line]
        if len(self.dnspod_line_records(line)) > 1:
            plan=self.line_plan()[line]; assignments=self.line_pool_assignments(line,plan)
            return self.update_dnspod_pool(line,assignments)
        try:
            family = self.state.get('address_family','ipv4')
            ip = str((ipaddress.IPv6Address if family == 'ipv6' else ipaddress.IPv4Address)(ip))
            token = Path(dns['token_file']).read_text().strip()
            original = self.dnspod_record(line, token)
            # DNSPod locks repeatedly submitted no-op writes; read first, even after
            # timeout/partial failure. Preserve user TTL instead of resetting it.
            if original.get('value') == ip:
                return {'ok': True, 'verified': True, 'content': ip, 'unchanged': True}
            snapshots = self.state.setdefault('dnspod_record_backups', [])
            snapshots.append({'at': now(), 'line': line, 'record': original})
            self.state['dnspod_record_backups'] = snapshots[-40:]
            self.save()  # backup and retry flag must survive a process crash after PUT
            params = {'domain_id': dns['domain_id'], 'record_id': managed['record_id'],
                      'sub_domain': dns['sub_domain'], 'record_type': dns.get('record_type') or address_record_type(family),
                      'record_line_id': managed['record_line_id'], 'value': ip,
                      'ttl': int(original['ttl'])}
            if original.get('weight') not in (None, ''): params['weight'] = str(original['weight'])
            dnspod_call('Record.Modify', params, token)
            if self.dnspod_record(line, token).get('value') != ip:
                raise RuntimeError('DNSPod 回读 IP 不匹配，下轮重新读取后重试。')
            return {'ok': True, 'verified': True, 'content': ip}
        except (OSError, RuntimeError, ValueError, KeyError, TypeError):
            return {'ok': False, 'error': 'DNSPod 线路未确认；检查凭据、记录身份、TTL/套餐及网络。'}

    def update_dnspod_pool(self, line, assignments):
        dns=self.state['dns']; record_type = dns.get('record_type') or address_record_type(self.state.get('address_family','ipv4'))
        if not assignments: return {'ok':False,'error':'no eligible node'}
        try:
            token=Path(dns['token_file']).read_text().strip()
            records={str(r['id']):r for r in self.dnspod_records(line,token)}; results={}; errors={}
            for record_id,nid in assignments:
                original=records.get(str(record_id)); ip=self.state['nodes'].get(nid,{}).get('public_ip')
                if not original or not ip: errors[str(record_id)]='record or node IP unavailable'; continue
                try: ip=str((ipaddress.IPv6Address if record_type == 'AAAA' else ipaddress.IPv4Address)(str(ip)))
                except ValueError: errors[str(record_id)]='selected node IP does not match DNS record type'; continue
                if original.get('value') == ip:
                    results[str(record_id)]={'ok':True,'unchanged':True,'content':ip,'node_id':nid}; continue
                params={'domain_id':dns['domain_id'],'record_id':str(record_id),'sub_domain':dns['sub_domain'],
                        'record_type':record_type,'record_line_id':original['record_line_id'],'value':ip,'ttl':int(original['ttl'])}
                if original.get('weight') not in (None, ''): params['weight'] = str(original['weight'])
                dnspod_call('Record.Modify',params,token)
                verified=self.dnspod_records(line,token)
                check=next((item for item in verified if str(item.get('id'))==str(record_id)),{})
                if check.get('value') != ip: errors[str(record_id)]='DNSPod 回读 IP 不匹配'
                else: results[str(record_id)]={'ok':True,'content':ip,'node_id':nid,'verified':True}
            return {'ok':bool(results) and not errors,'verified':bool(results) and not errors,'records':results,'errors':errors}
        except (OSError,RuntimeError,ValueError,KeyError,TypeError):
            return {'ok':False,'error':'DNSPod 多记录未确认；检查凭据、记录身份、TTL/套餐及网络。'}

    def reconcile_dnspod(self):
        plans = self.line_plan()
        states = self.state.setdefault('line_states', {})
        results = {}
        previous = self.state.get('active_node')
        for line, plan in plans.items():
            item = states.setdefault(line, {})
            nid = plan['selected_node']; ip = plan['content']
            if not nid:
                item['reason'] = 'no_eligible_nodes'; item['needs_confirmation'] = True
                results[line] = dict(plan, reason=item['reason'])
                continue
            if len(self.dnspod_line_records(line)) > 1:
                assignments=self.line_pool_assignments(line,plan)
                desired=[node for _,node in assignments]
                previous_pool=item.get('active_nodes') or []
                confirmed_pool=item.get('confirmed_record_ips') or {}
                desired_ips={record_id:self.state['nodes'][node].get('public_ip') for record_id,node in assignments}
                check=(desired != previous_pool or any(confirmed_pool.get(record_id) != value for record_id,value in desired_ips.items()) or
                       item.get('needs_confirmation') or self.state.get('dns_needs_confirmation'))
                if check:
                    item['needs_confirmation']=True; self.save()
                    response=self.update_dnspod_pool(line,assignments); item['last_result']=response
                    if response.get('ok') is True:
                        if desired != previous_pool: item['last_switch_at']=now()
                        item.update(active_nodes=desired, active_node=desired[0] if desired else None,
                                    confirmed_record_ips=desired_ips, confirmed_ip=desired_ips.get(assignments[0][0]) if assignments else None,
                                    confirmed_at=now(), needs_confirmation=False, reason='dns_confirmed')
                    else: item['reason']='dns_unconfirmed'
                else: item['reason']='unchanged'
                results[line]=dict(plan, selected_nodes=desired, active_nodes=item.get('active_nodes',previous_pool),
                                   active_node=item.get('active_node'), reason=item['reason'])
                self.save()
                continue
            changed = nid != item.get('active_node')
            check = (changed or ip != item.get('confirmed_ip') or item.get('needs_confirmation') or
                     self.state.get('dns_needs_confirmation') or now() - int(item.get('confirmed_at', 0)) >= 300)
            if check:
                item['needs_confirmation'] = True
                self.save()
                response = self.update_dnspod_line(line, ip)
                item['last_result'] = response
                if response.get('ok') is True:
                    if changed: item['last_switch_at'] = now()
                    item.update(active_node=nid, confirmed_ip=ip, confirmed_at=now(),
                                needs_confirmation=False, reason='dns_confirmed')
                else: item['reason'] = 'dns_unconfirmed'
            else: item['reason'] = 'unchanged'
            results[line] = dict(plan, active_node=item.get('active_node'), reason=item['reason'])
            self.save()  # partial success is explicit; only failed lines retry
        # Keep the global retry flag set while any line is unconfirmed or has
        # no eligible node. Clearing it after a partial success made the menu
        # claim DNS was fully synchronized and could delay a failed line's
        # retry until a later unrelated change.
        self.state['dns_needs_confirmation'] = any(
            bool(item.get('needs_confirmation')) or item.get('reason') in ('dns_unconfirmed', 'no_eligible_nodes')
            for item in states.values())
        default = states.get('默认') or {}
        self.state['active_node'] = default.get('active_node')
        self.state['confirmed_dns_ip'] = default.get('confirmed_ip')
        self.state['dns_confirmed_at'] = default.get('confirmed_at', 0)
        failed = any(v.get('reason') == 'dns_unconfirmed' for v in results.values())
        empty = any(v.get('reason') == 'no_eligible_nodes' for v in results.values())
        reason = 'dns_unconfirmed' if failed else 'no_eligible_nodes' if empty else 'dns_confirmed'
        self.state['last_reconcile'] = now(); self.state['last_reconcile_reason'] = reason
        self.save()
        return {'active_node': self.state['active_node'], 'previous_node': previous,
                'selected_node': plans['默认']['selected_node'], 'lines': results,
                'changed': self.state['active_node'] != previous, 'reason': reason}
    def public_status(self):
        with self.lock, state_lock(self.path):
            self.reload()
            return {'entry_id':self.state.get('entry_id'), 'domain':self.state.get('domain')}
    def certificate(self, b, token, secure=False):
        with self.lock, state_lock(self.path):
            self.reload()
            node=self.state['nodes'].get(str(b.get('node_id','')))
            if not secure or not node or not secrets.compare_digest(node.get('token_hash',''),digest(token)) or b.get('entry_id') != self.state['entry_id']:
                return 403, {'error':'certificate_requires_tls_and_node_auth'}
            config=self.state.get('certificates')
            if not config: return 409, {'error':'managed_certificates_not_enabled'}
            try:
                # Resolve once so a concurrent renewal cannot mix the certificate and key.
                pair=(Path(config['directory'])/'entry'/'current').resolve(strict=True)
                cert=(pair/'fullchain.pem').read_text(); key=(pair/'privkey.pem').read_text()
                return 200, {'domain':self.state['domain'],'certificate':cert,'private_key':key,
                    'version':hashlib.sha256(cert.encode()).hexdigest()}
            except OSError:
                return 503, {'error':'certificate_not_ready'}
    def private_status(self):
        with self.lock, state_lock(self.path):
            self.reload(); result=copy.deepcopy(self.state); result['selected_node']=self.select()
            if self.weighted_pool_enabled():
                result['selected_nodes']=[nid for _,nid in self.weighted_pool_assignments()]
            if (self.state.get('dns') or {}).get('provider') == 'dnspod':
                result['selected_lines']=self.line_plan()
        result.pop('enroll_tokens',None)
        for n in result.get('nodes',{}).values(): n.pop('token_hash',None)
        if result.get('certificates'):
            result['certificate_status']={}
            for name in ('entry','control'):
                try:
                    status=json.loads((Path(result['certificates']['directory'])/name/'status.json').read_text())
                except (OSError,ValueError): status={'status':'not_ready'}
                result['certificate_status'][name]=status
        return result

TELEGRAM_API='https://api.telegram.org/bot'
TELEGRAM_MESSAGE_LIMIT=3900
TELEGRAM_ALERT_MAX=100
TELEGRAM_ALERT_MAX_AGE=7*86400
TELEGRAM_ALERT_BATCH=8
TELEGRAM_ALERT_SEND_BUDGET=20

def telegram_alert_generation(config, token=None):
    """Return a non-secret identity for the currently published Bot config.

    ``configuration_id`` is written by telegram_configure.  Older state files
    do not have it, so the token fingerprint is used as a compatibility
    generation without ever persisting the token itself.
    """
    value=str((config or {}).get('configuration_id') or '')
    if value: return value[:128]
    if token:
        return 'token:'+telegram_token_fingerprint(token)
    return 'legacy'

def telegram_normalize_alert(raw, index=0, generation='legacy'):
    """Validate/normalize one durable outbox row, or return ``None``."""
    if not isinstance(raw,dict): return None
    message=raw.get('message')
    if not isinstance(message,str): message=str(message or '')
    message=message.strip()
    if not message or len(message) > 12000: return None
    try: created=int(raw.get('created_at') or 0)
    except (TypeError,ValueError): created=0
    if created < 0: created=0
    event_id=str(raw.get('id') or '')
    if not re.fullmatch(r'[A-Za-z0-9._:-]{1,128}',event_id):
        event_id=hashlib.sha256((message+'|'+str(created)+'|'+str(index)).encode()).hexdigest()[:32]
    row={'id':event_id,'message':message,'created_at':created,
         'generation':str(raw.get('generation') or generation)[:128],
         'delivered_chat_ids':[]}
    delivered=raw.get('delivered_chat_ids')
    if isinstance(delivered,(list,tuple,set)):
        row['delivered_chat_ids']=sorted({str(item) for item in delivered if re.fullmatch(r'-?[0-9]{3,30}',str(item))})
    try: attempts=max(0,min(int(raw.get('attempts') or 0),16))
    except (TypeError,ValueError): attempts=0
    if attempts: row['attempts']=attempts
    try: next_at=int(raw.get('next_attempt_at') or 0)
    except (TypeError,ValueError): next_at=0
    if next_at > 0: row['next_attempt_at']=next_at
    return row

class TelegramAPIError(RuntimeError):
    """A sanitized Bot API error with bounded retry information."""
    def __init__(self, message, status=0, retry_after=0):
        super().__init__(message)
        self.status=int(status or 0)
        self.retry_after=max(0,min(int(retry_after or 0),3600))

def telegram_token(config):
    path=Path(str((config or {}).get('token_file','')))
    try:
        stat=path.stat()
        if path.is_symlink() or not path.is_file():
            raise RuntimeError('Telegram Bot Token 文件必须是普通文件。')
        if stat.st_mode & 0o077:
            raise RuntimeError('Telegram Bot Token 文件权限过宽；应为 600。')
        if stat.st_uid not in (0,getattr(os,'geteuid',lambda:0)()):
            raise RuntimeError('Telegram Bot Token 文件所有者无效。')
        token=path.read_text().strip()
    except RuntimeError:
        raise
    except OSError:
        raise RuntimeError('Telegram Bot Token 文件不可读。') from None
    if not re.fullmatch(r'\d{6,20}:[A-Za-z0-9_-]{20,200}',token):
        raise RuntimeError('Telegram Bot Token 文件格式无效。')
    return token

def telegram_api(token, method, payload=None, timeout=25):
    data=urlencode({key:(json.dumps(value,separators=(',',':')) if isinstance(value,(list,dict)) else str(value))
                    for key,value in (payload or {}).items()}).encode()
    request=urllib.request.Request(TELEGRAM_API+token+'/'+method, data=data,
                                   headers={'Content-Type':'application/x-www-form-urlencoded'}, method='POST')
    try:
        # Never follow a redirect from the bot API URL: the token is part of
        # that URL and must not be forwarded to an untrusted location.
        with urllib.request.build_opener(NoCredentialRedirect).open(request, timeout=timeout) as response:
            raw=response.read(1048577)
            if len(raw) > 1048576: raise RuntimeError('Telegram API 响应过大。')
            result=json.loads(raw)
    except RuntimeError:
        raise
    except urllib.error.HTTPError as error:
        status=int(getattr(error,'code',0) or 0)
        retry=0; result=None
        try:
            raw=error.read(1048577)
            if len(raw) <= 1048576:
                result=json.loads(raw)
        except (OSError,ValueError,TypeError):
            result=None
        finally:
            try: error.close()
            except OSError: pass
        if isinstance(result,dict):
            params=result.get('parameters')
            candidate=params.get('retry_after') if isinstance(params,dict) else 0
            try: retry=int(candidate)
            except (TypeError,ValueError): retry=0
            if result.get('error_code') == 429: status=429
        if status == 429:
            raise TelegramAPIError('Telegram API 限流；稍后重试。',status,retry) from None
        raise TelegramAPIError('Telegram API 请求失败。',status) from None
    except (OSError,ValueError,urllib.error.URLError):
        # Avoid reflecting remote exception text (which may contain the bot
        # URL/token or attacker-controlled response data).
        raise TelegramAPIError('Telegram API 请求失败；稍后重试。') from None
    if not isinstance(result,dict) or result.get('ok') is not True:
        code=result.get('error_code') if isinstance(result,dict) else None
        code=str(code) if isinstance(code,int) else 'unknown'
        params=result.get('parameters') if isinstance(result,dict) else None
        retry=params.get('retry_after') if isinstance(params,dict) else 0
        try: retry=int(retry)
        except (TypeError,ValueError): retry=0
        if 0 < retry <= 3600:
            raise TelegramAPIError('Telegram API 限流；稍后重试。',code,retry)
        raise TelegramAPIError('Telegram API 返回失败。',code)
    return result.get('result')

def telegram_token_fingerprint(token):
    return hashlib.sha256(str(token).encode()).hexdigest()[:24]

TELEGRAM_CURSOR_MAX=(1 << 63)-1

def telegram_read_offset(path, token):
    """Read an update cursor only when it belongs to this Bot Token."""
    try: item=json.loads(Path(path).read_text())
    except (OSError,ValueError,TypeError): return 0
    if not isinstance(item,dict) or item.get('token_fingerprint') != telegram_token_fingerprint(token): return 0
    value=item.get('offset',0)
    # Telegram update IDs are JSON integers.  Do not coerce booleans,
    # floats, strings or unbounded values into a cursor: doing so can skip an
    # entire Bot queue after a corrupted/hand-edited state file.
    if isinstance(value,bool) or not isinstance(value,int) or not 0 <= value <= TELEGRAM_CURSOR_MAX:
        return 0
    return value

def telegram_write_offset(path, token, offset):
    path=Path(path); path.parent.mkdir(parents=True,exist_ok=True)
    fd,temp_name=tempfile.mkstemp(prefix='.'+path.name+'.',dir=str(path.parent))
    temp=Path(temp_name)
    try:
        os.fchmod(fd,0o600)
        with os.fdopen(fd,'w') as stream:
            json.dump({'version':1,'token_fingerprint':telegram_token_fingerprint(token),
                       'offset':min(TELEGRAM_CURSOR_MAX,max(0,int(offset)) )},stream,separators=(',',':')); stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
        temp.replace(path)
    finally:
        if temp.exists(): temp.unlink()

def telegram_read_state(path):
    return json.loads(Path(path).read_text())

def _metric_counter(value):
    """Render a bounded counter without trusting hand-edited state."""
    try:
        if isinstance(value,bool): raise ValueError
        return max(0,min(int(value or 0),10**18))
    except (TypeError,ValueError,OverflowError):
        return 0

def _fmt_bytes(value):
    value=_metric_counter(value); units=('B','KiB','MiB','GiB','TiB'); size=float(value); index=0
    while size >= 1024 and index < len(units)-1: size/=1024; index+=1
    return ('%.1f %s' % (size,units[index])) if index else ('%d B' % value)

def _fmt_node_state(node):
    quota=_metric_counter(node.get('quota_bytes')); used=_metric_counter(node.get('used_bytes'))
    if quota > 0 and used >= quota: return '配额已用完'
    last_seen=_metric_counter(node.get('last_seen'))
    if int(time.time())-last_seen > HEARTBEAT_TTL: return '心跳过期'
    if node.get('healthy') is not True: return str(node.get('status') or '不健康')
    return '正常'

def telegram_load_sites(controller_path):
    root=Path(controller_path).parent/'sites.d'; rows=[]
    for file in sorted(root.glob('domain-*.json')) if root.is_dir() else []:
        try: item=json.loads(file.read_text())
        except (OSError,ValueError): continue
        rows.append(item)
    return rows

def telegram_render(state, command, controller_path):
    nodes=state.get('nodes') or {}; command=command.lower().split('@',1)[0]
    lines=[]
    if command in ('/help','/start'):
        return ('可用命令：\n/status  主控、DNS 和当前节点\n/nodes   节点健康、地址、配额、累计流量\n'
                '/traffic 最近 5 分钟流量摘要\n/access  最近 5 分钟访问 IP 和路径\n/devices 最近 5 分钟设备类型\n'
                '/origins 源站和本机代理入口\n/refresh 读取最新已上报状态\n仅允许配置的 Telegram Chat ID 使用。')
    if command in ('/status','/refresh'):
        lines=['入口：%s' % (state.get('domain') or '-'),'地址类型：%s' % (state.get('address_family') or 'ipv4'),
               '固定源站：%s' % (state.get('source') or '-'),'DNS：%s' % ((state.get('dns') or {}).get('provider') or '未配置'),
               '当前节点：%s' % (state.get('active_node') or '尚未切换'),'节点数：%d' % len(nodes)]
        if state.get('last_reconcile_reason'): lines.append('最近同步：%s' % state['last_reconcile_reason'])
        for node_id,node in sorted(nodes.items()): lines.append('%s [%s]：%s' % (node.get('name') or node_id,node_id,_fmt_node_state(node)))
        return '\n'.join(lines)
    if command == '/nodes':
        lines=['节点状态：']
        for node_id,node in sorted(nodes.items(), key=lambda item:(-_metric_counter(item[1].get('priority')),item[0])):
            quota='不限额' if not _metric_counter(node.get('quota_bytes')) else _fmt_bytes(node.get('quota_bytes'))
            lines.append('%s [%s] · %s · %s · IP %s' % (node.get('name') or node_id,node_id,_fmt_node_state(node),node.get('address_family','ipv4'),node.get('public_ip','-')))
            last_seen=_metric_counter(node.get('last_seen'))
            lines.append('  流量 %s / %s · 最近心跳 %s' % (_fmt_bytes(node.get('used_bytes')),quota,time.strftime('%Y-%m-%d %H:%M:%S',time.localtime(last_seen)) if last_seen else '-'))
        return '\n'.join(lines) if len(lines)>1 else '暂无已注册节点。'
    if command == '/traffic':
        lines=['流量摘要（各边缘最近 5 分钟 + 累计用量；过期摘要不计入最近窗口）：']
        total=0; recent=0
        for node_id,node in sorted(nodes.items()):
            metric=node.get('metrics') or {}; fresh=_metric_is_fresh(metric); value=_metric_counter(metric.get('bytes')) if fresh else 0; total+=_metric_counter(node.get('used_bytes')); recent+=value
            lines.append('%s：最近 %s · 请求 %s · 累计 %s · %s' % (node.get('name') or node_id,_fmt_bytes(value),_metric_counter(metric.get('requests')) if fresh else '-',_fmt_bytes(node.get('used_bytes')),_metric_freshness(metric)))
            if fresh:
                for row in (metric.get('paths') or [])[:5]:
                    lines.append('  路径 %s：%s · %s 请求' % (row.get('name','/'),_fmt_bytes(row.get('bytes')),_metric_counter(row.get('requests'))))
        lines.append('合计累计：%s；最近窗口：%s' % (_fmt_bytes(total),_fmt_bytes(recent)))
        return '\n'.join(lines)
    if command in ('/access','/devices'):
        bucket='clients' if command == '/access' else 'devices'; title='访问 IP' if bucket == 'clients' else '设备类型'; lines=['最近 5 分钟%s：' % title]
        for node_id,node in sorted(nodes.items()):
            metric=node.get('metrics') or {}
            if not _metric_is_fresh(metric): continue
            rows=metric.get(bucket) or []
            if not rows: continue
            lines.append('%s（%s）：' % (node.get('name') or node_id,_metric_freshness(metric)))
            for row in rows[:10]: lines.append('  %s · %s 请求 · %s' % (row.get('name','-'),_metric_counter(row.get('requests')),_fmt_bytes(row.get('bytes'))))
        return '\n'.join(lines) if len(lines)>1 else '最近窗口暂无访问摘要（等待边缘心跳上报）。'
    if command == '/origins':
