def node_cert_sync(a):
    st=json.loads(Path(a.state).read_text())
    if not st.get('certificate_directory'): raise RuntimeError('本节点尚未启用集中证书，请重新注册接入。')
    try: version=install_certificate(st,secure_certificate_request(st))
    except Exception:
        path=Path(st['certificate_directory'])/'status.json'
        try: status=json.loads(path.read_text())
        except (OSError,ValueError): status={}
        status.update(status='sync_failed',last_attempt=now()); atomic_write(path,status)
        raise
