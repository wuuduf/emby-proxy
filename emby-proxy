    ui_header "Telegram 通知与查询" "只允许白名单 Chat ID；控制器主动轮询 Telegram，不开放入站端口"
    enabled="$(jq -r '.telegram.enabled // false' "$state" 2>/dev/null || printf false)"
    printf '当前状态：%s\n' "$([[ "$enabled" == true ]] && printf '已启用' || printf '未启用')"
    [[ "$enabled" == true ]] && jq -r '"允许 Chat ID：" + ((.telegram.chat_ids // []) | join(", "))' "$state"
    ui_item 1 "配置/更新 Bot" "输入 Token、允许的 Chat ID，并发送测试消息"
    ui_item 2 "发送测试消息" "验证 Token、网络和 Chat 权限"
    ui_item 3 "安装/重启 Bot 服务" "systemd 后台轮询，节点状态变化时通知"
    ui_item 4 "查看服务日志" "最近 80 行"
    ui_item 5 "停用 Bot" "停止轮询，不删除 Token 备份"
    ui_item 0 "返回上一级" "q 也可返回"
    ui_prompt; IFS= read -r choice || return 0
    case "$choice" in
      1)
        printf 'Telegram Bot Token（输入隐藏，q 取消）：'; IFS= read -r -s token || return 0; printf '\n'
        [[ "$token" =~ ^[qQ]$ ]] && continue
        [[ "$token" =~ ^[0-9]{6,20}:[A-Za-z0-9_-]{20,200}$ ]] || { unset token; warn "Token 格式无效。"; continue; }
        ui_read_field chat_ids "允许的 Chat ID（数字，多个用逗号分隔）" "$(jq -r '(.telegram.chat_ids // []) | join(",")' "$state")" || continue
        [[ "$chat_ids" =~ ^-?[0-9]{3,30}(,-?[0-9]{3,30})*$ ]] || { unset token; warn "Chat ID 必须是数字，可用逗号分隔多个。"; continue; }
        temp="$(mktemp "$(dirname "$state")/.telegram-token.XXXXXX")" || continue; chmod 600 "$temp"; printf '%s\n' "$token" >"$temp"; unset token
        if controller_cli telegram-config --state "$state" --token-file "$temp" --chat-ids "$chat_ids" --test; then
          rm -f "$temp"
          ui_read_field answer "现在安装并启动 Telegram 服务？y/n" y ui_valid_yes_no || continue
          [[ "$answer" =~ ^[Yy]$ ]] && menu_run controller_telegram_install || true
        else
          rm -f "$temp"
        fi
        ;;
      2) menu_run controller_cli telegram-test --state "$state" ;;
      3) menu_run controller_telegram_install ;;
      4) systemctl --no-pager -n 80 status "$unit_name" || true ;;
      5)
        controller_cli telegram-disable --state "$state" || continue
        systemctl disable --now "$unit_name" >/dev/null 2>&1 || true
        ok "Telegram Bot 已停用。"
        ;;
      0|q|Q) return ;;
      *) warn "请输入有效序号。" ;;
    esac
  done
}

controller_lines_menu() {
  local state provider line node answer entries count row choice default id current
  local -a routes=()
  state="$(controller_require_state)" || return 1
  provider="$(jq -r '.dns.provider // empty' "$state")"
  [[ "$provider" == dnspod ]] || { warn "请先接入 DNSPod。"; return 1; }
  entries="$(jq -c '(.nodes // {}) | to_entries | sort_by(.key)' "$state")"
  count="$(jq length <<<"$entries")"
  (( count > 0 )) || { warn "还没有边缘节点，请返回控制器选 3 添加节点。"; return 1; }
  ui_section "DNSPod 运营商线路"
  printf '选择节点序号即可。0=自动按优先级；指定节点故障/超额时回退到健康节点。\n'
  jq -r 'to_entries[] | "  \(.key+1)) \(.value.value.name // .value.key) [\(.value.key)]"' <<<"$entries"
  printf '  0) 自动选择（未匹配的运营商走“默认”线路）\n'
  for line in 默认 电信 联通 移动; do
    current="$(jq -r --arg line "$line" '.dns.routes[$line] // empty' "$state")"
    default="$(jq -r --arg id "$current" '([to_entries[] | select(.value.key==$id) | (.key+1)] | first) // 0' <<<"$entries")"
    while true; do
      ui_read_field choice "$line 节点序号" "$default" || return 0
      [[ "$choice" =~ ^[0-9]{1,5}$ ]] && (( 10#$choice <= count )) || { warn "请输入 0–${count}，q 取消。"; continue; }
      if (( 10#$choice > 0 )); then
        id="$(jq -r --argjson i "$((10#$choice - 1))" '.[$i].key' <<<"$entries")"
        routes+=(--route "$line=$id")
      fi
      break
    done
  done
  printf '\n即将保存（留自动的运营商沿用默认节点偏好，再按健康/配额/优先级回退）：\n'
  printf '  %s\n' "${routes[@]}"
  ui_read_field answer "确认保存并由主控自动同步？y/n" n ui_valid_yes_no || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || return 0
  controller_cli set-lines --state "$state" "${routes[@]}" || return 1
  info "线路配置已保存；主控下一轮自动同步，也可选择立即同步。"
}

