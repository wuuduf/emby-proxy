        # rows that were intentionally cleared while network I/O was running.
        config['pending_alerts']=merged[-TELEGRAM_ALERT_MAX:] if latest_enabled else []
        state['telegram']=config; atomic_write(path,state)

def telegram_configure(a):
    path=Path(a.state); token=Path(a.token_file).read_text().strip()
    if not re.fullmatch(r'\d{6,20}:[A-Za-z0-9_-]{20,200}',token): raise RuntimeError('Telegram Bot Token 格式无效。')
    chat_ids=[]
    for raw in str(a.chat_ids).split(','):
        raw=raw.strip()
        if not re.fullmatch(r'-?[0-9]{3,30}',raw): raise RuntimeError('Chat ID 必须是数字，可用逗号分隔多个。')
        if raw not in chat_ids: chat_ids.append(raw)
    # Validate the bot and optional test message before publishing either the
    # token file or the state. A failed network/Chat-ID check must leave the
    # previous Bot fully usable instead of half-updating the configuration.
    telegram_api(token,'getMe',{},timeout=15)
    if getattr(a,'test',False):
        for chat_id in chat_ids: telegram_send(token,chat_id,'emby-proxy Telegram 通知已配置成功。发送 /help 查看命令。')
    target=Path(a.persist_token or path.with_name('telegram.token')); target.parent.mkdir(parents=True,exist_ok=True)
    old_token=None; old_mode=None; had_token=target.is_file()
    if had_token:
        old_token=target.read_bytes(); old_mode=target.stat().st_mode & 0o777
    fd,temp_name=tempfile.mkstemp(prefix='.'+target.name+'.',dir=str(target.parent)); temp=Path(temp_name)
    try:
        os.fchmod(fd,0o600)
        with os.fdopen(fd,'w') as stream:
            stream.write(token); stream.flush(); os.fsync(stream.fileno())
        temp.replace(target)
        with state_lock(path):
            state=json.loads(path.read_text()); backup_file(path)
            # A new bot/chat generation must never receive events or a
            # baseline collected under the previous allowlist. This is both
            # a privacy boundary and a deterministic alert baseline.
            state['telegram']={'enabled':True,'token_file':str(target),'chat_ids':chat_ids,
                               'poll_interval':30,'configuration_id':secrets.token_urlsafe(18),
                               'alert_state':{},'pending_alerts':[]}
            atomic_write(path,state)
    except Exception:
        # Restore a custom/previous token if state publication failed. The
        # incoming temporary file is always removed and never left readable.
        try:
            if had_token:
                restore=target.with_name('.'+target.name+'.restore')
                rfd,rname=tempfile.mkstemp(prefix=restore.name+'.',dir=str(target.parent))
                os.fchmod(rfd,int(old_mode or 0o600))
                with os.fdopen(rfd,'wb') as stream: stream.write(old_token or b''); stream.flush(); os.fsync(stream.fileno())
                Path(rname).replace(target)
            else: target.unlink(missing_ok=True)
        except OSError: pass
        raise
    finally:
        if temp.exists(): temp.unlink()
    print('Telegram Bot 已配置：%d 个 Chat ID；Token 仅保存在 %s' % (len(chat_ids),target))

