  ui_section "Cloudflare 多节点权重"
  record_type="$(jq -r '.dns.record_type // (if .address_family == "ipv6" then "AAAA" else "A" end)' "$state")"
  printf '同名 %s 记录会按权重复制到记录池；这是 DNS 近似分配，受 TTL 和客户端缓存影响。\n' "$record_type"
  printf '当前记录池：%s 条\n' "$(jq -r '(.dns.record_ids // ([.dns.record_id] | map(select(. != null)))) | length' "$state")"
  ui_read_field answer "重新从 Cloudflare 发现同名 ${record_type} 记录？y/n" y ui_valid_yes_no || return 0
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    token_file="$(jq -r '.dns.token_file // empty' "$state")"
    [[ -s "$token_file" ]] || { warn "Cloudflare Token 文件不可用。"; return 1; }
    discovered="$(controller_cf_discover_ids "$token_file" "$(jq -r '.domain' "$state")" "$record_type")" || return 1
    IFS=$'\t' read -r zone_id first ids <<<"$discovered"
    controller_cli set-records --state "$state" --record-ids "$ids" || return 1
  fi
  (( $(jq -r '(.dns.record_ids // ([.dns.record_id] | map(select(. != null)))) | length' "$state") >= 2 )) || {
    warn "至少需要两条同名 Cloudflare ${record_type} 记录；请先在 DNS 控制台创建后重新发现。"; return 1;
  }
  printf '\n已注册节点：\n'
  jq -r '(.nodes // {}) | to_entries[] | "  " + .key + " · " + (.value.name // .key) + " · 优先级 " + ((.value.priority // 0)|tostring)' "$state"
