controller_dnspod_setup_menu() {
  local state domain current token candidate answer
  state="$(controller_require_state)" || return 1
  domain="$(jq -r .domain "$state")"
  ui_section "DNSPod 接入 · 不清空节点"
  printf '入口：%s\n' "$domain"
  printf '地址类型：%s（DNSPod 将只接管对应的 %s 记录）\n' "$(jq -r '.address_family // "ipv4"' "$state")" "$(jq -r 'if (.address_family // "ipv4") == "ipv6" then "AAAA" else "A" end' "$state")"
  printf '先在 DNSPod 添加/验证此子域名，再在父域设置控制台给出的 NS。\n'
  printf 'DNSPod 为同一主机建立 默认/电信/联通/移动 各一条或多条启用的 %s 记录；同一线路多条记录可在菜单 5 配置权重。\n' "$(jq -r 'if (.address_family // "ipv4") == "ipv6" then "AAAA" else "A" end' "$state")"
  printf '脚本只接管这四条线路；不会修改父域 NS，也不会删除其他网站记录。\n'
  printf '首版使用 DNSPod ID,Token（不是腾讯云 SecretId/SecretKey），仅留主控。\n'
  current="$(jq -r 'if .dns.provider == "dnspod" then .dns.token_file else empty end' "$state")"
  if [[ -n "$current" && -s "$current" ]]; then
    ui_read_field answer "沿用已有 DNSPod Token？y/n" y ui_valid_yes_no || return 0
  else
    answer=n
  fi
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    candidate="$current"
  else
    printf 'DNSPod ID,Token（输入隐藏，q 取消）：'
    IFS= read -r -s token || return 0; printf '\n'
    [[ ! "$token" =~ ^[qQ]$ ]] || return 0
    [[ "$token" =~ ^[0-9]+,[A-Za-z0-9_-]+$ ]] || { warn "格式错误，应为 ID,Token。"; return 1; }
    candidate="$(mktemp "$(dirname "$state")/.dnspod-input.XXXXXX")" || return 1
    chmod 600 "$candidate"
    printf '%s\n' "$token" >"$candidate"; unset token
  fi
  if ! controller_cli dnspod-configure --state "$state" --token-file "$candidate"; then
    [[ "$candidate" == "$current" ]] || rm -f "$candidate"
    return 1
  fi
  warn "确认后主控将在下一轮自动接管以上四条记录；已有客户端受 DNS 缓存影响。"
  if ! ui_read_field answer "确认启用 DNSPod 线路切换？y/n" n ui_valid_yes_no; then
    [[ "$candidate" == "$current" ]] || rm -f "$candidate"
    return 0
  fi
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    if ! controller_cli dnspod-configure --state "$state" --token-file "$candidate" --apply; then
      [[ "$candidate" == "$current" ]] || rm -f "$candidate"
      return 1
    fi
    info "接入完成。返回控制器选 8 配置自动 HTTPS（DNSPod/其他 DNS 使用 Caddy HTTP-01），再选 3 接入边缘；随后设置线路。"
  fi
  [[ "$candidate" == "$current" ]] || rm -f "$candidate"
  return 0
}

