controller_cli() {
  command -v python3 >/dev/null 2>&1 || die "多线路功能需要 python3。"
  python3 - "$@" <<'PY'
import argparse, copy, grp, hashlib, ipaddress, json, math, os, re, secrets, shlex, shutil, socket, ssl, subprocess, sys, tempfile, threading, time
import urllib.error, urllib.request
from contextlib import contextmanager
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlencode, urlparse

try:
    import fcntl
except ImportError:  # pragma: no cover - Linux is the supported runtime
    fcntl = None

ENROLL_TTL = 15 * 60
HEARTBEAT_TTL = 90
FAILURE_THRESHOLD = 3
RECOVERY_THRESHOLD = 3
RECOVERY_SECONDS = 60
SWITCH_COOLDOWN = 180
def now(): return int(time.time())
def digest(v): return hashlib.sha256(v.encode()).hexdigest()
def atomic_write(path, data):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    # A fixed ``.tmp`` is both observable and racy when a heartbeat and the
    # long-running controller update the same state.  Create the file with its
    # private mode from the first byte, fsync it, then atomically replace the
    # destination.  Replacing a symlink changes the link itself; it never
    # follows it to overwrite an unrelated target.
    payload = (json.dumps(data, indent=2, sort_keys=True) + '\n').encode()
    fd = None; tmp = None
    try:
        fd, tmp_name = tempfile.mkstemp(prefix='.' + path.name + '.tmp-', dir=str(path.parent))
        tmp = Path(tmp_name)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'wb') as out:
            fd = None
            out.write(payload); out.flush(); os.fsync(out.fileno())
        os.replace(tmp, path)
        # Persist the directory entry where supported.  Some test filesystems
        # do not expose a directory fd; the durable-file write remains valid.
        try:
            dir_fd = os.open(path.parent, os.O_RDONLY)
            try: os.fsync(dir_fd)
            finally: os.close(dir_fd)
        except OSError: pass
    finally:
        if fd is not None:
            try: os.close(fd)
            except OSError: pass
        if tmp is not None:
            tmp.unlink(missing_ok=True)
def atomic_text_write(path, content, mode=None):
    """Atomically replace a text config without following a symlink."""
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise RuntimeError('拒绝覆盖符号链接形式的配置文件：%s' % path)
    if mode is None:
        try: mode = path.stat().st_mode & 0o777
        except OSError: mode = 0o644
    try: mode = int(mode) & 0o777
    except (TypeError, ValueError): mode = 0o644
    fd = None; tmp = None
    try:
        fd, tmp_name = tempfile.mkstemp(prefix='.' + path.name + '.tmp-', dir=str(path.parent))
        tmp = Path(tmp_name)
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'w') as out:
            fd = None
            out.write(str(content)); out.flush(); os.fsync(out.fileno())
        os.replace(tmp, path)
        try:
            dir_fd = os.open(path.parent, os.O_RDONLY)
            try: os.fsync(dir_fd)
            finally: os.close(dir_fd)
        except OSError: pass
    finally:
        if fd is not None:
            try: os.close(fd)
            except OSError: pass
        if tmp is not None:
            tmp.unlink(missing_ok=True)
def backup_file(path):
    """Create a private, timestamped backup before an operator-level mutation."""
    path = Path(path)
    if path.is_symlink():
        raise RuntimeError('拒绝备份符号链接形式的受管文件：%s' % path)
    if not path.exists(): return None
    stamp = time.strftime('%Y%m%d-%H%M%S')
    backup = path.with_name(path.name + '.bak-' + stamp)
    suffix = 1
    while backup.exists():
        backup = path.with_name(path.name + '.bak-' + stamp + '-%s' % suffix)
        suffix += 1
    shutil.copy2(path, backup)
    os.chmod(backup, 0o600)
    return backup
def restore_file(path, backup):
    path = Path(path)
    if path.is_symlink():
        raise RuntimeError('拒绝恢复到符号链接形式的受管文件：%s' % path)
    if backup:
        if Path(backup).is_symlink():
            raise RuntimeError('拒绝从符号链接备份恢复：%s' % backup)
        # JSON state must remain private; for text configs/units retain the
        # original backup mode instead of silently widening a 0640 Caddyfile
        # to 0644 during rollback.
        if path.suffix == '.json':
            mode=0o600
        else:
            try: mode=Path(backup).stat().st_mode & 0o777
            except OSError: mode=0o644
        content=Path(backup).read_text()
        atomic_text_write(path,content,mode)
    else:
        path.unlink(missing_ok=True)
def write_unit(path, content):
    """Atomically install a systemd unit and return its previous-file backup."""
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise RuntimeError('拒绝覆盖符号链接形式的 systemd 单元：%s' % path)
    if path.exists():
        old = path.read_text(errors='replace')
        managed = ('# MANAGED EMBY ' in old or
                   ('ExecStart=/usr/local/sbin/emby-proxy controller serve --state ' in old and
                    'Description=emby-proxy multiline master' in old) or
                   ('ExecStart=/usr/local/sbin/emby-proxy controller node --state ' in old) or
                   ('Unit=emby-proxy-' in old and 'OnCalendar=' in old))
        if not managed:
            raise RuntimeError('拒绝覆盖非脚本托管的 systemd 单元：%s' % path)
    backup = backup_file(path)
    tmp = path.with_name('.' + path.name + '.tmp-' + secrets.token_hex(6))
    try:
        with tmp.open('w') as out:
            os.fchmod(out.fileno(), 0o644)
            out.write(content); out.flush(); os.fsync(out.fileno())
        os.replace(tmp, path)
        try:
            dir_fd = os.open(path.parent, os.O_RDONLY)
            try: os.fsync(dir_fd)
            finally: os.close(dir_fd)
        except OSError: pass
    except Exception:
        tmp.unlink(missing_ok=True)
        raise
    return backup
def validate_endpoint(value, allow_http=True, label='地址'):
    value = str(value).strip()
    if any(c.isspace() or ord(c) < 32 for c in value):
        raise RuntimeError('%s不能包含空白或控制字符。' % label)
    try: parsed = urlparse(value)
    except ValueError as e: raise RuntimeError('%s格式无效：%s' % (label, e))
    schemes = ('http', 'https') if allow_http else ('https',)
    if (parsed.scheme not in schemes or not parsed.hostname or parsed.username or
            parsed.password or parsed.query or parsed.fragment or
            parsed.path not in ('', '/')):
        raise RuntimeError('%s必须只包含协议、主机名和端口，不能带路径、查询、片段或账号信息。' % label)
    try: parsed.port
    except ValueError: raise RuntimeError('%s端口无效。' % label)
    return value.rstrip('/')
@contextmanager
def state_lock(path):
    """Serialize CLI updates and the long-running master service."""
    lock_path = Path(str(path) + '.lock'); lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = open_private_lock(lock_path)
    try:
        if fcntl is not None: fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        if fcntl is not None: fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)

def open_private_lock(path):
    """Open a manager lock without following a user-created symlink."""
    flags=os.O_CREAT | os.O_RDWR
    if hasattr(os,'O_NOFOLLOW'): flags |= os.O_NOFOLLOW
    fd=os.open(str(path),flags,0o600)
    try: os.fchmod(fd,0o600)
    except OSError:
        os.close(fd); raise
    return fd
class NoCredentialRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl): return None

def bounded_json_response(response, limit=1048576):
    raw=response.read(limit+1)
    if len(raw) > limit: raise ValueError('response too large')
    result=json.loads(raw)
    if not isinstance(result,dict): raise ValueError('invalid response')
    return result

def post_json(url, payload, token=''):
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers={'Content-Type':'application/json'}, method='POST')
    if token: req.add_header('Authorization', 'Bearer ' + token)
    try:
        with urllib.request.build_opener(NoCredentialRedirect).open(req, timeout=20) as r: return bounded_json_response(r)
    except urllib.error.HTTPError as e:
        code=int(getattr(e,'code',0) or 0)
        try: e.close()
        except OSError: pass
        raise RuntimeError('主控返回 HTTP %s。' % code) from None
    except (urllib.error.URLError, OSError, ValueError):
        raise RuntimeError('无法连接主控或响应格式无效。') from None

DNSPOD_API = 'https://dnsapi.cn/'
DNSPOD_LINES = ('默认', '电信', '联通', '移动')
ADDRESS_FAMILIES = ('ipv4', 'ipv6')

def normalize_address_family(value):
    value = str(value or 'ipv4').strip().lower()
    if value not in ADDRESS_FAMILIES:
        raise RuntimeError('地址类型只能是 ipv4 或 ipv6。')
    return value

def address_record_type(value):
    return 'AAAA' if normalize_address_family(value) == 'ipv6' else 'A'

def validate_node_public_ip(value, address_family):
    """Validate an address before it can ever be written to DNS."""
    if value in (None, ''): return None
    try:
        address = (ipaddress.IPv6Address if normalize_address_family(address_family) == 'ipv6'
                   else ipaddress.IPv4Address)(str(value).strip())
    except ValueError:
        raise ValueError('invalid_public_ip') from None
    if not address.is_global or address.is_multicast or address.is_unspecified:
        raise ValueError('invalid_public_ip')
    return str(address)

def validate_node_limits(priority, quota_bytes):
    """Return bounded integer limits accepted from an enrollment request."""
    try:
        if (isinstance(priority, bool) or isinstance(quota_bytes, bool) or
                (isinstance(priority, float) and not priority.is_integer()) or
                (isinstance(quota_bytes, float) and not quota_bytes.is_integer())): raise ValueError
        priority = int(priority); quota_bytes = int(quota_bytes)
    except (TypeError, ValueError, OverflowError):
        raise ValueError('invalid_node_limits') from None
    if not 0 <= priority <= 1_000_000 or not 0 <= quota_bytes <= 2**63 - 1:
        raise ValueError('invalid_node_limits')
    return priority, quota_bytes

METRIC_DEVICE_CLASSES = ('Unknown', 'TV', 'iOS', 'Android', 'Windows', 'macOS',
                         'Linux', 'Emby/客户端', '浏览器', 'Other')

def _metric_client(value):
    try:
        text=str(value).strip()
        # Scoped interface identifiers are local metadata, not public clients.
        if '%' in text: return ''
        return str(ipaddress.ip_address(text))
    except ValueError: return ''

def _metric_path(value):
    """Keep only a relative URL path, never its credentials or query string."""
    try:
        parsed=urlparse(str(value))
        path=parsed.path or '/'
    except ValueError: return '/'
    if not path.startswith('/'): return '/'
    path=''.join(char for char in path if ord(char) >= 32 and ord(char) != 127
                 and not '\u202a' <= char <= '\u202e' and not '\u2066' <= char <= '\u2069')
    return path[:256] or '/'

def sanitize_metrics(value):
    """Accept bounded counters, real IPs, fixed device classes and URL paths."""
    if not isinstance(value,dict): return None
    def number(item):
        try:
            parsed=float(item)
            if isinstance(item,bool) or not math.isfinite(parsed): return 0
            return max(0,min(int(parsed),10**18))
        except (TypeError,ValueError,OverflowError): return 0
    def bucket(name, limit):
        grouped={}
        rows=value.get(name,[]) if isinstance(value.get(name),list) else []
        for row in rows[:limit * 4]:
            if not isinstance(row,dict): continue
            label=row.get('name','')
            if name == 'clients': label=_metric_client(label)
            elif name == 'devices': label=str(label) if label in METRIC_DEVICE_CLASSES else ''
            else: label=_metric_path(label) if isinstance(label,str) and label else ''
            if not label: continue
            target=grouped.setdefault(label,{'name':label,'requests':0,'bytes':0})
            target['requests']=min(10**18,target['requests']+number(row.get('requests')))
            target['bytes']=min(10**18,target['bytes']+number(row.get('bytes')))
        return sorted(grouped.values(),key=lambda row:(-row['bytes'],-row['requests'],row['name']))[:limit]
    generated=number(value.get('generated_at'))
    if generated > now()+300: generated=0
    requests=number(value.get('requests'))
    return {'generated_at':generated,'window_seconds':max(60,min(number(value.get('window_seconds')),3600)),
            'requests':requests,'bytes':number(value.get('bytes')),'errors':min(requests,number(value.get('errors'))),
            'clients':bucket('clients',20),'devices':bucket('devices',12),'paths':bucket('paths',20),
            'sampled_rows':min(20000,number(value.get('sampled_rows'))),'truncated':value.get('truncated') is True}


def dnspod_call(action, params, token):
    """Legacy DNSPod Token API; no credentials in URLs, redirects or errors."""
    if action not in ('Domain.List', 'Record.List', 'Record.Info', 'Record.Modify', 'Record.Create', 'Record.Remove'):
        raise RuntimeError('不支持的 DNSPod 操作。')
    token = str(token).strip()
    if not re.fullmatch(r'[0-9]+,[A-Za-z0-9_-]+', token):
        raise RuntimeError('请使用 DNSPod ID,Token，不是腾讯云 SecretId/SecretKey。')
    form = {'login_token': token, 'format': 'json', 'lang': 'cn', 'error_on_empty': 'no'}
    form.update(params)
    req = urllib.request.Request(DNSPOD_API + action, data=urlencode(form).encode(),
        headers={'Content-Type': 'application/x-www-form-urlencoded',
                 'User-Agent': 'emby-proxy/1 (https://github.com/wuuduf/emby-proxy)'}, method='POST')
    try:
        with urllib.request.build_opener(NoCredentialRedirect).open(req, timeout=10) as response:
            raw = response.read(1048577)
        if len(raw) > 1048576: raise ValueError('oversize')
        result = json.loads(raw)
    except urllib.error.HTTPError as error:
        try: error.close()
        except OSError: pass
        raise RuntimeError('DNSPod API 请求失败；检查网络、凭据和 API 可用性。') from None
    except (urllib.error.URLError, OSError, ValueError):
        raise RuntimeError('DNSPod API 请求失败；检查网络、凭据和 API 可用性。') from None
    status = result.get('status') if isinstance(result, dict) else None
    if not isinstance(status, dict) or str(status.get('code')) != '1':
        # Do not reflect an untrusted response message which could contain tokens.
        code = str(status.get('code', 'invalid')) if isinstance(status, dict) else 'invalid'
        code = code if re.fullmatch(r'-?\d{1,6}', code) else 'invalid'
        raise RuntimeError('DNSPod API 拒绝请求（code=%s）；检查 Token/权限/套餐，未确认的更改会重试。' % code)
    return result


def dnspod_pages(action, params, token, key):
    items = []
    for offset in range(0, 10000, 100):
        page = dnspod_call(action, dict(params, offset=offset, length=100), token).get(key)
        if not isinstance(page, list) or any(not isinstance(item, dict) for item in page):
            raise RuntimeError('DNSPod 列表响应格式无效。')
        items.extend(page)
        if len(page) < 100: return items
    raise RuntimeError('DNSPod 列表超出安全分页上限；未应用配置。')


def dnspod_zone(domain, token):
    # Longest hosted suffix handles both a delegated zone apex (@) and deep names.
    domain = str(domain).lower().rstrip('.')
    zones = dnspod_pages('Domain.List', {}, token, 'domains')
    matches = [z for z in zones if z.get('status') == 'enable' and
               (domain == z.get('name') or domain.endswith('.' + str(z.get('name', ''))))]
    if not matches: raise RuntimeError('DNSPod 中没有匹配的托管域名；先在控制台添加并完成子域名验证。')
    zone = max(matches, key=lambda z: len(z['name']))
    host = '@' if domain == zone['name'] else domain[:-(len(zone['name']) + 1)]
    nameservers = zone.get('grade_ns') or []
    if (not str(zone.get('id', '')).isdigit() or not isinstance(nameservers, list) or not nameservers or
            any(not re.fullmatch(r'[A-Za-z0-9.-]+', str(n)) for n in nameservers)):
        raise RuntimeError('DNSPod 缺少域名 ID 或权威 NS 信息。')
    return {'domain_id': str(zone['id']), 'zone': zone['name'], 'sub_domain': host,
            'nameservers': sorted(str(n).lower().rstrip('.') for n in nameservers)}


def dnspod_discovery(domain, token_file, record_type='A'):
    record_type = str(record_type).upper()
    if record_type not in ('A', 'AAAA'): raise RuntimeError('DNSPod 记录类型只能是 A 或 AAAA。')
    token = Path(token_file).read_text().strip()
    config = dnspod_zone(domain, token)
    records = dnspod_pages('Record.List', {'domain_id': config['domain_id'],
        'sub_domain': config['sub_domain']}, token, 'records')
    found = {}; seen_ids = set()
    for r in records:
        if str(r.get('name', '')).lower().rstrip('.') != config['sub_domain']: continue
        if r.get('type') == 'CNAME' or (r.get('type') in ('A', 'AAAA') and r.get('type') != record_type):
            raise RuntimeError('入口存在与当前地址类型冲突的 A/AAAA/CNAME 记录，请先人工处理。')
        if r.get('type') != record_type: continue
        line = r.get('line')
        if line not in DNSPOD_LINES:
            raise RuntimeError('存在额外的 %s 记录线路；只接管 默认/电信/联通/移动。' % record_type)
        if str(r.get('enabled')) != '1' or r.get('monitor_status'):
            raise RuntimeError('线路记录须已启用、未启用其他 DNS 监控。')
        if not str(r.get('id', '')).isdigit() or str(r.get('id')) in seen_ids or not str(r.get('line_id', '')) or not str(r.get('ttl', '')).isdigit():
            raise RuntimeError('DNSPod 记录字段不完整。')
        try: (ipaddress.IPv6Address if record_type == 'AAAA' else ipaddress.IPv4Address)(str(r.get('value', '')))
        except ValueError: raise RuntimeError('DNSPod 线路记录必须是有效 %s 记录。' % record_type) from None
        seen_ids.add(str(r['id']))
        weight=r.get('weight')
        if weight not in (None,'',0,'0') and not re.fullmatch(r'[1-9][0-9]{0,5}',str(weight)):
            raise RuntimeError('DNSPod 权重必须是正整数。')
        found.setdefault(line,[]).append({'record_id': str(r['id']), 'record_line_id': str(r['line_id']),
                                          'ttl': int(r['ttl']), 'weight': int(weight) if weight not in (None,'',0,'0') else None})
    if set(found) != set(DNSPOD_LINES):
        raise RuntimeError('DNSPod 缺少线路记录：%s；请先创建四条线路 %s 记录，不会替您覆盖/创建业务记录。' % (record_type,
                           '、'.join(line for line in DNSPOD_LINES if line not in found)))
    line_records={line:(items[0] if len(items)==1 else items) for line,items in found.items()}
    return dict(config, provider='dnspod', record_type=record_type, token_file=str(Path(token_file).resolve()), line_records=line_records, routes={}, line_weights={})


def dnspod_discover(a):
    print(json.dumps(dnspod_discovery(a.domain, a.token_file, getattr(a, 'record_type', 'A')), ensure_ascii=False))


def check_dnspod_delegation(domain, config):
    """Read-only recursive NS preflight; never edits the parent zone."""
    if not shutil.which('dig'): raise RuntimeError('NS 检查需要 dig：Debian/Ubuntu 可安装 dnsutils。')
    labels = domain.split('.')
    for i in range(len(labels) - len(config['zone'].split('.')) + 1):
        name = '.'.join(labels[i:])
        try:
            r = subprocess.run(['dig', '+time=3', '+tries=1', '+short', 'NS', name],
                               check=True, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            raise RuntimeError('NS 查询失败；检查 DNS 网络后重试。') from None
        servers = sorted(set(v.lower().rstrip('.') for v in r.stdout.split()))
        if not servers: continue
        if servers != sorted(config['nameservers']):
            raise RuntimeError('NS 尚未指向当前 DNSPod 区域；请按控制台 NS 完成委派并等待缓存刷新。')
        return {'ok': True, 'delegation': name, 'nameservers': servers}
    raise RuntimeError('未找到 DNSPod NS 委派；请先在父域添加 NS 记录（不自动修改父域）。')


def dnspod_configure(a):
    path = Path(a.state)
    before = json.loads(path.read_text())
    config = dnspod_discovery(before['domain'], a.token_file, address_record_type(before.get('address_family', 'ipv4')))
    proof = check_dnspod_delegation(before['domain'], config)
    # The control domain may remain on another DNS provider; only the business
    # hostname is delegated to DNSPod. Certificate issuance is handled separately.
    if not getattr(a, 'apply', False):
        print(json.dumps({'preview': True, 'dns': config, 'delegation': proof}, ensure_ascii=False, indent=2))
        return
    with state_lock(str(path)+'.cert-issue'), state_lock(path):
        latest = json.loads(path.read_text())
        if any(latest.get(k) != before.get(k) for k in ('domain', 'dns', 'certificates')):
            raise RuntimeError('入口配置并发变化，请重新检查。')
        # A versioned private file avoids changing a live credential on cancellation.
        fd, token_path = tempfile.mkstemp(prefix='dnspod-', suffix='.token', dir=path.parent)
        try:
            with os.fdopen(fd, 'w') as stream:
                os.fchmod(stream.fileno(), 0o600)
                stream.write(Path(a.token_file).read_text().strip() + '\n')
            config['token_file'] = token_path
            old = latest.get('dns') or {}
            if old.get('provider') == 'dnspod': config['routes'] = old.get('routes') or {}
            if old.get('provider') == 'dnspod':
                config['line_weights'] = old.get('line_weights') or {}
                if old.get('schedule'): config['schedule'] = old['schedule']
            backup_file(path)
            latest['dns'] = config
            latest.pop('line_states', None)
            latest['dns_needs_confirmation'] = True
            atomic_write(path, latest)
        except Exception:
            Path(token_path).unlink(missing_ok=True)
            raise
    print('DNSPod 已接入，节点/注册码保留；每条记录已获得接管授权。主控下轮检查将同步线路。')

def certificate_info(pair, domain):
    pair=Path(pair)
    try:
        ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(str(pair/'fullchain.pem'),str(pair/'privkey.pem'),password=lambda: b'')
        info=ssl._ssl._test_decode_cert(str(pair/'fullchain.pem'))
        names=[v for k,v in info.get('subjectAltName',[]) if k == 'DNS']
        if names != [domain]: raise ValueError('certificate must cover only the configured domain')
        expires=int(ssl.cert_time_to_seconds(info['notAfter']))
        if expires-now() < 86400: raise ValueError('certificate expires within 24 hours')
        subprocess.run(['openssl','verify','-purpose','sslserver','-verify_hostname',domain,
            '-untrusted',str(pair/'fullchain.pem'),str(pair/'fullchain.pem')],
            check=True,capture_output=True,timeout=15)
        return {'expires_at':expires,'version':hashlib.sha256((pair/'fullchain.pem').read_bytes()).hexdigest()}
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
        raise RuntimeError('证书校验失败：域名、私钥、有效期或信任链不符合要求。') from e

def secure_certificate_request(st):
    url=validate_endpoint(st['controller'],allow_http=False,label='证书主控地址')
    req=urllib.request.Request(url+'/certificate', data=json.dumps({
        'node_id':st['node_id'],'entry_id':st['entry_id']}).encode(),
        headers={'Content-Type':'application/json','Authorization':'Bearer '+st['node_token']},method='POST')
    try:
        with urllib.request.build_opener(NoCredentialRedirect).open(req,timeout=20) as r:
            raw=r.read(131073)
        if len(raw)>131072: raise ValueError('response too large')
        result=json.loads(raw)
        if not isinstance(result,dict): raise ValueError('invalid response')
        return result
    except (OSError,ValueError) as e:
        raise RuntimeError('证书领取失败；检查主控 HTTPS、节点授权与证书签发状态。') from e

def install_certificate(st, bundle, reload=True):
    domain=st['domain']; engine=st.get('engine','nginx')
    if bundle.get('domain') != domain or engine not in ('caddy','nginx'):
        raise RuntimeError('证书入口或引擎不匹配。')
    root=Path(st['certificate_directory'])
    if root.is_symlink() or (root.exists() and any(root.iterdir()) and not (root/'.managed-emby-certificates').is_file()):
        raise RuntimeError('证书目录不是脚本托管目录，拒绝覆盖。')
    root.mkdir(parents=True,exist_ok=True)
    marker=root/'.managed-emby-certificates'
    if marker.is_symlink() or (marker.exists() and not marker.is_file()):
        raise RuntimeError('证书目录标记不是普通文件，拒绝覆盖。')
