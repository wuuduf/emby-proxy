        state=json.loads(Path(path).read_text()); config=state.get('telegram') or {}
        latest_pending=config.get('pending_alerts') if isinstance(config.get('pending_alerts'),list) else []
        latest_enabled=config.get('enabled') is True
        latest_allowed={str(item) for item in config.get('chat_ids') or []} if latest_enabled else set()
        latest_token=''
