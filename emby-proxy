        except RuntimeError: latest_enabled=False
        latest_generation=telegram_alert_generation(config,latest_token)
        merged=[]; handled=set(outcomes)
        seen_ids=set()
        for index,item in enumerate(latest_pending):
            raw=telegram_normalize_alert(item,index,latest_generation)
            if raw is None or raw['generation'] != latest_generation: continue
            if raw['id'] in seen_ids:
                raw['id']=hashlib.sha256((raw['message']+'|'+str(raw['created_at'])+'|duplicate|'+str(index)).encode()).hexdigest()[:32]
            seen_ids.add(raw['id'])
            event_id=raw['id']
            result=outcomes.get(event_id)
            if event_id in handled and result is None: continue
            if event_id in handled:
