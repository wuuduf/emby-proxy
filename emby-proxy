  printf '%s' "$state"
}

controller_init_menu() {
  local state entry_id domain source engine zone_id record_id token_file answer
  state="$(controller_state_path)"
  printf '\n主控状态文件（默认 %s）：' "$state"; read -r answer; state="${answer:-$state}"
  printf '入口 ID（例如 domain-emby.example.com）：'; read -r entry_id
  printf '对外域名（例如 emby.example.com）：'; read -r domain
  printf 'Emby 源站 URL（固定源站）：'; read -r source
  printf '边缘节点使用的反代引擎 [caddy/nginx，默认 caddy]：'; read -r engine; engine="${engine:-caddy}"
  [[ "$engine" == "caddy" || "$engine" == "nginx" ]] || { warn "引擎只能是 caddy 或 nginx。"; return 1; }
  [[ -n "$entry_id" && -n "$domain" && -n "$source" ]] || { warn "入口 ID、域名和源站不能为空。"; return 1; }
  [[ "$entry_id" =~ ^domain-[A-Za-z0-9.-]+$ ]] || { warn "入口 ID 必须类似 domain-emby.example.com。"; return 1; }
  [[ "$domain" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { warn "对外域名格式无效。"; return 1; }
  [[ "$source" =~ ^https?://[^[:space:]]+$ ]] || { warn "源站必须是 http:// 或 https:// URL，不能包含空格。"; return 1; }
  printf '是否启用 Cloudflare A 记录切换？[y/N]：'; read -r answer
  local -a args=(init --state "$state" --entry-id "$entry_id" --domain "$domain" --source "$source" --engine "$engine")
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    printf 'Cloudflare zone_id：'; read -r zone_id
    printf 'Cloudflare record_id：'; read -r record_id
    printf 'API Token 文件路径（不会把 Token 写入状态文件）：'; read -r token_file
    [[ -n "$zone_id" && -n "$record_id" && -n "$token_file" ]] || { warn "Cloudflare 三项不能为空。"; return 1; }
    args+=(--zone-id "$zone_id" --record-id "$record_id" --token-file "$token_file")
  fi
  if [[ -f "$state" ]]; then
    printf '状态文件已存在，覆盖会清空节点注册信息，确认？[y/N]：'; read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { warn "已取消初始化。"; return 0; }
  fi
  controller_cli "${args[@]}"
}

controller_issue_menu() {
  local state node_id name priority quota public_ip controller_url answer
  state="$(controller_require_state)" || return 1
  printf '主控访问地址（例如 https://control.example.com:19090）：'; read -r controller_url
  printf '节点 ID（例如 edge-a）：'; read -r node_id
  printf '节点名称（例如 香港线路）：'; read -r name
  printf '优先级（数字越大越优先，默认 100）：'; read -r priority; priority="${priority:-100}"
  printf '配额字节数（0 表示不限额，默认 0）：'; read -r quota; quota="${quota:-0}"
  printf '边缘节点公网 IPv4（用于 DNS 切换）：'; read -r public_ip
  [[ -n "$controller_url" && -n "$node_id" && -n "$name" && -n "$public_ip" ]] || { warn "主控地址、节点信息和公网 IPv4 不能为空。"; return 1; }
  [[ "$controller_url" =~ ^https?://[^[:space:]]+$ ]] || { warn "主控地址必须是 http:// 或 https:// URL。"; return 1; }
  [[ "$node_id" =~ ^[A-Za-z0-9._-]+$ ]] || { warn "节点 ID 只能包含字母、数字、点、下划线和短横线。"; return 1; }
  [[ "$public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { warn "公网 IPv4 格式无效。"; return 1; }
  [[ "$priority" =~ ^[0-9]+$ && "$quota" =~ ^[0-9]+$ ]] || { warn "优先级和配额必须是非负整数。"; return 1; }
  controller_cli issue --state "$state" --controller-url "$controller_url" --node-id "$node_id" --name "$name" --priority "$priority" --quota-bytes "$quota" --public-ip "$public_ip"
  printf '\n请把上面生成的一次性 node-install 命令复制到边缘 VPS 执行。注册码只能使用一次。\n'
}

controller_master_menu() {
  local state listen interval answer
  state="$(controller_require_state)" || return 1
  printf '主控监听地址（默认 127.0.0.1:19090；公网使用请放到 HTTPS/WireGuard 后）：'; read -r listen; listen="${listen:-127.0.0.1:19090}"
  printf 'DNS/健康检查间隔秒数（默认 30）：'; read -r interval; interval="${interval:-30}"
  [[ "$listen" =~ ^[^[:space:]]+:[0-9]{1,5}$ ]] || { warn "监听地址必须是 host:port 格式。"; return 1; }
  [[ "$interval" =~ ^[1-9][0-9]*$ ]] || { warn "间隔必须是正整数。"; return 1; }
  controller_cli master-install --state "$state" --listen "$listen" --reconcile-interval "$interval"
  printf '是否立即查看主控服务状态？[Y/n]：'; read -r answer
  [[ ! "$answer" =~ ^[Nn]$ ]] && systemctl --no-pager --full status emby-proxy-master.service || true
}

controller_status_menu() {
  local state
  state="$(controller_require_state)" || return 1
  controller_cli status --state "$state"
}

controller_reconcile_menu() {
  local state
  state="$(controller_require_state)" || return 1
  controller_cli reconcile --state "$state"
}

controller_logs_menu() {
  systemctl --no-pager -n 100 status emby-proxy-master.service || true
}

controller_menu() {
  local choice
  while true; do
    ui_header "多线路控制器" "主控 / 边缘注册 / 优先级配额"
    printf '\n主控只负责节点注册、健康检查、优先级选择和 Cloudflare A 记录切换，不转发媒体流量。\n'
    ui_item 1 "初始化主控入口" "固定源站、域名和可选 Cloudflare"
    ui_item 2 "生成边缘注册命令" "一次性注册码，复制到边缘 VPS"
    ui_item 3 "安装/启动主控服务" "systemd 每 30 秒检查"
    ui_item 4 "查看主控状态" "节点健康、配额、当前节点"
    ui_item 5 "立即同步 DNS" "按优先级选择健康节点"
    ui_item 6 "查看主控服务" "systemd 状态和最近日志"
    ui_item 0 "返回上一级" ""
    ui_prompt; read -r choice
    case "$choice" in
      1) menu_run controller_init_menu ;;
      2) menu_run controller_issue_menu ;;
      3) menu_run controller_master_menu ;;
      4) menu_run controller_status_menu ;;
      5) menu_run controller_reconcile_menu ;;
      6) menu_run controller_logs_menu ;;
      0|q|Q) return ;;
      *) warn "请输入有效序号。" ;;
    esac
  done
}

main_menu() {
  local choice id
  require_jq; ensure_state_dirs
  if (( $(site_count) == 0 )) && { [[ -f "$CADDYFILE" ]] || compgen -G "$NGINX_CONF_DIR/emby-proxy-*.conf" >/dev/null; }; then
    warn "检测到可能存在旧版脚本配置，可在菜单中选择“导入旧配置”。"
  fi
  while true; do
    ui_header "Emby 反向代理管理面板" "域名 HTTPS · 固定源站 · 安全变更"
    print_status compact
    ui_section "入口配置"
    ui_item 1 "查看全部反代入口" "域名、引擎、路径数"
    ui_item 2 "查看入口详情" "映射、健康检查"
    ui_item 3 "新增反代入口" "Caddy / Nginx 向导"
    ui_item 4 "管理已有入口" "路径、源站、删除"
    ui_section "观察与维护"
    ui_item 5 "运行完整诊断" "环境、DNS、TLS、源站"
    ui_item 6 "日志与流量统计" "媒体、错误、慢请求"
    ui_item 7 "备份、差异与恢复" "带 SHA256 校验"
    ui_item 8 "Web 服务管理" "安全 Reload / Restart"
    ui_section "工具"
    ui_item 9 "导入旧版配置" "只建立管理索引"
    ui_item 10 "检查/更新程序" "校验 SHA256 后更新"
    ui_item 11 "多线路控制器" "主控、节点注册与优先级配额（实验版）"
    ui_item 12 "完全卸载 emby-proxy" "删除脚本托管内容，保留 Caddy/Nginx 和证书"
    ui_item 0 "退出面板" "也可以输入 q"
    ui_prompt; read -r choice
    case "$choice" in
      1) menu_run list_sites ;;
      2) if id="$(select_site_id)"; then menu_run show_site "$id"; else ui_pause; fi ;;
      3) menu_run run_add_wizard ;;
      4) if id="$(select_site_id)"; then manage_site_menu "$id"; else ui_pause; fi ;;
      5) menu_run run_doctor ;;
      6) logs_stats_menu ;;
      7) backup_menu ;;
      8) service_menu ;;
      9) menu_run import_existing ;;
      10) menu_update ;;
      11) controller_menu ;;
      12) uninstall_manager; if (( UNINSTALL_COMPLETED == 1 )); then exit 0; fi ;;
      0|q|Q) ui_clear; return ;;
      *) warn "请输入有效序号。" ;;
    esac
  done
}

main() {
  local command="${1:-menu}" id action
  case "$command" in
    -h|--help|help) usage; return ;;
    -V|--version|version) printf 'emby-proxy %s\n' "$VERSION"; return ;;
  esac
  require_root "$@"
  if [[ "$command" == "uninstall" ]]; then
    uninstall_manager "${2:-}"
    return
  fi
  ensure_short_command || true
  require_jq; ensure_state_dirs; normalize_state_registry
  case "$command" in
    menu) main_menu ;;
    status) print_status ;;
    list) list_sites ;;
    show) [[ $# -ge 2 ]] || die "用法：emby-proxy show <入口ID>"; show_site "$2" ;;
    add) shift; run_add_wizard "$@" ;;
    import) import_existing ;;
    doctor) run_doctor "${2:-}" ;;
    logs) [[ $# -ge 2 ]] || die "用法：emby-proxy logs <入口ID> [--follow|--media|--errors|--slow 秒]"
      view_logs "$2" "${3:---recent}" "${4:-2}" ;;
    stats)
      [[ $# -ge 2 ]] || die "用法：emby-proxy stats <入口ID> [--since 24h]"
      if [[ "${3:-}" == "--since" ]]; then show_stats "$2" "${4:-24h}"; else show_stats "$2" "${3:-24h}"; fi ;;
    backup)
      case "${2:-list}" in
        list) backup_list ;;
        show) [[ $# -ge 3 ]] || die "用法：emby-proxy backup show <备份ID>"; backup_show "$3" ;;
        restore) [[ $# -ge 3 ]] || die "用法：emby-proxy backup restore <备份ID>"; restore_backup "$3" ;;
        clean) backup_clean "${3:-20}" "${4:-}" ;;
        *) die "备份操作支持：list、show、restore、clean。" ;;
      esac ;;
    service) service_control "${2:-status}" "${3:-}" ;;
    update)
      local previous_version="$VERSION"
      self_update "${2:-}"
      restart_updated_manager "$previous_version"
      ;;
    delete) [[ $# -ge 2 ]] || die "用法：emby-proxy delete <入口ID>"; delete_site "$2" ;;
    route)
      [[ $# -ge 3 ]] || die "用法：emby-proxy route add|set|delete <入口ID>"
      action="$2"; id="$3"
      case "$action" in
        add|set) route_upsert "$action" "$id" ;;
        delete|remove|rm) route_delete "$id" ;;
        *) die "路径操作只能是 add、set 或 delete。" ;;
      esac ;;
    config) [[ "${2:-}" == "test" ]] || die "用法：emby-proxy config test"; config_test ;;
    controller)
      shift
      controller_cli "$@" ;;
    *) die "未知命令：${command}。运行 emby-proxy --help 查看帮助。" ;;
  esac
}

if [[ "${EMBY_PROXY_MANAGER_LIB_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
