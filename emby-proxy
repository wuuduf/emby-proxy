controller_status_menu() {
  local state status
  state="$(controller_require_state)" || return 1
  status="$(controller_cli status --state "$state")" || return 1
  jq -r '
    def size: if . >= 1099511627776 then ((. / 1099511627776 * 100 | floor) / 100 | tostring) + " TiB"
      elif . >= 1073741824 then ((. / 1073741824 * 100 | floor) / 100 | tostring) + " GiB"
      elif . >= 1048576 then ((. / 1048576 * 100 | floor) / 100 | tostring) + " MiB"
      else (tostring) + " B" end;
    "\n访问域名：https://\(.domain)\n地址类型：\(.address_family // "ipv4")\n固定源站：\(.source)\n当前记录节点：\(.active_node // "尚未切换")\n活动节点池：" + ((.active_nodes // []) | join(", ")) + "\n下一候选节点：\(.selected_node // "无可用节点")\n",
    "DNS 提供商：" + (.dns.provider // "未配置"),
    ((.selected_lines // {} | to_entries)[] | .key as $line | .value as $p |
      "线路 " + $line + "：候选 " + ($p.selected_node // "无可用节点") +
      " · 最近确认 " + (.value.active_node // "无") ),
    ((.line_states // {} | to_entries)[] | "  " + .key + "：" + (.value.reason // "待同步") +
      " · IP " + (.value.confirmed_ip // "尚未确认")),
    "DNS 状态：" + (if (.dns_confirmed_at // 0) == 0 then "尚未回读确认"
      else "最近确认 IP " + (.confirmed_dns_ip // "未知") end),
    "自动证书：" + (if .certificates then "已启用 · 主控 " + .certificates.control_domain else "未启用（选 8 配置）" end),
    (if .routing.mode == "weighted" then "权重策略：" + ((.routing.weights // {}) | to_entries | map(.key + "=" + (.value|tostring)) | join(", ")) else empty end),
    (if ((.routing.schedule // []) | length) > 0 then "Cloudflare 定时档位：" + ((.routing.schedule | map(.start) | join(", "))) else empty end),
    (if ((.dns.schedule // []) | length) > 0 then "DNSPod 定时档位：" + ((.dns.schedule | map(.start) | join(", "))) else empty end),
    (if .last_reconcile_reason == "dns_unconfirmed" then "提醒：DNS 未确认，本轮不标记切换成功；下一轮重试。"
      elif .selected_node == null then "提醒：无可用节点，保留原 DNS 记录不代表该节点可用。" else empty end),
    ((.nodes // {} | to_entries | sort_by(-(.value.priority // 0)))[] |
      .value as $n |
      "  \($n.name // .key) [\(.key)] · 地址族 " + ($n.address_family // "ipv4") + " · 优先级 \($n.priority // 0)",
      "    状态：" + (if ((now | floor) - ($n.last_seen // 0)) > 90 then "心跳过期"
        elif (($n.quota_bytes // 0) > 0 and ($n.used_bytes // 0) >= $n.quota_bytes) then "配额已用完"
        elif $n.status == "recovering" then "恢复观察中（成功 " + (($n.success_streak // 0) | tostring) + " 次）"
        elif $n.status == "suspect" then "故障观察中（失败 " + (($n.failure_streak // 0) | tostring) + "/3 次）"
        elif ($n.healthy != true) then "节点自报不健康"
        else "心跳正常" end) +
      " · 用量：" + ($n.used_bytes // 0 | size) + " / " +
      (if ($n.quota_bytes // 0) == 0 then "不限额" else ($n.quota_bytes | size) end)),
    ((.nodes // {} | to_entries)[] | select(.value.certificate_status.expires_at? != null) |
      "    证书 [\(.key)]：\(.value.certificate_status.status // "unknown") · 到期 \(.value.certificate_status.expires_at | todateiso8601)"),
    (if (.nodes // {} | length) == 0 then "还没有节点。选 3 生成注册命令，在边缘 VPS 上执行。" else empty end)
  ' <<<"$status" || return 1
  printf '\n心跳正常不等于媒体可播放；当前用量来自节点托管 JSON 访问日志的累计响应字节。\n'
  printf '切换规则：连续失败 3 次；恢复需成功 3 次且持续 60 秒；健康节点间抢占冷却 180 秒。\n'
  printf '失联超过 90 秒或配额耗尽不等待冷却；DNS 确认不代表客户端缓存已刷新。\n'
}

