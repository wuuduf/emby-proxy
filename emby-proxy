    headers=request.get('headers') if isinstance(request.get('headers'),dict) else {}
    for key,value in headers.items():
        if str(key).lower() != name.lower(): continue
        if isinstance(value,list): return str(value[0] if value else '')
        return str(value)
    return ''

def _device_class(user_agent):
    value=str(user_agent or '').lower()
    if not value: return 'Unknown'
    if any(item in value for item in ('smart-tv','smarttv','tizen','webos','roku','tv;')): return 'TV'
    if any(item in value for item in ('iphone','ipad','ios')): return 'iOS'
    if any(item in value for item in ('android','fire tv','androidtv')): return 'Android'
    if any(item in value for item in ('windows phone','windows nt')): return 'Windows'
    if any(item in value for item in ('macintosh','mac os')): return 'macOS'
    if 'linux' in value: return 'Linux'
    if any(item in value for item in ('emby','jellyfin')): return 'Emby/客户端'
    if any(item in value for item in ('mozilla','chrome','safari','firefox','edge')): return '浏览器'
    return 'Other'

def collect_access_metrics(st, window=300, limit=5000):
    """Build a bounded recent access summary for controller queries.

