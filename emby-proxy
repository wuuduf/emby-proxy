def _access_timestamp(item):
    """Return finite event time; malformed JSON must never break a heartbeat."""
    if not isinstance(item,dict): return 0.0
    try:
        if item.get('ts') is not None:
            value=float(item['ts'])
        else:
            stamp=str(item.get('time') or '')
            if not stamp: return 0.0
            value=datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp()
        return value if math.isfinite(value) and value > 0 else 0.0
    except (TypeError,ValueError,OverflowError,OSError): return 0.0

def _metric_freshness(metric):
    """Describe sampling freshness instead of presenting a stale snapshot as live."""
    if not isinstance(metric,dict): return '无数据'
    generated=_json_number(metric.get('generated_at'))
    window=max(60,_json_number(metric.get('window_seconds')) or 300)
    if not generated: return '时间未知'
    age=max(0,now()-generated); label='约 %s 秒前' % age
    if age > max(window*2,600): label += '，已过期'
    if metric.get('truncated'): label += '，日志采样不完整'
    return label

def _metric_is_fresh(metric):
    if not isinstance(metric,dict): return False
    generated=_json_number(metric.get('generated_at'))
    window=max(60,_json_number(metric.get('window_seconds')) or 300)
    return bool(generated and 0 <= now()-generated <= max(window*2,600))

