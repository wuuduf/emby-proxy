def telemetry_transport_secure(controller):
    # A legacy HTTP controller can still receive liveness/usage, but access
    # IPs/devices are sent only over TLS or numeric loopback on this machine.
    try:
        endpoint=urlparse(validate_endpoint(controller))
        if endpoint.scheme == 'https': return True
        return endpoint.scheme == 'http' and ipaddress.ip_address(endpoint.hostname).is_loopback
    except (ValueError,RuntimeError): return False

