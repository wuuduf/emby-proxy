    # The tail is deliberately bounded; an explicit flag makes the UI honest
    # when a busy log has more recent rows than this sampling window can hold.
    try: row_limit=max(1,min(int(limit),20000))
    except (TypeError,ValueError,OverflowError): row_limit=5000
