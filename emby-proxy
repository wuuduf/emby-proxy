        for item in sites:
            for route in item.get('routes') or []:
                lines.append('%s %s → %s' % (item.get('domain') or item.get('id') or '-',route.get('path') or '/',route.get('upstream') or '-'))
        return '\n'.join(lines)
    return '未知命令。发送 /help 查看可用命令。'

def telegram_send(token, chat_id, text, authorize=None):
    # Telegram limits message text by UTF-16 code units, not Python code
    # points. Split hard as well as on line boundaries so one long path or
    # attacker-controlled label cannot make the notification fail.
    def units(value): return len(value.encode('utf-16-le')) // 2
    def chunks(value):
        current=[]; size=0
        for line in str(value).splitlines() or ['']:
            pieces=[]; piece=''; piece_size=0
            for char in line:
                char_units=2 if ord(char) > 0xffff else 1
                if piece and piece_size+char_units > TELEGRAM_MESSAGE_LIMIT:
                    if piece: pieces.append(piece)
                    piece=char; piece_size=char_units
                else:
                    piece += char; piece_size += char_units
            pieces.append(piece)
            for part in pieces:
                extra=units(part)+(1 if current else 0)
                if current and size+extra > TELEGRAM_MESSAGE_LIMIT:
                    yield '\n'.join(current); current=[]; size=0
                current.append(part); size += units(part)+(1 if len(current)>1 else 0)
        if current: yield '\n'.join(current)
    for chunk in chunks(text):
        # A long response may span several API calls.  Recheck authorization
        # immediately before every chunk so a revoked Chat ID or rotated Bot
        # Token cannot receive the remainder of a sensitive response.
        if authorize is not None and not authorize(token, str(chat_id)):
            return False
        telegram_api(token,'sendMessage',{'chat_id':chat_id,'text':chunk},timeout=15)
    return True

def telegram_alerts(path):
    with state_lock(path):
        state=json.loads(Path(path).read_text()); config=state.get('telegram') or {}
        if config.get('enabled') is not True: return []
        current={'active_node':state.get('active_node'),'active_nodes':list(state.get('active_nodes') or []),'selected_lines':{},'nodes':{}}
        for line,item in (state.get('line_states') or {}).items():
            if isinstance(item,dict): current['selected_lines'][line]=item.get('active_node')
        for node_id,node in (state.get('nodes') or {}).items():
            last_seen=int(node.get('last_seen') or 0)
            fresh=last_seen > 0 and now()-last_seen <= HEARTBEAT_TTL
            healthy=node.get('healthy') is True and fresh
            status=_fmt_node_state(node)
            if not fresh: status='心跳过期'
            current['nodes'][node_id]={'healthy':healthy,'status':status,
                                       'quota':bool(node.get('quota_bytes') and node.get('used_bytes',0)>=node.get('quota_bytes'))}
        previous=config.get('alert_state') if isinstance(config.get('alert_state'),dict) else {}
        if not previous:
            config['alert_state']=current; state['telegram']=config; atomic_write(path,state)
            return []
        alerts=[]
        if previous.get('active_node') != current['active_node'] and current['active_node']:
            alerts.append('DNS 当前节点已切换：%s → %s' % (previous.get('active_node') or '无',current['active_node']))
        if previous.get('active_nodes') != current['active_nodes'] and current['active_nodes']:
            alerts.append('DNS 权重池已更新：%s' % (', '.join(current['active_nodes']) or '无'))
        if previous.get('selected_lines') != current['selected_lines'] and current['selected_lines']:
            changes=[]
            for line,nid in sorted(current['selected_lines'].items()):
                if (previous.get('selected_lines') or {}).get(line) != nid: changes.append('%s=%s' % (line,nid or '无'))
            if changes: alerts.append('DNSPod 线路已切换：' + '，'.join(changes))
        for node_id,value in current['nodes'].items():
            old=(previous.get('nodes') or {}).get(node_id) or {}
            if old.get('healthy') is True and value['healthy'] is False: alerts.append('节点异常：%s（%s）' % (node_id,value['status']))
            elif old.get('healthy') is False and value['healthy'] is True: alerts.append('节点恢复：%s' % node_id)
            if old.get('quota') is False and value['quota'] is True: alerts.append('节点配额已用完：%s' % node_id)
        # Persist the alert state and outbox in the same lock transaction. A
        # disable/reconfigure racing this check cannot resurrect old state.
        try: alert_token=telegram_token(config)
        except RuntimeError: alert_token=''
        generation=telegram_alert_generation(config,alert_token)
        pending=config.get('pending_alerts') if isinstance(config.get('pending_alerts'),list) else []
        normalized=[]
        seen_ids=set()
        for index,item in enumerate(pending):
            row=telegram_normalize_alert(item,index,generation)
            if row is not None and row['id'] in seen_ids:
                row['id']=hashlib.sha256((row['message']+'|'+str(row['created_at'])+'|duplicate|'+str(index)).encode()).hexdigest()[:32]
            if row is not None and row['generation'] == generation and (not row['created_at'] or now()-row['created_at'] <= TELEGRAM_ALERT_MAX_AGE):
                normalized.append(row)
                seen_ids.add(row['id'])
        # Do not deduplicate by message text: the same node can fail, recover,
        # and fail again with an identical message. The state transition above
        # already prevents duplicates on unchanged heartbeats.
        for alert in alerts:
            normalized.append({'id':secrets.token_hex(16),'message':str(alert)[:12000],
                               'created_at':now(),'generation':generation,
                               'delivered_chat_ids':[]})
        config['pending_alerts']=normalized[-TELEGRAM_ALERT_MAX:]; config['alert_state']=current
        state['telegram']=config; atomic_write(path,state)
        return alerts

def telegram_deliver_alerts(path, token, allowed):
    """Send durable alerts with per-chat acknowledgements and safe merging."""
    with state_lock(path):
        state=json.loads(Path(path).read_text()); config=state.get('telegram') or {}
        if config.get('enabled') is not True: return
        try: current_token=telegram_token(config)
        except RuntimeError: return
        current_allowed={str(item) for item in config.get('chat_ids') or []}
        generation=telegram_alert_generation(config,current_token)
        pending=[]
        source=config.get('pending_alerts') if isinstance(config.get('pending_alerts'),list) else []
        seen_ids=set()
        for index,item in enumerate(source):
            row=telegram_normalize_alert(item,index,generation)
            if row is not None and row['id'] in seen_ids:
                row['id']=hashlib.sha256((row['message']+'|'+str(row['created_at'])+'|duplicate|'+str(index)).encode()).hexdigest()[:32]
            if row is not None and row['generation'] == generation:
                pending.append(row)
